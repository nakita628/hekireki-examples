# The Active Record check: every generated model is loaded against the real Active Record,
# on an empty SQLite database in memory.
source "https://rubygems.org"

gem "activerecord", "~> 8.1"
gem "sqlite3", "~> 2.9"
# json 3.0 made JSON.parse's options keyword-only; Active Support 8.1 still passes them
# positionally.
gem "json", "< 3"
# Generated ulid(), cuid(), cuid(2) and nanoid() attribute defaults call these.
gem "ulid", "~> 1.4"
gem "cuid", "~> 1.0"
gem "cuid2", "~> 1.0"
gem "nanoid", "~> 2.0"
