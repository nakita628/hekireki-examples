load("//checks:defs.bzl", "lang_checks")

# tsc --strict against the real drizzle-orm and kysely for the schema and the DB interface of
# every schema. The packages come from the lockfile through rules_js rather than from a toolchain
# on PATH, so this check also runs under `bazel test //...` on a machine with nothing but node.
#
# `manual` schemas are generator bugs, not a gap in this harness. hekireki-drizzle writes a
# cross-table foreign key as `foreignKey({ foreignColumns: [otherTable.column] })` inside the
# other table's extra-config callback. When those references form a cycle, tsc --strict reports
# TS7022/TS7024 (`implicitly has type 'any'`) and the `defineRelations` block that follows
# collapses into DrizzleTypeError. A self-reference is fine (it reads `table.column`). No open
# hekireki issue covers this cycle. langfuse also hits
# https://github.com/nakita628/hekireki/issues/129: an @@index/@@unique on an @ignore field is
# emitted as `table.deprecatedOwnerOrgId`, which was not generated (TS2339).
# `bazel test //checks/typescript:<schema>` still runs the failing check.
lang_checks(
    lang = "typescript",
    harness = [
        "tsconfig.json",
        "//checks:common.sh",
        "//:node_modules/@paralleldrive/cuid2",
        "//:node_modules/@types/node",
        "//:node_modules/cuid",
        "//:node_modules/drizzle-orm",
        "//:node_modules/kysely",
        "//:node_modules/typescript",
        "//:node_modules/uuid",
    ],
    manual = [
        "calcom",
        "documenso",
        "langfuse",
        "linkwarden",
        "papermark",
        "rallly",
        "triggerdev",
    ],
)
