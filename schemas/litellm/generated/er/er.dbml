Enum JobStatus {
  ACTIVE
  INACTIVE
}

Enum ScheduledJobRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

Enum AccountingDeliveryState {
  pending
  applied
  parked
}

Table LiteLLM_BudgetTable {
