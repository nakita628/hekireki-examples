Table Rule {
  id String [pk]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  name String [not null]
  enabled Boolean [default: true, not null]
  automate Boolean [default: true, not null]
  runOnThreads Boolean [default: false, not null]
  emailAccountId String [not null]
  organizationRuleId String
  organizationRuleMemberEnabled Boolean
  conditionalOperator LogicalOperator [default: 'AND', not null]
  instructions String
  groupId String [unique]
  from String
  to String
  subject String
  body String
  categoryFilterType CategoryFilterType
  systemType SystemType
  promptText String

  indexes {
    (id, emailAccountId) [unique]
    (name, emailAccountId) [unique]
    (emailAccountId, systemType) [unique]
    (emailAccountId, organizationRuleId) [unique]
  }
}

