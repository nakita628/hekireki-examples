  sourceKind String [not null]
  sourceId String [not null]
  sourceValue String
  role String [not null]
  grantKey String [unique, not null]
  createdAt DateTime [not null]
  updatedAt DateTime [not null]
}

Table scimGroup {
  id String [pk]
  connectionId String [not null]
  provisioningDomainId String [not null]
  revision Int [default: 0, not null]
  displayName String [not null]
  displayNameKey String [unique, not null]
  externalId String
  externalIdKey String [unique]
  orderKey String [unique, not null]
  createdAt DateTime [not null]
  updatedAt DateTime [not null]
}

Table scimGroupMember {
  id String [pk]
  connectionId String [not null]
  groupId String [not null]
  scimUserId String [not null]
  membershipKey String [unique, not null]
  createdAt DateTime [not null]
}

Table ScimIdentityLink {
  id String [pk]
  connectionId String [not null]
  externalId String [not null]
  userId String [not null]

  indexes {
    (connectionId, externalId) [unique]
  }
}

Table LoopsEmailSource {
  id String [pk]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  emailMessageId String [unique]
  loopId String
  loopName String
  campaignId String
  campaignName String
  sourceType String
  eventTime DateTime
}

