    (emailAccountId, clientMutationId) [unique]
  }
}

Table ScheduledEmail {
  id String [pk]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  emailAccountId String [not null]
  clientMutationId String [not null]
  payloadHash String [not null]
  payload Json [not null]
  threadId String
