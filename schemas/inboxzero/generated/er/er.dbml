  status ScheduledEmailStatus [default: 'PENDING', not null]
  processingStartedAt DateTime
  executionQueuedAt DateTime
  sentAt DateTime
  error String
  remindAt DateTime
  reminderStatus EmailReminderStatus [default: 'NONE', not null]
  reminderStartedAt DateTime
  heldForUndo Boolean [default: false, not null]
