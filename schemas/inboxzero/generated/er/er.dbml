Table Account {
  password String
  id String [pk]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  userId String [not null]
  provider String [not null]
  type String [default: 'oidc', not null]
  providerAccountId String [not null]
  refresh_token String
  refreshTokenExpiresAt DateTime
  access_token String
  expires_at DateTime [default: `now()`]
  disconnectedAt DateTime
  token_type String
  scope String
  id_token String
  session_state String

  indexes {
    (provider, providerAccountId) [unique]
  }
}

Table Session {
  id String [pk]
  sessionToken String [unique, not null]
  userId String [not null]
  expires DateTime [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  emailOtp Boolean [default: false, not null]
  emailOtpVersion Int [default: 0, not null]
  ipAddress String
  userAgent String
  activeOrganizationId String
}

Table User {
  id String [pk]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  name String
  email String [unique, not null]
  emailVerified Boolean [default: false]
  image String
  completedOnboardingAt DateTime
  signupIntent SignupIntent
  onboardingAnswers Json
  lastLogin DateTime
  utms Json
  errorMessages Json
  announcementDismissedAt DateTime
  dismissedHints String[] [not null]
  surveyFeatures String[] [not null]
  surveyRole String
  surveyGoal String
  surveyCompanySize Int
  surveySource String
  surveyImprovements String
  mcpServerEnabled Boolean [default: false, not null]
  mcpTokenVersion Int [default: 0, not null]
  emailOtpEnabled Boolean [default: false, not null]
  emailOtpVersion Int [default: 0, not null]
  aiProvider String
  aiModel String
  aiApiKey String
  decisionModelEnabled Boolean
  webhookSecret String
  referralCode String [unique]
  premiumId String
  premiumAdminId String
  scimAccessDisabled Boolean [default: false, not null]
}

Table EmailAccount {
  id String [pk]
  email String [unique, not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  name String
  image String
  sortOrder Int
  about String
  writingStyle String
  signature String
  sentSignatureScan Json
  sentSignatureScannedAt DateTime
  includeReferralSignature Boolean [default: false, not null]
  includeSentWithSignature Boolean [default: true, not null]
  sentMessageOpenTrackingEnabled Boolean [default: true, not null]
  watchEmailsExpirationDate DateTime
  watchEmailsSubscriptionId String
  watchEmailsSubscriptionHistory Json
  lastSyncedHistoryId String
  behaviorProfile Json
  personaAnalysis Json
  role String
  timezone String
  calendarBookingLink String
  draftDocsUrls String[] [not null]
  statsEmailFrequency Frequency [default: 'WEEKLY', not null]
  summaryEmailFrequency Frequency [default: 'WEEKLY', not null]
  lastSummaryEmailAt DateTime
  lastInboxHealthEmailAt DateTime
  coldEmailBlocker ColdEmailSetting
  coldEmailDigest Boolean [default: false, not null]
  coldEmailPrompt String
  rulesPrompt String
  autoCategorizeSenders Boolean [default: false, not null]
  multiRuleSelectionEnabled Boolean [default: false, not null]
  sensitiveDataPolicy String
  draftReplyConfidence DraftReplyConfidence [default: 'ALL_EMAILS', not null]
  draftCleanupDays Int [default: 14]
  allowHiddenAiDraftLinks Boolean [default: false, not null]
  rulesRevision Int [default: 0, not null]
  mailLayout MailLayout [default: 'LIST', not null]
  mailExpandedPreview Boolean [default: false, not null]
  includeInAllAccounts Boolean [default: true, not null]
  meetingBriefingsEnabled Boolean [default: false, not null]
  meetingBriefingsMinutesBefore Int [default: 240, not null]
  meetingBriefsSendEmail Boolean [default: true, not null]
  meetingRecorderEnabled Boolean [default: false, not null]
  meetingRecorderJoinRule MeetingJoinRule [default: 'ALL', not null]
  meetingRecorderRecapEmailEnabled Boolean [default: true, not null]
  meetingRecorderFollowUpDraftEnabled Boolean [default: true, not null]
  filingEnabled Boolean [default: false, not null]
  filingPrompt String
  filingConfirmationSendEmail Boolean [default: true, not null]
  followUpAwaitingReplyDays Float
  followUpNeedsReplyDays Float
  followUpAutoDraftEnabled Boolean [default: true, not null]
  digestSendEmail Boolean [default: true, not null]
  learnedWritingStyle String
  userId String [not null]
  accountId String [unique, not null]
}

Table MailSplit {
  id String [pk]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  name String [not null]
  order Int [not null]
  matchAll Boolean [default: true, not null, note: '''Whether every filter must match, or any one of them ("Show mail matching
all/any of these conditions"). A split with no filters is the plain inbox.''']
  emailAccountId String [not null]

  indexes {
    (emailAccountId, name) [unique]
  }
}

Table MailSplitFilter {
  id String [pk]
  kind MailSplitFilterKind [not null]
  value String
  order Int [not null]
  mailSplitId String [not null]

  indexes {
    (mailSplitId, order) [unique]
  }

  Note: '''One condition row in the split builder. A split may hold several of the same
kind (two senders, two labels), so kind is deliberately not unique per split.'''
}

Table Organization {
  id String [pk]
  name String [not null]
  slug String [unique, not null]
  logo String
  metadata Json
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table OrganizationRule {
  id String [pk]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  organizationId String [not null]
  enabled Boolean [default: true, not null]
  name String [not null]
  instructions String
  runOnThreads Boolean [default: false, not null]
  conditionalOperator LogicalOperator [default: 'AND', not null]
  from String
  to String
  subject String
  body String

  indexes {
    (organizationId, name) [unique]
  }
}

Table OrganizationRuleAction {
  id String [pk]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  organizationRuleId String [not null]
  type ActionType [not null]
  label String
  subject String
  content String
  to String
  cc String
  bcc String
  url String
  folderName String
  delayInMinutes Int
  staticAttachments Json
}

Table Member {
  id String [pk]
  organizationId String [not null]
  emailAccountId String [unique, not null]
  role String [default: 'member', not null]
  allowOrgAdminAnalytics Boolean [default: false, not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (organizationId, emailAccountId) [unique]
  }
}

Table Conversation {
  id String [pk]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  organizationId String [not null]
  publisherId String [not null]
  threadId String [not null]
  status ConversationStatus [default: 'ACTIVE', not null]
  revision Int [default: 0, not null]
  generation Int [default: 1, not null]

  indexes {
    (publisherId, threadId) [unique]
  }
}

Table ConversationParticipant {
  id String [pk]
  conversationId String [not null]
  memberId String [not null]
  generation Int [not null]
  active Boolean [default: true, not null]
  readRevision Int [default: 0, not null]
  muted Boolean [default: false, not null]
  createdAt DateTime [default: `now()`, not null]

  indexes {
    (conversationId, memberId, generation) [unique]
  }
}

Table ConversationComment {
  id String [pk]
  conversationId String [not null]
  authorMemberId String
  clientMutationId String [not null]
  body String [not null]
  revision Int [not null]
  deletedAt DateTime
  createdAt DateTime [default: `now()`, not null]

  indexes {
    (conversationId, revision) [unique]
    (conversationId, authorMemberId, clientMutationId) [unique]
  }
}

Table ConversationActivity {
  id String [pk]
  participantId String [not null]
  commentId String
  kind ConversationActivityKind [not null]
  revision Int [not null]
  createdAt DateTime [default: `now()`, not null]

  indexes {
    (participantId, kind, revision) [unique]
  }
}

Table invitation {
  id String [pk]
  organizationId String [not null]
  email String [not null]
  role String
  status String [not null]
  expiresAt DateTime [not null]
