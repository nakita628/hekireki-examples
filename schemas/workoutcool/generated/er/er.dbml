Ref program_weeks_programId_fk: program_weeks.programId > programs.id [delete: cascade]

Ref program_sessions_weekId_fk: program_sessions.weekId > program_weeks.id [delete: cascade]

Ref program_session_exercises_sessionId_fk: program_session_exercises.sessionId > program_sessions.id [delete: cascade]

Ref program_session_exercises_exerciseId_fk: program_session_exercises.exerciseId > exercises.id

Ref program_suggested_sets_programSessionExerciseId_fk: program_suggested_sets.programSessionExerciseId > program_session_exercises.id [delete: cascade]

Ref user_program_enrollments_userId_fk: user_program_enrollments.userId > user.id [delete: cascade]

Ref user_program_enrollments_programId_fk: user_program_enrollments.programId > programs.id

