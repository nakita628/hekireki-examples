Ref workout_sets_workoutSessionExerciseId_fk: workout_sets.workoutSessionExerciseId > workout_session_exercises.id [delete: cascade]

Ref plan_provider_mappings_planId_fk: plan_provider_mappings.planId > subscription_plans.id [delete: cascade]

Ref subscriptions_userId_fk: subscriptions.userId > user.id

Ref subscriptions_planId_fk: subscriptions.planId > subscription_plans.id

Ref licenses_userId_fk: licenses.userId > user.id

