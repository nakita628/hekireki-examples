Enum WorkoutSetType {
  TIME
  WEIGHT
  REPS
  BODYWEIGHT
  NA
}

Enum WorkoutSetUnit {
  kg
  lbs
}

Enum SubscriptionStatus {
  ACTIVE
  TRIAL
  CANCELLED
  EXPIRED
  PAUSED
}

Enum Platform {
  WEB
  IOS
  ANDROID
}

Enum PaymentProcessor {
  STRIPE
  PAYPAL
  LEMONSQUEEZY
  PADDLE
  APPLE_PAY
  GOOGLE_PAY
  REVENUECAT
  NONE
  OTHER
}

Enum ProgramLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

Enum ProgramVisibility {
  DRAFT
  PUBLISHED
  ARCHIVED
}

Table user {
  id String [pk]
  firstName String [default: '', not null]
  lastName String [default: '', not null]
  name String [not null]
  email String [unique, not null]
  emailVerified Boolean [not null]
  image String
  locale String [default: 'fr']
  createdAt DateTime [not null]
  updatedAt DateTime [not null]
  role UserRole [default: 'user']
  banned Boolean [default: false]
  banReason String
  banExpires DateTime
  isPremium Boolean [default: false]
  onboardingPreferences Json
}

Table user_favorite_exercises {
  id String [pk]
  userId String [not null]
  exerciseId String [not null]
  updatedAt DateTime [not null]

  indexes {
    (userId, exerciseId) [unique]
  }
}

Table session {
  id String [pk]
  expiresAt DateTime [not null]
  token String [unique, not null]
  createdAt DateTime [not null]
  updatedAt DateTime [not null]
  ipAddress String
  userAgent String
  userId String [not null]
  impersonatedBy String
}

Table account {
  id String [pk]
  accountId String [not null]
  providerId String [not null]
  userId String [not null]
  accessToken String
  refreshToken String
  idToken String
  accessTokenExpiresAt DateTime
  refreshTokenExpiresAt DateTime
  scope String
  password String
  createdAt DateTime [not null]
  updatedAt DateTime [not null]
}

Table verification {
  id String [pk]
  identifier String [not null]
  value String [not null]
  expiresAt DateTime [not null]
  createdAt DateTime
  updatedAt DateTime
}

Table feedbacks {
  id String [pk]
  review Int [not null]
  message String [not null]
  email String
  userId String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table exercises {
  id String [pk]
  name String [not null]
  nameEn String
  description String
  descriptionEn String
  fullVideoUrl String
  fullVideoImageUrl String
  introduction String
  introductionEn String
  slug String [unique]
  slugEn String [unique]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table exercise_attribute_names {
  id String [pk]
  name ExerciseAttributeNameEnum [unique, not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table exercise_attribute_values {
  id String [pk]
  attributeNameId String [not null]
  value ExerciseAttributeValueEnum [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (attributeNameId, value) [unique]
  }
}

Table exercise_attributes {
  id String [pk]
  exerciseId String [not null]
  attributeNameId String [not null]
  attributeValueId String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (exerciseId, attributeNameId, attributeValueId) [unique]
  }
}

Table workout_sessions {
  id String [pk]
  userId String [not null]
  startedAt DateTime [not null]
  endedAt DateTime
  duration Int
  muscles ExerciseAttributeValueEnum[] [not null]
  rating Int
  ratingComment String
}

Table workout_session_exercises {
  id String [pk]
  workoutSessionId String [not null]
  exerciseId String [not null]
  order Int [not null]
}

Table workout_sets {
  id String [pk]
  workoutSessionExerciseId String [not null]
  setIndex Int [not null]
  type WorkoutSetType [not null]
  types WorkoutSetType[] [not null]
  valuesInt Int[] [not null]
  valuesSec Int[] [not null]
  units WorkoutSetUnit[] [not null]
  completed Boolean [default: false, not null]
}

Table subscription_plans {
  id String [pk]
  priceMonthly Decimal
  priceYearly Decimal
  currency String [default: 'EUR', not null]
  interval String [default: 'month', not null]
  isActive Boolean [default: true, not null]
  availableRegions String[] [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table plan_provider_mappings {
  id String [pk]
  planId String [not null]
  provider PaymentProcessor [not null]
  externalId String [not null]
  region String
  metadata Json
  isActive Boolean [default: true, not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (planId, provider, region) [unique]
  }
}

Table subscriptions {
  id String [pk]
  userId String [not null]
  planId String [not null]
  revenueCatUserId String
  status SubscriptionStatus [not null]
  startedAt DateTime [not null]
  currentPeriodEnd DateTime
  cancelledAt DateTime
  platform Platform
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (userId, platform) [unique]
  }
}

Table licenses {
  id String [pk]
  key String [unique, not null]
  userId String
  validFrom DateTime [default: `now()`, not null]
  validUntil DateTime
  maxUsers Int [default: 1]
  features Json
  activatedAt DateTime
  lastCheckedAt DateTime
  createdAt DateTime [default: `now()`, not null]
}

Table revenuecat_webhook_events {
  id String [pk]
  eventType String [not null]
  eventTimestamp DateTime [not null]
  appUserId String [not null]
  environment String [not null]
  productId String
  transactionId String
  originalTransactionId String
  entitlementIds String
  processed Boolean [default: false, not null]
  processingError String
  retryCount Int [default: 0, not null]
  rawEventData Json [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table programs {
  id String [pk]
  slug String [unique, not null]
  slugEn String [unique, not null]
  slugEs String [unique, not null]
  slugPt String [unique, not null]
  slugRu String [unique, not null]
  slugZhCn String [unique, not null]
  title String [not null]
  titleEn String [not null]
  titleEs String [not null]
  titlePt String [not null]
  titleRu String [not null]
  titleZhCn String [not null]
  description String [not null]
  descriptionEn String [not null]
  descriptionEs String [not null]
  descriptionPt String [not null]
  descriptionRu String [not null]
  descriptionZhCn String [not null]
  category String [not null]
  image String [not null]
  level ProgramLevel [not null]
  type ExerciseAttributeValueEnum [not null]
  durationWeeks Int [default: 4, not null]
  sessionsPerWeek Int [default: 3, not null]
  sessionDurationMin Int [default: 30, not null]
  equipment ExerciseAttributeValueEnum[] [not null]
  isPremium Boolean [default: true, not null]
  isActive Boolean [default: true, not null]
  visibility ProgramVisibility [default: 'DRAFT', not null]
  participantCount Int [default: 0, not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table program_coaches {
  id String [pk]
  programId String [not null]
  name String [not null]
  image String [not null]
  order Int [default: 0, not null]
}

Table program_weeks {
  id String [pk]
  programId String [not null]
  weekNumber Int [not null]
  title String [not null]
  titleEn String [not null]
  titleEs String [not null]
  titlePt String [not null]
  titleRu String [not null]
  titleZhCn String [not null]
  description String [not null]
  descriptionEn String [not null]
  descriptionEs String [not null]
  descriptionPt String [not null]
  descriptionRu String [not null]
  descriptionZhCn String [not null]

  indexes {
    (programId, weekNumber) [unique]
  }
}

Table program_sessions {
  id String [pk]
  weekId String [not null]
  sessionNumber Int [not null]
  title String [not null]
  titleEn String [not null]
  titleEs String [not null]
  titlePt String [not null]
  titleRu String [not null]
  titleZhCn String [not null]
  slug String [not null]
  slugEn String [not null]
  slugEs String [not null]
  slugPt String [not null]
  slugRu String [not null]
  slugZhCn String [not null]
  description String [not null]
  descriptionEn String [not null]
  descriptionEs String [not null]
  descriptionPt String [not null]
  descriptionRu String [not null]
  descriptionZhCn String [not null]
  equipment ExerciseAttributeValueEnum[] [not null]
  estimatedMinutes Int [not null]
  isPremium Boolean [default: true, not null]

  indexes {
    (weekId, sessionNumber) [unique]
    (weekId, slug) [unique]
    (weekId, slugEn) [unique]
    (weekId, slugEs) [unique]
    (weekId, slugPt) [unique]
    (weekId, slugRu) [unique]
    (weekId, slugZhCn) [unique]
  }
}

Table program_session_exercises {
  id String [pk]
  sessionId String [not null]
  exerciseId String [not null]
  order Int [not null]
  instructions String [not null]
  instructionsEn String [not null]
  instructionsEs String [not null]
  instructionsPt String [not null]
  instructionsRu String [not null]
  instructionsZhCn String [not null]

  indexes {
    (sessionId, order) [unique]
  }
}

Table program_suggested_sets {
  id String [pk]
  programSessionExerciseId String [not null]
  setIndex Int [not null]
  types WorkoutSetType[] [not null]
  valuesInt Int[] [not null]
  valuesSec Int[] [not null]
  units WorkoutSetUnit[] [not null]

  indexes {
    (programSessionExerciseId, setIndex) [unique]
  }
}

Table user_program_enrollments {
  id String [pk]
  userId String [not null]
  programId String [not null]
  enrolledAt DateTime [default: `now()`, not null]
  currentWeek Int [default: 1, not null]
  currentSession Int [default: 1, not null]
  completedSessions Int [default: 0, not null]
  isActive Boolean [default: true, not null]
  completedAt DateTime

  indexes {
    (userId, programId) [unique]
  }
}

Table user_session_progress {
  id String [pk]
  enrollmentId String [not null]
  sessionId String [not null]
  startedAt DateTime [default: `now()`, not null]
  completedAt DateTime
  workoutSessionId String [unique]

  indexes {
    (enrollmentId, sessionId) [unique]
  }
}

