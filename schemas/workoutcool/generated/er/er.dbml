Enum UserRole {
  admin
  user
}

Enum ExercisePrivacy {
  PUBLIC
  PRIVATE
}

Enum ExerciseAttributeNameEnum {
  TYPE
  PRIMARY_MUSCLE
  SECONDARY_MUSCLE
  EQUIPMENT
  MECHANICS_TYPE
}

