// OpenSaas: Wasp Open SaaS starter: users, subscriptions, tasks, files, analytics and contact messages.
//
// Imported from https://github.com/wasp-lang/open-saas/blob/5f5dd77403b97952f6b3c3ff2131d1e9eea03f1f/template/app/schema.prisma
// (MIT license) by tools/import/import-schema.mjs, which dropped the original
// generator blocks and the datasource's connection URLs and added the hekireki generators below.
// The models, enums and `///` comments are the project's own, as they are at that commit.

datasource db {
  provider = "postgresql"
}

// hekireki: every ORM generator, and the ER diagram as Mermaid, DBML and SVG. Every output is
// under generated/, which the Bazel target //schemas/opensaas:generate writes and
// //schemas/opensaas:generate.test holds the committed copy to.

generator Hekireki-Drizzle {
  provider = "hekireki-drizzle"
  output   = "generated/drizzle/schema.ts"
}

generator Hekireki-Kysely {
  provider = "hekireki-kysely"
  output   = "generated/kysely/types.ts"
}

generator Hekireki-SQLAlchemy {
  provider = "hekireki-sqlalchemy"
  output   = "generated/sqlalchemy"
}

generator Hekireki-Django {
  provider = "hekireki-django"
  output   = "generated/django"
}

generator Hekireki-GORM {
  provider = "hekireki-gorm"
  output   = "generated/gorm"
  package  = "model"
}

generator Hekireki-SeaORM {
  provider = "hekireki-sea-orm"
  output   = "generated/sea-orm"
}

generator Hekireki-Ecto {
  provider = "hekireki-ecto"
  output   = "generated/ecto"
  app      = "OpenSaas"
}

generator Hekireki-ActiveRecord {
  provider = "hekireki-activerecord"
  output   = "generated/activerecord"
}

generator Hekireki-EFCore {
  provider  = "hekireki-efcore"
  output    = "generated/efcore"
  namespace = "OpenSaas.Models"
  context   = "OpenSaasContext"
}

generator Hekireki-Eloquent {
  provider  = "hekireki-eloquent"
  output    = "generated/eloquent"
  namespace = "App\\Models"
}

generator Hekireki-Exposed {
  provider = "hekireki-exposed"
  output   = "generated/exposed"
  package  = "opensaas.models"
}

generator Hekireki-ER {
  provider = "hekireki-er"
  outputs  = ["generated/er/er.md", "generated/er/er.dbml", "generated/er/er.svg"]
}

model User {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  email                     String?         @unique
  username                  String?         @unique
  isAdmin                   Boolean         @default(false)

  paymentProcessorUserId    String?         @unique
  subscriptionStatus        String?         // 'active', 'cancel_at_period_end', 'past_due', 'deleted'
  subscriptionPlan          String?         // 'hobby', 'pro'
  datePaid                  DateTime?
  credits                   Int             @default(3)

  gptResponses              GptResponse[]
  contactFormMessages       ContactFormMessage[]
  tasks                     Task[]
  files                     File[]
}

model ProcessedWebhookEvent {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  paymentProcessorEventId   String          @unique // The payment processor's event id, e.g. `evt_...` for Stripe.
  eventType                 String                  // The payment processor's event type, e.g. `invoice.paid`.
}

model GptResponse {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  content                   String
}

model Task {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  description               String
  time                      String          @default("1")
  isDone                    Boolean         @default(false)
}

model File {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  name                      String
  type                      String
  s3Key                     String
}

model DailyStats {
  id                               Int             @id @default(autoincrement())
  date                             DateTime        @default(now()) @unique

  totalViews                       Int             @default(0)
  prevDayViewsChangePercent        String          @default("0")
  userCount                        Int             @default(0)
  paidUserCount                    Int             @default(0)
  userDelta                        Int             @default(0)
  paidUserDelta                    Int             @default(0)
  totalRevenue                     Float           @default(0)
  totalProfit                      Float           @default(0)

  sources                          PageViewSource[]
}

model PageViewSource {
  @@id([date, name])
  name                     String
  date                     DateTime        @default(now())

  dailyStats               DailyStats?     @relation(fields: [dailyStatsId], references: [id])
  dailyStatsId             Int?

  visitors                 Int
}

model Logs {
  id                       Int             @id @default(autoincrement())
  createdAt                DateTime        @default(now())

  message                  String
  level                    String
}

model ContactFormMessage {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  content                   String
  isRead                    Boolean         @default(false)
  repliedAt                 DateTime?
}
