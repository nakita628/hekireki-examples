Table DiscoveredPerson {
  id String [pk]
  organizationId String [not null]
  provider String [not null, note: '"anthropic" | "openai" | "databricks" | ... - the provider that named them.']
  rawActorId String [not null, note: '''What the provider calls them, verbatim. The join key onto the money rows\'
RawActorId. Replaced by a deterministic pseudonym on erasure, which keeps
the row addressable for spend attribution without keeping the identifier.''']
  displayText String [not null, note: 'Name or email text as seen. Pseudonymized alongside rawActorId on erasure.']
  kind String [not null, note: '''person | service_account - determined deterministically per ADR-128 §10
(a bare UUID in Databricks `executed_by` is a service account, never an
agent), never guessed from the shape of a name.''']
  department String [note: '''The department the provider\'s directory filed this person under, verbatim.
An OBSERVATION, not the `Department` entity: it is free text a tenant owns
on their side, it exists for people who hold no LangWatch account, and
nothing rolls spend up by it. Spend attribution stays on `Department`, via
the membership the match engine proves (directoryDepartmentSync.service).
Null means no directory has named one - never "no department", because a
blank field in the tenant\'s directory and a person no directory lists are
the same null here.''']
  firstSeenAt DateTime [not null]
  lastSeenAt DateTime [not null]
  erasedAt DateTime [note: '''Set when this row\'s identity has been erased. The row survives so its
spend stays attributable to *someone*; the identifier does not.''']
  moneyRowsPendingAt DateTime [note: '''Set alongside `erasedAt` and cleared once the daily cost rows have been
removed and their rebuild requested. Non-null means the ClickHouse half
of the erasure did not finish — a crash between the delete and the
replay leaves days short by the erased amount, and without this marker a
re-run reads `erasedAt`, short-circuits, and reports a clean erasure that
did no work. The re-run resumes at that step instead.''']
  moneyRebuildSince String [note: '''The earliest day to rebuild from, recorded BEFORE the rows are deleted.
Once they are gone there is nothing left to ask which days they were on,
so a resume with no record of this could only replay everything or
nothing. Null means nothing was rebuildable — either no day carried the
identifier, or every one of them is older than the event log keeps.''']
  suspendedAt DateTime [note: '''ADR-128 §12 conflict rule: automatic linking has stopped for this
identity because evidence pointed at two candidates, or contradicted an
existing link. Stored HERE rather than on the suggestion rows, because a
halt on auto-linking that a recompute or a restart clears is not a halt.''']
  suspendedReason String [note: 'What tripped the suspension, for the human who reviews it.']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]

  indexes {
    (organizationId, provider, rawActorId) [unique]
  }

  Note: '''A name-text seen on a provider\'s cost or audit rows: "the provider told us
someone called m.silva exists". One row per provider-scoped identity.

This is the unit of GDPR erasure (ADR-128 §9), and deliberately so: most of
these people have no LangWatch login at all - contractors, seat holders who
never signed in, anyone whose email a provider put on a cost row - so there
is no platform user to key on and a user-deletion event can never fire for
them.'''
}

Table DiscoveredAgent {
  id String [pk]
  organizationId String [not null]
  provider String [not null]
  rawAgentId String [not null, note: 'Genie space / Copilot bot / OpenAI project id, verbatim.']
  displayText String [not null]
  metadata Json [not null, note: '''Workspace, plan, and kin - provider-native descriptive fields only. Never
credentials: this row is read by admin screens, not by any pull path.''']
  firstSeenAt DateTime [not null]
  lastSeenAt DateTime [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]

  indexes {
    (organizationId, provider, rawAgentId) [unique]
  }

  Note: '''The same shape as DiscoveredPerson for non-human actors - Genie spaces,
Copilot bots, OpenAI projects - plus whatever provider-native metadata the
source published. Discovering an agent grants it nothing either.'''
}

Table IdentityMatch {
  id String [pk]
  organizationId String [not null]
  discoveredPersonId String [not null, note: 'The provider-side identity this link is about.']
  userId String [note: '''The platform user. Nullable, and blanked by erasure (ADR-128 §9 step 2) -
the row and its dates remain, so the history of the link is not rewritten
by the erasure either.''']
  evidenceKind String [not null, note: '''directory_id | verified_email | human_confirmed. Exact verified-email
equality is the primary evidence; a directory id corroborates but never
stands alone (ADR-128 §12).''']
  validFrom DateTime [not null]
  validTo DateTime [note: 'Null means the link is open. Offboarding and corrections close it.']
  createdAt DateTime [default: `now()`, not null]

  Note: '''The dated match table: "`user_abc123` on Anthropic is platform user #42,
valid from March 3", closed when it stops being true.

Dating is what makes a re-issued email address survivable: the leaver\'s link
closes at offboarding, the new hire gets a new link, and January\'s spend
stays with January\'s person. A correction closes the old row and opens a new
one; nothing is ever silently rewritten.'''
}

Table GovernanceTenantHistory {
  id String [pk]
  organizationId String [not null]
  tenantId String [not null, note: 'A hidden governance project id this organization has written rows under.']
  firstUsedAt DateTime [not null]
  lastUsedAt DateTime [not null]

  indexes {
    (organizationId, tenantId) [unique]
  }

  Note: '''Every ClickHouse `TenantId` this organization has ever written governance
rows under, appended on first use and never pruned.

The live `resolveGovProjectId` lookup cannot be this translation: it filters
`archivedAt: null` and so returns null forever once someone archives the
governance project, while the write path re-reads the same project by slug
with no such filter and keeps landing rows under the old tenant. The
organization would map to zero tenants on read and one on write - a
permanent split-brain in which the cost screen reports "no governance data"
and an erasure job erases nothing and reports success.

Reads resolve against the whole history; erasure walks all of it, because
personal data does not stop existing in a tenant that stopped being current.'''
}

Table ErasedIdentifierSuppression {
  id String [pk]
  organizationId String [not null]
  provider String [not null]
  identifierHash String [not null]
  erasedAt DateTime [not null]

  indexes {
    (organizationId, provider, identifierHash) [unique]
  }

  Note: '''Hashes of erased identifiers - the do-not-reimport list.

Without it the erasure is undone by the pipeline that produced it: the
pullers look 30 days back, so the next day\'s pull re-ingests the same email
and re-writes what we erased. Every write path carrying an identifier
consults this list and drops a suppressed one (ADR-128 §9 step 1).

It stores hashes and never identifiers, so it is not itself a copy of the
data it exists to keep out. The stored `identifierHash` and the pseudonym
written in place of the erased value are the same function of the same
input - HMAC-SHA256(secret, identifier) - so a write path computes that digest
once and uses it twice: as the membership test, and, on a hit, as the
replacement value. That is why no original-to-pseudonym mapping table
exists; one would hold the erased identifier in plaintext forever.

Scoped to the provider as well as the organization: the same string can be a
different person under a different provider.'''
}

Table IdentityMatchSuggestion {
  id String [pk]
  organizationId String [not null]
  discoveredPersonId String [not null]
  userId String [not null, note: '''The platform user this might be. Not nullable: a suggestion with no
candidate is not a suggestion.''']
  score Float [not null, note: '''Similarity of the two name texts, after the prefilter, in [0, 1]. A
display hint and an ordering key - never a threshold anything auto-links
on, which is the whole distinction this table exists to hold.''']
  computedAt DateTime [not null]

  indexes {
    (organizationId, discoveredPersonId, userId) [unique]
  }

  Note: '''Match candidates a background job computed and a human has yet to confirm
(ADR-128 §12).

Stored rather than computed when the review screen asks, and the reason is
measured rather than stylistic: fuzzy matching is quadratic, there is no
database route to it here, and at this document\'s own example size - 2,000
discovered people against 500 accounts - plain edit distance over the
1,000,000 pairs blocked the event loop for 2.9 seconds. Per page load,
uncached, stalling every other request on the instance. A stored row also
makes a pending count answerable without paying for the whole sweep.

Rows are written only by the job, which prefilters before it scores and
recomputes when its inputs change. Confirming one opens an `IdentityMatch`
and deletes the suggestion.

Suspension deliberately does NOT live here - it is on `DiscoveredPerson`,
because a halt on automatic linking that the next recompute clears is not a
halt.'''
}

Table ConnectedSeatChange {
  id String [pk]
  licenseId String [unique, not null, note: '''The reissued `IssuedLicense` row that carries the new seat count. A
plain column ref, like `replacesId`: relationMode="prisma" carries no
foreign keys.''']
  accountId String [note: '''The `ConnectedBillingAccount` row the invoice is raised against. Null
when the customer had no billing account (`not_onboarded`).''']
  organizationId String [note: 'The customer organization the license belongs to.']
  changedAt DateTime [not null, note: 'When the seats changed, which is the day the proration counts from.']
  addedSeats Int [not null, note: 'Seats on the new license above the seats on the one it replaced.']
  unitAmountCents Int [not null, note: 'What one added seat costs for the rest of the term, in cents of `currency`.']
  amountCents Int [not null, note: '`unitAmountCents` times `addedSeats`. Zero when nothing is owed.']
  currency Currency [note: 'Null when no billing account named one (`not_onboarded`).']
  stripeInvoiceId String [note: 'The one-off invoice the added seats were billed on.']
  state ConnectedSeatChangeState [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  Note: '''What a mid-term seat change of one connected license owes (ADR-141,
section 7): the seats added on the reissued license, invoiced prorated to
the end of the term.

The row is written before the payment provider is called and completed
after it, so a call that failed halfway is retried by the next seat
invoicing pass without inventing a second invoice. One row per reissued license.'''
}

Table ConnectedStatement {
  id String [pk]
  accountId String [not null, note: 'The `ConnectedBillingAccount` row. A plain column ref.']
  month DateTime [not null, note: 'First day of the month the statement covers, in UTC.']
  sentAt DateTime [not null]

  indexes {
    (accountId, month) [unique]
  }

  Note: '''The monthly usage statement one connected customer was sent (ADR-139,
section 7). One row per account per month keeps the statement to one send,
whatever runs the tick.'''
}

Table LicenseRenewalClaim {
  stripeInvoiceId String [pk]
  stripeSubscriptionId String [not null]
  claimToken String [not null, note: 'Fences completion and release to the delivery that holds the claim.']
  claimedAt DateTime [not null]
  issuedLicense Json [note: 'The signed licence between minting and mailing, so a retry mails it again instead of minting another; cleared once delivered.']
  deliveredAt DateTime
  licenseId String [note: 'The `licenseId` inside the delivered licence.']

  Note: '''One renewed licence per paid Stripe invoice of a self-serve licence
subscription (specs/licensing/self-serving-license-purchase.feature). A
redelivered invoice event finds the row and mints nothing. A claim never
delivered is taken over once `claimedAt` is older than the claim lease.'''
}

Table InstanceIdentity {
  id String [pk, default: 'self', note: '''Fixed, so this table holds one row. A second insert loses the race on the
primary key and re-reads the winner\'s id.''']
  instanceId String [unique, not null, note: 'A random UUID. Carries nothing about the customer.']
  createdAt DateTime [default: `now()`, not null]
  lastReportAt DateTime [note: '''When the usage report last reached LangWatch, and why the last attempt
did not. Both are what the checkup page reads to say whether reporting
works, which nothing recorded before: the sender logged success as soon
as `fetch` resolved and never looked at the response.''']
  lastReportError String
  optionalMetricsOptOut Boolean [default: false, not null, note: '''The optional category of the usage report, switched off from the checkup
page. With it off the report still says which release runs and how many
projects the install carries, and says nothing about what anyone does
with it (ADR-139, section 10).''']
  hostnameOptOut Boolean [default: false, not null, note: '''Hostname, which names the customer\'s own network and so has a switch of
its own rather than travelling with its category.''']
  upgradeDiagnosticsOptOut Boolean [default: false, not null, note: '''Sending a failed upgrade step\'s diagnostics to LangWatch on its own,
switched off by the operator (upgrade-diagnostics-via-connect, decision 4).''']

  Note: '''The identity this install presents to LangWatch (ADR-139, section 2).

Exactly one row, minted on first use and never rewritten. It survives
restarts, backups and hostname changes, and an install restored into
another database mints another one, which is what the registry refuses as
the wrong instance.

It replaced an identity built from the organization name and id, which
leaked the customer\'s name in cleartext, named one organization rather than
one install, and could not be joined to a license row without splitting a
string.'''
}

Table SelfHostedInstance {
  id String [pk]
  instanceId String [unique, not null, note: 'The UUID the install minted for itself. The join key for everything else.']
  firstSeenAt DateTime [default: `now()`, not null]
  lastSeenAt DateTime [not null]
  version String [note: 'What the install says about itself.']
  installMethod String
  chartVersion String
  hostname String [note: 'The host it answers on, when the operator left hostname reporting on.']
  environment String
  installedAt DateTime [note: '''The day the install itself says it first came up, which predates the
first report on an install that switched reporting on later.''']
  reportSchemaVersion Int
  organizationId String [note: '''The customer, and the license that named them. Plain column refs rather
than relations, like `IssuedLicense.replacesId`: relationMode="prisma"
carries no foreign keys, and the receiver resolves both from the license
registry rather than from the report.''']
  issuedLicenseId String
  userEmailDomains Json [note: '''Domains with counts, as `{"acme.test": 14}`. Never an address. Null on an
install that switched the optional category off.''']
  userDomains String[] [not null, note: '''The same domains as the keys of `userEmailDomains`, flattened so an
operator can search for one. A JSON object\'s keys are the domains
themselves, and no query language addresses a key it does not already
know the name of.''']
  latestReport Json [note: '''What the last report carried, so the list and the drawer read one row:
the onboarding ladder, the usage counts and the operational block, under
the same keys the dictionary declares.''']
  optionalMetricsReported Boolean [default: true, not null, note: '''What the last report said the operator had switched off, read from which
categories arrived rather than from a field the install could assert.''']
  hostnameReported Boolean [default: true, not null]
  reportCount Int [default: 0, not null, note: '''How many reports have landed, and how many fields the last one carried
that this release has no name for. A count above zero says the senders
are ahead of the receiver.''']
  lastUnknownFields Int [default: 0, not null]
  raisedSignals String[] [not null, note: '''The lead signals already raised for this install. A signal on this list
is never raised again, which is what keeps a large install from
reporting that it is large every morning.''']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  Note: '''One self-hosted install, as its daily usage report describes it (ADR-139,
section 10). The row is created by the first report that names an instance
id and is updated by every report after that, so the backoffice reads one
row per install rather than folding a history on every page load.

The report carries no credential, so it identifies an install and never a
customer. `organizationId` and `issuedLicenseId` are resolved from the
license bound to this instance, which the install proved by presenting its
token to license sync. A field in the posted body never reaches them.'''
}

Table SelfHostedInstanceDiagnostic {
  id String [pk]
  instanceId String [not null, note: 'The `SelfHostedInstance.instanceId` the licence caller presented.']
  stepId String [not null]
  stepDescription String
  release String
  attempt Int [not null]
  trigger String [not null, note: '`operator` or `automatic`.']
  byteLength Int [not null]
  objectKey String [not null]
  receivedAt DateTime [default: `now()`, not null]
  expiresAt DateTime [not null, note: 'When the lifecycle rule removes the bundle; the row is listed until then.']
  slackAnnouncedAt DateTime [note: 'Set on the report that posted this step and release\'s one Slack message.']

  Note: '''One upgrade diagnostics bundle a self-hosted install sent over Connect, on
LangWatch Cloud. The bytes live in object storage under
`upgrade-diagnostics/` and expire at 30 days by a lifecycle rule; this row
points at them and feeds Cloud admin and the Slack signal. Plain column
refs, no relation, as the usage report rows.'''
}

Table SelfHostedNotice {
  id String [pk]
  severity String [not null, note: '`info`, `warning` or `security`.']
  title String [not null]
  body String [not null]
  url String [note: 'An https link to read more; null where the notice names none.']
  fixedIn String [note: 'The release that fixes what the notice is about; an install on it or newer hides it.']
  status String [not null, note: '`draft`, `published` or `withdrawn`. Only a published notice that has not expired is sent.']
  expiresAt DateTime
  publishedAt DateTime
  publishedBy String [note: 'The staff member who published it, by user id.']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  Note: '''A notice LangWatch staff send every self-hosted install in Cloud\'s reply to its daily usage
report (enterprise/modules/licensing/specs/self-hosted-notices.feature). Cloud only, and no
tenant: every install receives every published notice that has not expired.'''
}

Table SelfHostedInstanceReport {
  id String [pk]
  instanceId String [not null, note: '''The `SelfHostedInstance.instanceId` this report came from. A plain column
ref for the same reason the instance row\'s refs are.''']
  receivedAt DateTime [default: `now()`, not null]
  version String
  reportSchemaVersion Int
  unknownFields Int [default: 0, not null, note: 'Fields this release had no name for. Counted, never stored by name.']
  payload Json [not null, note: 'The validated report, with every unknown field already dropped.']

  Note: '''One usage report, exactly as it arrived. Kept so a number on an install\'s
row can be traced back to the report that set it, and so a question asked
later can be answered over the history rather than over the latest snapshot.'''
}

Table WebPushSubscription {
  id String [pk]
  userId String [not null, note: '''The person the pushes are for. A plain column: the row leaves with the
person through notification\'s own subscriber on the user lifecycle.''']
  endpoint String [unique, not null, note: 'The push service URL the browser handed out. Unique per browser.']
  p256dh String [not null, note: '''The browser\'s P-256 public key and auth secret, base64url, as the
browser reports them. Payloads are encrypted to these.''']
  auth String [not null]
  userAgent String
  createdAt DateTime [default: `now()`, not null]
  lastSuccessAt DateTime [note: 'When the push service last accepted a push for this browser.']

  Note: '''One browser a person subscribed to Web Push, owned by notification. A
person holds one row per device; the endpoint names the browser, so a
browser that subscribes again replaces its own row.'''
}

Table WebPushVapidKey {
  id String [pk, default: 'self']
  publicKey String [not null, note: 'The uncompressed P-256 public key, base64url. The browser subscribes with it.']
  privateKeyEncrypted String [not null, note: 'The private key, base64url, encrypted with the process encryption key.']
  createdAt DateTime [default: `now()`, not null]

  Note: '''This installation\'s VAPID key pair, generated on first use so Web Push works
without configuration. Fixed id, so the table holds one row: a second
insert loses the race on the primary key and reads the winner\'s pair.'''
}

Table SignInProviderMount {
  id String [pk, default: 'self', note: '''Fixed, so this table holds one row: licensing\'s copy of sso\'s sign-in
provider fact (ADR-179).''']
  provider String [note: 'The configured provider\'s name; null when the deployment signs in by email.']
  mounted Boolean [not null]
  lastAppliedEventId String [not null, note: 'The last sso event applied: the row\'s idempotency guard and its version.']
  updatedAt DateTime [default: `now()`, not null]
}

