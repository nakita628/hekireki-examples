Table Account {
  id String [pk]
  userId String [not null]
  type String [default: 'oauth', not null]
  provider String [not null]
  issuer String [note: '''WHO asserted `providerAccountId`. Better Auth keys accounts by
`(provider, providerAccountId)`; auth\'s account create hook writes this
(modules/auth/specs/account-issuer.feature). Nullable only so the column
could be added to a populated table; the migration backfilled every row.''']
  providerAccountId String [not null]
  refresh_token String
  access_token String
  expires_at DateTime
  ext_expires_in Int
  token_type String
  scope String
  id_token String
  session_state String
  password String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]

  indexes {
    (provider, providerAccountId) [unique]
  }
}

Table AccountCredential {
  id String [pk]
  userId String [not null]
  provider String [not null]
  password String
  accessToken String
  refreshToken String
  idToken String
  accessTokenExpiresAt DateTime
  refreshTokenExpiresAt DateTime
  scope String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]
}

Table Session {
  id String [pk]
  sessionToken String [unique, not null]
  userId String [not null]
  expires DateTime [not null]
  ipAddress String
  userAgent String
  identifierId String [note: '''Which of the user\'s sign-in methods minted this session (D06). NULL on
every session that predates the column and on any mint we could not
attribute - an ordinary value, not an error. Nothing reads it to decide
whether the session is valid, so no session was ended to add it.''']
  amr String[] [not null, note: '''What the sign-in that minted this session PROVED, as RFC 8176 method
references (D06). Empty on every session minted before the column, and
on any ordinary password sign-in. An organization that requires a second
factor reads this when a member reaches its data; it is never read at
mint and never ends a session.''']
  startedBySignUp Boolean [default: false, not null, note: '''Minted while the account had never signed in: the session its sign-up
started, which skips the secure-account offer. False on every later one
and on every session that predates the column (specs/identity/passkeys.feature).''']
  impersonating Json [note: '''The legacy impersonation payload. NOTHING READS OR WRITES IT any more -
the {actor, subject} columns below replaced it, and the migration beside
them ended every session that still carried a value.

It stays for ONE release, and that is the whole reason it is still here.
`prisma migrate deploy` runs at container start, so the first pod of a
new release drops a column while the previous release\'s pods are still
serving - and those pods select this column on EVERY authenticated
request and fail closed when the row does not come back. Dropping it in
the same release that stops reading it signs everybody out for the length
of the rollout. Expand now, contract next release.''']
  actorUserId String [note: '''The impersonation claims (D06), aligned with the authz Principal
{actor, subject}. The actor is the operator who really made the request
and the subject is the person whose access they are borrowing; both are
recorded on every authorization decision, so the audit trail can answer
who really did it. These replace the legacy `impersonating` JSON blob,
which is dropped in the release AFTER this one.

NULL on every ordinary session, which is all of them: an impersonation
is a handful of rows at a time and nothing else reads these columns.''']
  subjectUserId String
  impersonationReason String [note: '''Why the operator started it. Required to start one
(specs/features/backoffice-user-impersonation-reason.feature) and kept
beside both people rather than only in the audit log, so a request under
impersonation carries its own justification.''']
  impersonationExpiresAt DateTime [note: '''When the borrowed access lapses. A session outlives its impersonation
window: past this the claims are ignored and the operator is themselves
again, with nothing ended.''']
  lastSeenAt DateTime [note: '''When this session was last used, for the idle timeout an organization
may set (GAC-10, specs/identity/org-session-lifetime.feature).

A COLUMN OF OUR OWN rather than `updatedAt`, because better-auth rolls a
live session\'s expiry once per `updateAge` - a day - so `updatedAt` is
activity to the nearest day and cannot tell an idle hour from an idle
minute. Written only for sessions whose owner belongs to an organization
that has set a window, and then at most once per quarter-window, so a
deployment where nobody has turned this on writes it never.

NULL on every session minted before the column and on every session
under no window at all. A null READS AS `updatedAt`, which better-auth
keeps rolled to within a day of the last use. That fallback is
conservative in the direction that matters - `updatedAt` is never
earlier than the real last use, so it can only ever judge a session MORE
active than it was, never less - and it is what lets a window turned on
today end the sessions that have been idle since February instead of
waiting a day for a stamp they have never had.''']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]
}

Table UserErasure {
  id String [pk]
  accountCreatedAt DateTime [not null]
  erasedAt DateTime [default: `now()`, not null]

  Note: '''One row per erased account, holding only its creation time: no id, name or address. It keeps
the install\'s first-created account knowable after an erasure deletes that row.
Spec: modules/user/specs/user.feature'''
}

Table User {
  id String [pk]
  name String
  email String [unique]
  emailVerified Boolean [default: false, not null]
  signupConfirmationPending Boolean [default: false, not null]
  passkeySignupClaimHash String
  image String
  pendingSsoSetup Boolean [default: false, not null]
  userHashKey String
  twoFactorEnabled Boolean [default: false, not null, note: '''Owned by the two-factor plugin (D06), which is why it is a plain
boolean rather than a state: the plugin flips it when a setup is
confirmed and when it is turned off, and challenges every sign-in while
it is true. The lifecycle - and the history - lives on MfaEnrollment.''']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]
  lastLoginAt DateTime
  deactivatedAt DateTime
  lastHomePath String
  tracesExplorerTourDismissedAt DateTime
  langyCodeAccessPreference String [note: '''How Langy should reach this person\'s code when a task needs a change
(ADR-129). "github" means they chose the pull request path and asked to
be remembered; NULL means ask. A shared local folder is never stored
here, because a folder has to be shared again each time.
Spec: specs/langy/langy-code-access.feature''']
  passkeyNudgeDismissedAt DateTime [note: '''When this person last said "not now" to being offered a passkey
(ADR-120). On the account rather than in browser storage for two
reasons: a per-browser record forgets on a new device, which is exactly
where the offer should be MORE eager, and an interval nobody can enforce
is not an interval. NULL means never asked.''']
  joinOfferDismissedDomains String[] [not null, note: '''The domains this person has said "no thanks" to being offered their
colleagues on (D12). Per domain rather than one flag: somebody who
changes jobs and verifies a second address should be offered their new
employer\'s organization, not silenced forever by a decision they made
about the old one. Empty means never dismissed anything.''']
  notificationPreferences Json [default: '{}', not null, note: '''This person\'s answer about browser notifications, one entry per topic:
{ "langy": "enabled" | "declined" }. A topic that is absent was never
answered. The browser\'s own permission is not stored here.
Spec: specs/langy/langy-notifications.feature''']
  passwordResetRequiredAt DateTime [note: '''When an operator marked this person\'s password as no longer trusted. A
password sign-in opens no session while it is set; any write of a new
password hash clears it. Spec: modules/auth/specs/forced-password-reset.feature''']
}

Table VerificationToken {
  id String [pk]
  identifier String [not null]
  token String [not null, note: 'Not unique alone: better-auth stores plain values here (a user id, a counter). See WEB-19201.']
  expires DateTime [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]

  indexes {
    (identifier, token) [unique]
  }
}

Table Identifier {
  id String [pk]
  userId String [not null]
  provider String [not null]
  value String
  domain String
  identifierHash String
  accountId String
  providerId String
  issuer String
  providerAccountId String
  state String [not null]
  connectionId String
  verifiedAt DateTime
  attachedAt DateTime [not null]
  detachedAt DateTime
  lastUsedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]
}

Table IdentitySignInSwitch {
  userId String [pk]
  onIdentifiers Boolean [not null]
  pinned Boolean [default: false, not null]
  switchedAt DateTime [not null]
  lastAppliedEventId String
  updatedAt DateTime [default: `now()`, not null]

  Note: '''Whether a user signs in on the identifier path: identity\'s own switch, set when the
identifier backfill proves the user and pinned off by an operator\'s rollback. No row is the
legacy path. Spec: modules/identity/specs/sign-in-switch.feature. Column refs only, no FK.'''
}

Table IdentifierReservation {
  normalizedValue String [pk]
  userId String [not null]
  identifierId String [not null]
  commandId String [not null]
  createdAt DateTime [default: `now()`, not null]
}

Table IdentityProjectionCursor {
  userId String [pk]
  lastEventId String [not null]
  acceptedAt DateTime [not null]
  occurredAt DateTime [not null]
  projectionVersion String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]
}

Table TwoFactor {
  id String [pk]
  userId String [not null]
  secret String [not null]
  backupCodes String [not null]
  verified Boolean [default: true, not null]
  failedVerificationCount Int [default: 0, not null]
  lockedUntil DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]

  Note: '''The two-factor plugin\'s own table (D06). Protocol state, and row-truth for
good (ADR-101 R12): the shared secret and the backup codes live here and
in no event, ever. Nothing in this repo reads or writes these columns -
the plugin owns them end to end, including the lockout counters, which is
why `failedVerificationCount` and `lockedUntil` are here rather than
rebuilt on the projection.

`backupCodes` holds an ENCRYPTED blob, not hashes. A backup code has to be
compared against what somebody types, and the plugin decrypts and compares;
hashing them would leave it unable to verify its own codes.'''
}

Table SignInAttemptLock {
  id String [pk]
  identifierHash String [unique, not null, note: 'Keyed hash of the normalised address. Never the address itself.']
  failedCount Int [default: 0, not null, note: '''Consecutive failures since the last success. Reset by a success, not by
time - "five consecutive", not five ever.''']
  lockedUntil DateTime [note: 'When the current lock lifts. Null when not locked.']
  consecutiveLockouts Int [default: 0, not null, note: '''Locks taken since the last success. At five this stops lifting by
itself and becomes an incident - see `heldForReview`.''']
  heldForReview Boolean [default: false, not null, note: '''Held past its lock because the count of locks reached the ceiling the
control names. Cleared by an administrator, or by the owner proving
mailbox control through a password reset - the second is what keeps a
held account from being a denial of service anyone can inflict by
typing a colleague\'s address wrong often enough.''']
  userId String [note: '''Whose account this resolved to at the time, when it resolved to one.
Null for an address with no account - those rows are the reason this is
nullable, and the reason this table is not hung off User.''']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]

  Note: '''Consecutive failed sign-ins, and the lock they earn (GAC-09).
Spec: specs/identity/org-account-lockout.feature.

KEYED ON THE ADDRESS THAT WAS TYPED, NOT ON A USER, and that is the whole
design. We already answer "no such account" and "wrong password" with one
refusal so that sign-in cannot be used to discover who has an account. A
lock that existed only for real accounts would put that back: five wrong
guesses saying "locked" for one address and "incorrect" for another tells
an attacker which addresses are worth attacking. So an address with
nothing behind it gets a row, a count and a lock exactly like one that
resolves, and both answer identically.

`identifierHash` is a KEYED hash of the normalised address, never the
address. The key is the deployment\'s own secret, so this table cannot be
lifted and reversed into the list of every address anybody has ever tried
to sign in as - which is what it would otherwise become, including every
typo and every address that has no account here at all.

Row-truth, deliberately (ADR-101 R12): this is protocol state read and
written on the sign-in path, like TwoFactor\'s own counters next door. The
EVIDENCE an auditor reads is the identity event emitted when a lock is
taken, which is durable; these rows are reaped once they stop meaning
anything.'''
}

Table Passkey {
  id String [pk]
  name String
  publicKey String [not null]
  userId String [not null]
  credentialID String [not null]
  counter Int [default: 0, not null]
  deviceType String [not null]
  backedUp Boolean [default: false, not null]
  transports String
  aaguid String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]

  Note: '''The passkey plugin\'s own table (D07). Protocol state, like TwoFactor: the
public key and the signature counter are the plugin\'s to read and write.
A passkey also becomes an `Identifier` row with provider `passkey`, which
is what makes it a sign-in method like any other - this table is the
credential, that one is the identity.

`aaguid` names the authenticator MODEL, never a device or a person, and is
only present at registration. Privacy-preserving platforms report all
zeroes, so a label derived from it is best-effort by construction.'''
}

Table MfaEnrollment {
  userId String [pk, note: '''The user. Also the aggregate id and the tenant - one identity history
per person (ADR-029 §4).''']
  enrollmentId String [note: 'The current enrollment, or NULL for somebody who never started one.']
  method String [note: 'totp. Never sms.']
  state String [not null, note: 'NONE | PENDING | ENABLED | EXPIRED | DISABLED']
  enrolledAt DateTime
  confirmedAt DateTime
  expiredAt DateTime
  disabledAt DateTime
  disabledVia String [note: 'password+totp | org-admin - who ended it, and on whose authority.']
  backupCodeCount Int [default: 0, not null]
  consumedBackupCodeIndexes Int[] [not null, note: 'Positions already spent, ascending. Never codes.']
  failedCount Int [default: 0, not null]
  occurredAt DateTime [not null]
  lastEventId String [not null]
  acceptedAt DateTime [not null]
  projectionVersion String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]

  Note: '''The two-step verification pipeline\'s projection (D06 - see
specs/identity/mfa-and-session-shape.feature). One row per PERSON, because
one person has one setup however many organizations they belong to.

A pure event-truth head like `SsoConnection`: every column is fold-written,
rows are never deleted (DISABLED is a tombstone, so history survives being
turned off), and a replay rebuilds it whole-row from the event log. The
cursor columns are inline because the fold produces exactly one row per
aggregate - the `Identifier` fan-out needed its own cursor table, this
does not.

Every column here is a lifecycle fact. There is deliberately nowhere in
this model a secret or a backup code could be put: `consumedBackupCodeIndexes`
holds POSITIONS, which is what lets "how many are left" be answered
without the projection ever knowing a code.'''
}

Table SsoConnection {
  id String [pk]
  organizationId String [not null]
  type String [not null, note: 'oidc | saml']
  state String [not null, note: '''DRAFT | CLAIMED | APPROVED | REJECTED | DISCARDED |
VERIFICATION_PENDING | VERIFIED | ACTIVE | SUSPENDED |
TEARDOWN_PENDING | TORN_DOWN''']
  claimedDomains String[] [not null]
  domainClaims Json [default: '[]', not null, note: '''[{ domain, state, claimedAtMs, claimedByActorId, decidedAtMs,
decidedByActorId, authority, waitedMs, note }] - every claim this
connection has made and how long each waited to be decided. The tier-3
approval queue is a read of this column, and the epic\'s Open Q2 wants
that latency measured from the day the queue exists.''']
  approvedDomains String[] [not null]
  verifiedDomains String[] [not null, note: 'The only domains that ever route, and only while state is ACTIVE.']
  lapsedDomains String[] [not null, note: '''The subset of `verifiedDomains` whose published record stayed missing
through its grace window (ADR-123). They still ROUTE - everyone already
here signs in unchanged - and they stop vouching for anybody NEW: no
provisioning on first sign-in, no walking in by domain. A column rather
than a read of the JSON below, because both questions are asked on a
sign-in path and have to be one indexed predicate.''']
  domainVerifications Json [default: '[]', not null, note: '''[{ domain, method, actorId, verifiedAtMs, proofState, firstAbsentAtMs,
graceEndsAtMs }] - what proved each verified domain, who, and whether
that evidence is still there. Kept on the row rather than only in the
log so that an operator-attested domain can never be read as one the
customer proved, and a wavering one never as one nothing is doubting.''']
  pendingVerification Json [note: '{ domain, method, tokenHash } while a ceremony is in flight.']
  idpMetadata Json [not null]
  arrivalPolicy String [default: 'refuse', not null, note: '''admit | request | refuse - what this connection does with somebody who
signs in through it and is not a member yet (ADR-117 3). Stated at
registration and changed by the setup journey, so it is never absent
and no reader has to decide what absence means. This was two fields
for a while - a boolean `allowsJit` beside it, kept in step by the
fold - and they disagreed about the middle answer.''']
  allowsJit Boolean [default: false, not null, note: '''DEAD, AND STAYING FOR ONE RELEASE. Nothing reads or writes this; the
routing repository derives the same answer from `arrivalPolicy`. It is
declared so the schema still describes the table, and left in place so
the PREVIOUS release\'s pods — which select it by name on every
connection read — keep working through the rollout. Dropping it in the
release that stopped reading it would stop single sign-on routing and
the connection projection for the length of the deploy. Dropped by
`20260827120000_drop_sso_connection_allows_jit` in the next one.''']
  arrivalPolicyDecidedAt DateTime [note: '''When somebody CHOSE the policy above, and null while the registration
default stands. A different fact from the policy rather than a second
copy of it: a connection always has a behaviour, and separately
somebody has or has not decided on it. Going live waits for the
deciding - "turn everybody away" is a decision too.''']
  source String [not null, note: 'self-serve | legacy-grandfathered']
  testLoginAccountId String
  replacesConnectionId String [note: '''The grandfathered connection this direct connection replaces. Null for
ordinary connections and for the grandfathered predecessor itself.

Partial uniqueness for nonterminal replacements is installed by the
flattened migration; Prisma cannot express that predicate here.''']
  migrationPhase SsoConnectionMigrationPhase [note: '''SETUP | GRACE_LEGACY | GRACE_DIRECT | FINALIZING | FINALIZED.
Null means this connection is not a legacy-to-direct replacement.''']
  graceStartedAt DateTime
  routeChangedAt DateTime [note: '''When an administrator last selected the normal route. This is audit
evidence only: routing is derived from `migrationPhase`, never recency.''']
  finalizationRequestedAt DateTime
  finalizedAt DateTime
  rejection Json [note: '{ domain, note } - the last ops rejection, read back on a re-claim.']
  createdBy String
  tearDownAfter DateTime [note: 'While TEARDOWN_PENDING: when the process manager\'s wake completes it.']
  occurredAt DateTime [not null]
  lastEventId String [not null]
  acceptedAt DateTime [not null]
  projectionVersion String [not null]
  createdAt DateTime [not null, note: '''Event-derived, not database-managed: `@default(now())` / `@updatedAt`
would make a replayed row differ from the row it rebuilds, which is
exactly the parity this projection has to keep.''']
  updatedAt DateTime [not null]

  Note: '''The SSO connection pipeline\'s projection (ADR-117 §5, D04 - see
specs/identity/sso-connection-lifecycle.feature). A pure event-truth head
like `Identifier`: every column is fold-written, rows are never deleted
(TORN_DOWN is a tombstone), and a replay rebuilds it whole-row from the
event log.

The fold cursor lives on the row rather than in a sibling table, because
one row IS one aggregate here - a connection - so there is nothing for a
separate cursor table to key on that this row does not already key on.

No relation to Organization on purpose, matching `Identifier`: a
projection is rebuilt from events, and a foreign key would make a replay
depend on relational state the log does not carry. `idpMetadata` holds
endpoints and credential REFERENCES; no secret is ever stored here or in
any event.'''
}

Table SsoConnectionRegistrationSlot {
  organizationId String [not null]
  kind String [not null, note: 'legacy | direct']
  connectionId String [unique, not null]
  replacesConnectionId String
  commandId String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]

  indexes {
    (organizationId, kind) [pk]
  }

  Note: '''The one-statement pre-event registration lock. `SsoConnection` remains
event truth; this row only decides which command may append that truth.
A slot whose projected connection is terminal may be atomically replaced.'''
}

Table SsoConnectionReproofCursor {
  connectionId String [pk]
  lastReproofAt DateTime [not null]

  Note: '''Operational round-robin position for ADR-123\'s domain re-proof sweep.

This is deliberately not a column on `SsoConnection`: that row is a
whole-row event projection and its fold is its only writer, while a
healthy re-read states no fact. Keeping the scheduling cursor beside the
projection preserves both rules and still lets a fixed-size sweep revisit
every connection, including one whose proof has started wavering.'''
}

Table SsoCredential {
  id String [pk]
  organizationId String [not null]
  connectionId String [not null, note: '''The connection whose registration minted this. Not a relation, matching
`SsoConnection` itself: a projection rebuilt from events must not depend
on relational state the log does not carry.''']
  kind String [not null, note: 'oidc-client-id | oidc-client-secret | saml-idp-config']
  ciphertext String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  Note: '''The values an `SsoConnection`\'s credential references point AT (D09 - see
specs/identity/sso-idp-termination.feature).

The aggregate has always carried `clientIdRef` / `secretRef` / `certRefs`
rather than values, because a fact may not carry a secret (ADR-101 §4).
Until D09 there was nothing behind the references and every writer passed
null. This is the thing behind them.

`ciphertext` is AES-256-GCM under the deployment\'s `CREDENTIALS_SECRET`,
the same key every other credential in the product is kept under. Nothing
reads a row except the projection that builds the engine\'s dialing
configuration; no surface renders one back.

Written by the command path rather than the fold, and that split is
deliberate: the VALUE is not event truth and cannot be, so the log records
WHEN a credential changed (a new reference in a new fact) and never what
it was. A replay rebuilds every reference from the log and finds the value
still here.'''
}

Table SsoVerifiedDomain {
  domain String [pk]
  organizationId String [not null]

  indexes {
    (domain, organizationId) [unique]
  }

  Note: '''better-auth\'s single sign-on plugin\'s provider table (D09), and a
PROJECTION of the connection log rather than a second source of truth.

The plugin owns the columns and the reads: it is the only thing that
speaks OpenID Connect discovery or reads a SAML assertion, and it dials
what it finds here. What it never does is decide that a row should exist —
that is folded from `SsoConnection`\'s events by the same projection that
writes the connection head, in the same transaction, so a replay rebuilds
both together and a row can never outlive the connection that justified
it. Nothing else writes here.

`providerId` is the CONNECTION ID rather than the name the customer typed.
The plugin\'s column is globally unique, and two organizations both calling
their provider `okta` must both be able to.

`oidcConfig` and `samlConfig` are the plugin\'s own JSON documents, rebuilt
on every fold from `SsoCredential` — the vault is where the material
lives, and this row is a derived copy the engine can read synchronously.

SEALED AT REST, under the same key the vault uses. The document carries
the client secret the derivation reads OUT of the vault, so a plaintext
copy here would hand every customer\'s live identity-provider credential
to anybody holding a database dump — the exact threat `SsoCredential`
exists to defeat, reopened one table over. A stored value announces its
form (`enc:v1:`), so a row written before the seal existed still opens;
the one reader is the identity storage adapter, on the path that dials.
The reader tolerates both forms, so this needs no backfill — but a pod
without it cannot read a sealed row, so it must not be rolled back past.
WHO OWNS A PROVED DOMAIN, as a row the database can refuse twice.

"First verifier owns" was enforced by reading `findDomainOwner` and then
writing the fact — two different aggregates, so the per-connection queue
never ordered them against each other, and `SsoConnection.verifiedDomains`
is a `String[]` with only a GIN index behind it, which enforces nothing.
Two organizations proving `acme.com` at the same moment both read "nobody
owns it" and both committed; the sign-in router then picked between two
live connections by planner order, so a member of one company could be
handed to another company\'s identity provider — and with `arrivalPolicy`
on `admit`, provisioned into it.

The legacy single-domain model had this: `Organization.ssoDomain` is
`@unique`. The multi-domain rewrite dropped the guarantee, and self-serve
proof is what made the race reachable by customers rather than by two
operators working at once.

`domain` is the primary key, so a second organization loses on the
constraint rather than on a check it raced. Connection holders are
separate because an exact predecessor/replacement pair must coexist
during migration. Both are projected with the connection head.'''
}

Table SsoVerifiedDomainHolder {
  domain String [not null]
  connectionId String [not null]
  organizationId String [not null]

  indexes {
    (domain, connectionId) [pk]
  }

  Note: '''A connection currently entitled to use an organization-owned verified
domain. Usually there is one holder. During an Auth0 migration there are
exactly two: the grandfathered predecessor and its direct replacement.

The projection repository enforces that relationship before inserting a
second holder. The flattened migration also installs partial unique live
legacy/direct slots on `SsoConnection`, closing concurrent third-writer
races that Prisma cannot describe declaratively.'''
}

Table SsoAuthenticationActivity {
  id String [pk]
  organizationId String [not null]
  connectionId String [not null]
  userId String [not null]
  authenticatedAt DateTime [not null]
  providerAccountId String [note: 'The provider-side account the assertion named; null before #7633\'s arrival door recorded it.']

  Note: '''A successful callback through one SSO connection. Identifier.lastUsedAt
also advances during routing and resolution, so it cannot prove that a
member actually authenticated through the replacement before cutover.'''
}

Table SsoProvider {
  id String [pk]
  issuer String [not null]
  oidcConfig String
  samlConfig String
  userId String
  providerId String [unique, not null]
  organizationId String
  domain String [not null]
}

Table SsoBreakGlassBinding {
  id String [pk]
  organizationId String [not null]
  userId String [not null, note: 'Who holds the way in.']
  grantedByUserId String [not null, note: 'Who granted it. A way back in is never self-served.']
  grantedAt DateTime [not null]
  expiresAt DateTime [not null]
  supersededAt DateTime [note: 'Set when a renewal replaced this row; the row itself is never edited.']
  renewedFromId String [note: 'The binding this one renewed, so the previous end date stays readable.']
  warnedDays Int[] [not null, note: '''Which of the fourteen, seven and one day warnings have been sent, so a
sweep that runs twice in a day never says the same thing twice.''']
  createdAt DateTime [default: `now()`, not null]

  Note: '''A way back in (D05 - see specs/identity/sso-onboarding-tiers.feature).

One named person who may still sign in without the identity provider
while their organization\'s sign-in belongs to one, and the date on which
that stops. Activation asks whether such a person exists, because the
failure it prevents is the only one that cannot be recovered from inside
the product: a misconfigured connection goes live, every member is handed
to an identity provider that will not authenticate them, and nobody is
left who can turn it off.

Rows are immutable except for `supersededAt` and `warnedDays`. A renewal
writes a NEW row naming the one it replaced, so the date a way in
previously ended is still readable in the history - which is what makes a
renewal auditable rather than a column somebody moved.

No relation to Organization or User, matching the identity heads above:
the binding is the record of who could get in, and a cascade would erase
exactly the history a lockout post-mortem reads.'''
}

Table SsoActivationRecoveryReservation {
  commandId String [pk]
  organizationId String [not null]
  connectionId String [not null]
  createdAt DateTime [not null]

  indexes {
    (organizationId, connectionId) [unique]
  }

  Note: '''A durable claim on one live recovery path while activation is between its
guard and projected ACTIVE fact. It has no expiry: only projection of the
matching activation, or an explicit cancellation, may consume it.'''
}

Table JoinRequest {
  id String [pk]
  userId String [not null]
  organizationId String [not null]
  domain String [not null, note: 'The normalized domain the match was made on.']
  state String [not null, note: 'PENDING | APPROVED | REJECTED | EXPIRED | WITHDRAWN']
  matchedVia String [not null, note: 'How the domain was matched: `verified-identifier-domain` or `sso-connection-domain`.']
  origin String [default: 'web', not null, note: '''Where the request was made: `web` or `cli` (ADR-171 v6). A request from
the terminal lands a Developer seat whatever the joiner seat says.''']
  expiresAt DateTime [note: 'While PENDING: when the day-14 wake lapses it. Null once resolved.']
  resolvedAt DateTime
  resolvedByType String [note: '''user | policy | invite - who ended it. `policy` is domain auto-join\'s
own principal, deliberately not the one SSO auto-join uses.''']
  resolvedById String [note: 'The admin\'s user id, `domain-auto`, or the invitation id.']
  withdrawalCause String [note: 'user | invite-accepted, on a withdrawal.']
  connectionId String [note: 'The SSO connection a single sign-on arrival was admitted through; null otherwise.']
  occurredAt DateTime [not null]
  lastEventId String [not null]
  acceptedAt DateTime [not null]
  projectionVersion String [not null]
  createdAt DateTime [not null, note: '''Event-derived, not database-managed: `@default(now())` / `@updatedAt`
would make a replayed row differ from the row it rebuilds, which is
exactly the parity this projection has to keep.''']
  updatedAt DateTime [not null]

  Note: '''The join-request pipeline\'s projection (ADR-117, D12 - see
specs/identity/join-requests.feature). A pure event-truth head like
`Identifier` and `SsoConnection`: every column is fold-written, rows are
never deleted (a terminal state is a tombstone the admin panel stops
listing, not an absence), and a replay rebuilds it whole-row from the
event log.

The fold cursor lives on the row rather than in a sibling table, because
one row IS one aggregate here - a request.

No relation to Organization or User on purpose, matching the two heads
above: a projection is rebuilt from events, and a foreign key would make a
replay depend on relational state the log does not carry.

Membership is NOT here. An approval dispatches an attach on the grants
ledger, exactly as accepting an invitation does, and that ledger fact
carries `source: "join-request"` as its provenance - which is what puts a
join approval on the customer\'s audit page beside every other membership
change rather than in a history of its own.

The requester\'s address is not here either: the DOMAIN is the fact, and it
is the only part of an address a join decision may depend on.'''
}

Table TeamUser {
  userId String [not null]
  teamId String [not null]
  role TeamUserRole [not null]
  assignedRoleId String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]

  indexes {
    (userId, teamId) [pk]
  }
}

Table OrganizationUser {
  userId String [not null]
  organizationId String [not null]
  role OrganizationUserRole [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]
  departmentId String [note: '''Department assignment for spend attribution (the people lens).
Single-valued, org-scoped, accounting-only (never gates access).
Plain column ref (relationMode="prisma"); the service validates the
id belongs to this org. See departments.feature.''']
  disabledAt DateTime [note: '''Set when an admin disables this membership to stay within the licensed
seat count. The person loses access to this organization only, keeps
their role, department and everything they did, and frees their seat.
Reversible: re-enabling restores access if a seat is available.
Seat counting excludes disabled memberships. See
seat-reconciliation.feature.''']
  pendingSsoGrantId String [note: '''Stable grant intent for an unfinished automatic SSO admission.
Cleared after the authoritative grant is observed; never inferred from missing access.''']
  membershipStamp String [not null, note: '''A new generation for each membership lifetime. Stamped USER grant facts
must match the current active membership before they can be projected;
removing and rejoining therefore cannot revive a delayed old attach.''']
  fullSeatSince DateTime [note: '''When this membership started holding the full seat it holds now; null means createdAt.
Anchors the 30-day seat hold (specs/licensing/seat-rotation.feature).''']
  seatPendingSince DateTime [note: '''Set when admission wrote this membership disabled because no seat was free: the person
is waiting for one. Cleared when the membership is enabled.''']

  indexes {
    (userId, organizationId) [pk]
  }
}

Table SeatHold {
  id String [pk]
  organizationId String [not null]
  userId String [not null]
  email String [note: 'Display copy for the Users list, kept because a removed person has no membership row.']
  name String
  seatTakenAt DateTime [not null, note: 'When the person took the seat this hold keeps.']
  heldUntil DateTime [not null, note: 'seatTakenAt plus 30 days; expired holds are ignored by every count and deleted hourly.']
  reason String [not null, note: 'REMOVED | DISABLED | DEMOTED']
  createdAt DateTime [default: `now()`, not null]

  indexes {
    (organizationId, userId) [unique]
  }

  Note: '''A full seat still counted after the person who took it stopped holding it (removed,
disabled or demoted), until 30 days after they took it (specs/licensing/seat-rotation.feature).
One per organization and person; a return within the hold takes the seat back.'''
}

Table SeatRequest {
  id String [pk]
  organizationId String [not null]
  email String [not null, note: 'Lowercased address of the person asking.']
  userId String [note: 'Null when only the address is known (a sign-in the identity provider refused).']
  name String
  status String [not null, note: 'OPEN | APPROVED | DECLINED']
  source String [not null, note: 'pending | lite | idp_refused: how the person was left when the request opened.']
  idpRefused Boolean [default: false, not null, note: 'The identity provider also refused this person\'s sign-in.']
  idpKind String [note: 'okta | entra | google | onelogin | jumpcloud | ping | auth0 | oidc | saml']
  salesNotifiedAt DateTime [note: 'When sales were told about this request; reset when it reopens.']
  openedAt DateTime [not null]
  resolvedAt DateTime
  resolvedByUserId String
  seatPendingSince DateTime [note: '''Set when an approval claims the request, cleared once its seat is given; an approval
still pending long after is one whose seat never landed, and is reopened.''']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]

  indexes {
    (organizationId, email) [unique]
  }

  Note: '''A person asked for a full seat the organization had no room for (modules/organization/specs/
seat-requests.feature). One row per organization and address; reopening reuses the row.'''
}

Table OrganizationSeatLease {
  organizationId String [pk]
  holder String [not null, note: 'Random per hold, so a release deletes only its own lease.']
  expiresAt DateTime [not null]
  createdAt DateTime [default: `now()`, not null]

  Note: '''Held by the one seat-taking write running on an organization (seat-requests.feature). A
row past expiresAt is free to take; a holder deletes its own row when its write is done.'''
}

Table OrganizationAccessNotice {
  id String [pk]
  organizationId String [not null]
  kind String [not null, note: 'seat_request | idp_refused']
  email String [not null]
  name String
  idp String
  dayKey String [not null, note: 'UTC day the notice was recorded on, YYYY-MM-DD.']
  idpRefused Boolean [default: false, not null, note: 'Whether the seat request it announces was also refused by the identity provider.']
  createdAt DateTime [default: `now()`, not null]
  mailedAt DateTime [note: 'Set once the notice was handed to the mailer; null if a send never started.']

  indexes {
    (organizationId, kind, email, dayKey) [unique]
  }

  Note: '''The mail log for seat requests and refused sign-ins: at most one row per organization,
kind, address and UTC day, each mailed at once.'''
}

Table Team {
  id String [pk]
  name String [not null]
  slug String [unique, not null]
  organizationId String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]
  archivedAt DateTime
  isPersonal Boolean [default: false, not null]
  ownerUserId String
  departmentId String [note: '''Department assignment inherited as the default for members and
projects that have none of their own. Accounting-only.''']
}

Table Organization {
  id String [pk]
  name String [not null]
  kind String [default: 'customer', not null, note: '''`customer` for every organization a person founds or an operator provisions; `system` for
the install\'s one hidden organization the Ops checkup canaries run in, never listed to a person.
Spec: modules/ops/specs/checkup-canary-project.feature.''']
  phoneNumber String
  slug String [unique, not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]
  usageSpendingMaxLimit Int
  datasetAttachmentMaxMb Int [note: '''The largest file a dataset image or file cell accepts for this
organization, in mebibytes. Null means the default. Set by an operator
from the back office only; every other dataset size limit scales with it.''']
  privateClickHouseLabel String [note: '''The label of this organization\'s `CLICKHOUSE_URL__<label>__<id>` route, recorded by the
organization module the first time it is seen. Once set, a missing route refuses the
organization instead of serving it from the shared ClickHouse. Null: never private.
Spec: specs/private-dataplane/clickhouse-routing.feature.''']
  privateS3Label String [note: 'The same for `DATAPLANE_S3__<label>__<id>`. Spec: specs/private-dataplane/s3-routing.feature.']
  privateDataplaneSeenAt DateTime [note: 'When either label was first recorded.']
  maxSessionDurationDays Int [default: 0, not null, note: '''Phase 8 - admin-configurable max lifetime for CLI device-flow
sessions, in days. 0 = unbounded (default, mirrors GitHub CLI /
gh-style flows). Companies that need finite session lifetime
(eg. SOC 2 / ISO 27001 customers with mandated session
expiration) can set a positive value. The /api/auth/cli/refresh
endpoint rejects refresh attempts where now - issued_at exceeds
this value, regardless of the underlying refresh-token TTL.
Spec: specs/ai-governance/sessions/session-ttl.feature.''']
  mfaRequired Boolean [default: false, not null, note: '''Every member of this organization can prove a second factor (D06). A
MEMBERSHIP CONDITION, not a session policy: it is asked when a member
reaches this organization\'s data, it holds the ones who cannot prove
one at an enrollment gate for THIS organization alone, and it ends no
session, ever. Turning it on signs nobody out.
Spec: specs/identity/mfa-and-session-shape.feature.''']
  lockoutAfterFailedAttempts Int [default: 0, not null, note: '''How many consecutive failed sign-ins lock an account (GAC-09).
0 = never lock, which is the default and what every organization that
has not asked for this keeps. Counts EVERY credential together - a
password, a one-time code, a backup code, a passkey - because five per
factor hands an attacker one budget per factor.
Spec: specs/identity/org-account-lockout.feature.''']
  lockoutMinutes Int [default: 30, not null, note: 'How long a lock lasts, in minutes. Ignored while the threshold is 0.']
  sessionIdleTimeoutMinutes Int [default: 1440, not null, note: '''How long a BROWSER session may sit idle before it ends, in minutes
(GAC-10). 0 = no idle timeout. Activity rolls the window, which is the
"refreshed every hour" half of the control.

A day for organizations created from now on; organizations that predate
the column keep 0 and are unchanged, because the migration adds the
column at zero and moves the default afterwards.

NOT `maxSessionDurationDays`, which bounds CLI and device sessions and
is enforced when the CLI refreshes. Two surfaces, two lifetimes, two
decisions an administrator makes separately.
Spec: specs/identity/org-session-lifetime.feature.''']
  sessionMaxLifetimeMinutes Int [default: 0, not null, note: '''The ceiling on a browser session from the moment it was minted, in
minutes, which no amount of activity extends. 0 = no ceiling, the
default. Offered beside the idle timeout because a session kept alive
forever by a polling page is not really bounded.''']
  signupData Json
  signedDPA Boolean [default: false, not null]
  elasticsearchNodeUrl String
  elasticsearchApiKey String
  useCustomElasticsearch Boolean [default: false, not null]
  s3Endpoint String
  s3AccessKeyId String
  s3SecretAccessKey String
  s3Bucket String
  useCustomS3 Boolean [default: false, not null]
  sentPlanLimitAlert DateTime
  ssoDomain String [unique]
  ssoProvider String
  domainJoin String [default: 'request', not null, note: '''How colleagues on a matching domain get in (D12, ADR-117):
`off` (invisible to them entirely) | `request` (they ask, an admin
approves) | `auto` (a verified colleague walks straight in).

`request` is the default for a self-serve organization; `auto` is never
a default and never inferred - an administrator turns it on, names the
domain in `joinDomains` while doing it, and the licence gate holds that
value while letting `request` through.''']
  joinerRole OrganizationUserRole [default: 'MEMBER', not null, note: '''The organisation role handed to a person admitted without an invitation:
a self-service domain join (`domainJoin`) or an SSO-admitted login.
`MEMBER` (default, a Full seat) or `DEVELOPER` (ADR-171). Set on the
organisation settings page only; the join flow never asks, and an
invitation always names its own role.''']
  joinDomains String[] [not null, note: '''The domains an administrator NAMED when turning automatic joining on.
Empty means automatic joining admits nobody whatever `domainJoin` says -
which is what keeps a setting left on from admitting a domain nobody
ever agreed to.''']
  presenceEnabled Boolean [default: true, not null]
  traceSharingEnabled Boolean [default: true, not null, note: '''Org-level trace-sharing kill switch. Off = trace share links cannot be
created in ANY project of this org, and existing links stop resolving —
the org toggle is the global switch, the per-project
`Project.traceSharingEnabled` scopes the kill to a single project (mirrors
`presenceEnabled`). Effective sharing = org AND project. ADR-039.''']
  supportContact String [note: '''Org-configurable contact surfaced to users in CLI "contact your
admin" messages and the in-app budget-exceeded banner. Free text:
accepts an email, a URL (internal ticketing system), or any other
instruction. When null, callers fall back to the first ADMIN
member\'s email (`resolveSupportContact` helper).''']
  primaryIntent OrganizationIntent [note: '''Signup intent, editable later as the org "Primary use" setting.
AGENT_GOVERNANCE lands "/" on /me, LLM_OPS on the project home.
NULL means intent unset (every pre-fork org and any org created
outside onboarding) — the home resolver keeps legacy behavior.
ADR-038.''']
  promoCode String
  stripeCustomerId String [unique]
  currency Currency [default: 'EUR', not null]
  pricingModel PricingModel [default: 'TIERED', not null]
  license String
  licenseExpiresAt DateTime
  licenseLastValidatedAt DateTime
  selfHostedCustomer Boolean [default: false, not null, note: '''A customer that runs LangWatch self-hosted. The hosted usage, budgets and
invoices of its connected installs attach to this organization (ADR-139).''']
  connectServicesDisabled String[] [not null, note: '''LangWatch-hosted services this organization has switched OFF, named the
way its license names them ("instant_evals"). A service the license is
entitled to is on unless it is listed here, so a customer who bought
hosted judging gets it without finding a settings page first, and an
administrator who switched one off keeps it off across license changes
(ADR-139, section 2). A license that names no service reaches nothing,
whatever this column holds.''']
  instantEvalsEnabledAt DateTime [note: '''When a member of this organization switched Instant Evals on from the
search bar, which is the organization\'s consent to have judged text sent
to the judge\'s provider. Null until then: a self-serve organization is
never opted in on its behalf, and an enterprise one is switched on by an
operator through the release flag after asking, never here.''']
  instantEvalsEnabledByUserId String [note: '''The member who switched them on, so the audit trail names a person and
not just a moment.''']
  connectLastSyncAt DateTime [note: 'When the last license sync succeeded.']
  connectLastSyncError String [note: '''The code of the failure the last sync ended on, cleared on the next
success. Settings, Connect renders the copy for it.''']
}

Table IssuedLicense {
  id String [pk]
  licenseId String [unique, not null, note: 'The `licenseId` inside the signed license (`lic-<uuid>`).']
  tokenHash String [unique, not null, note: 'SHA-256 of the `lwl_` token. Looked up on every credential resolution.']
  organizationId String [note: '''The customer organization on LangWatch Cloud. Null for a license that is
recorded but not linked to a customer yet, such as a self-serve purchase:
it resolves to nothing until an operator links it.''']
  organizationName String [not null, note: 'As signed into the license.']
  email String [not null]
  planType String [not null]
  maxMembers Int [not null]
  maxMembersLite Int [note: 'The lite seats sold: null when not stated or when unlimited. Never a stand-in number.']
  liteSeatsUnlimited Boolean [default: false, not null, note: 'True when the license sells unlimited lite seats; maxMembersLite is then null.']
  maxMembersDeveloper Int [note: 'The Developer seats sold: null when not stated, which sells none.']
  issuedAt DateTime [not null]
  expiresAt DateTime [not null]
  source IssuedLicenseSource [not null]
  issuedById String [note: 'The operator who issued or registered it. Null for the purchase flow and the script.']
  revokedAt DateTime
  revokedById String
  revokedReason String
  supersededAt DateTime [note: 'Set when the install first presents the license that replaced this one.']
  replacesId String [unique, note: '''The id of the IssuedLicense this one replaces, when it was reissued. A
plain column ref (relationMode="prisma" cannot declare a self-relation on
Postgres); the registry service validates it. Unique, so a license is
replaced by one license at most.''']
  pendingDeliveryLicense String [note: '''A reissued license waiting to be delivered over sync, encrypted. Erased
when the install first presents it. The only license text the registry holds.''']
  services String[] [not null, note: 'Hosted services this license may call, such as `instant_evals`.']
  seatRateCents Int [note: 'The annual rate of one seat, in cents of `seatCurrency`. Needed to prorate added seats.']
  seatCurrency Currency
  commitUsdCents Int [default: 0, not null, note: 'The prepaid usage commit for the term, in USD cents.']
  overageEnabled Boolean [default: false, not null, note: 'Whether usage may continue past the commit, up to `overageMaxUsdCents`.']
  overageMaxUsdCents Int
  instanceId String [note: 'The install this license is bound to. Set on first use, cleared by an operator.']
  instanceBoundAt DateTime
  lastSyncAt DateTime [note: '''The last license sync this install reported: when it arrived, the
LangWatch version that sent it, and the seats in use at that moment.
Null until the install syncs for the first time.''']
  lastSyncVersion String
  reportedMembers Int
  reportedMembersLite Int
  virtualKeyId String [unique, note: '''The managed gateway key (purpose CONNECT) that hosted-service traffic of
this license runs under. One per license, so spend rows name the install.
Created when the license first resolves. A plain column, not a relation.''']
  seatsRaisedFrom Int [note: '''The seats of the license this one replaced, set only when a seat change
raised a linked license. Billing reads it through licensing to invoice
the added seats, so the fact commits with the license or not at all.''']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  Note: '''The registry of licenses LangWatch has issued (ADR-139). It lives on
LangWatch Cloud; a self-hosted install has the table and no rows.

The row never holds the token an install presents. `tokenHash` is the
SHA-256 of that token, so read access to this table is not credential
access. Status is derived: revoked, superseded, past `expiresAt`, else active.'''
}

Table OrganizationLicense {
  organizationId String [pk]
  licenseKey String
  expiresAt DateTime
  validatedAt DateTime
  updatedAt DateTime [default: `now()`, not null]

  Note: '''The licence an organization activated and its dates, owned by licensing
(round 37 D6). A row whose key is null is a cleared licence. An organization
with no row is read from its Organization columns until the copy step runs.'''
}

Table ActivationCode {
  id String [pk]
  codeHash String [unique, not null, note: 'SHA-256 of the normalised code. Looked up on every redemption.']
  codeHint String [not null, note: '''The last four characters, so an operator tells two codes apart in a list
without the list holding either one.''']
  organizationId String [not null, note: 'The customer this code belongs to, and the terms it mints.']
  organizationName String [not null]
  email String [not null]
  planType String [not null]
  maxMembers Int [not null]
  maxMembersLite Int [default: 0, note: 'The lite seats the minted license carries: null when unlimited. Never a stand-in number.']
  liteSeatsUnlimited Boolean [default: false, not null, note: 'True when the minted license carries unlimited lite seats; maxMembersLite is then null.']
  maxMembersDeveloper Int [note: 'The Developer seats the minted license carries: null when not stated, which sells none.']
  licenseTermDays Int [not null, note: 'How long the license this code mints runs for.']
  services String[] [not null, note: 'Hosted services the minted license may call.']
  expiresAt DateTime [not null, note: 'When the code stops working, which is not the term of what it mints.']
  reusable Boolean [default: false, not null, note: 'A code a customer may redeem on more than one install, for a rollout.']
  redeemedAt DateTime [note: '''Set by the redemption that won, which is what makes a single-use code
single use: the write itself carries the condition.''']
  redeemedByInstanceId String
  issuedLicenseId String [note: 'The license the winning redemption minted.']
  redemptionCount Int [default: 0, not null, note: 'How many installs have redeemed it, which only moves on a reusable code.']
  revokedAt DateTime
  revokedById String
  createdById String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  Note: '''A short code a fresh install pastes instead of a license blob (ADR-139,
section 5). Redeeming it mints the license the code describes and returns
it signed, which is what identifies a new customer without anybody emailing
a license key around.

The row holds a hash of the code, never the code. Every lookup hashes what
the caller presented first, so the stored value is a step away from anything
that could be presented: read access to this table is not credential access.'''
}

Table ConnectedBillingAccount {
  id String [pk]
  organizationId String [unique, not null]
  stripeCustomerId String [unique, not null, note: 'The customer at the payment provider. Invoiced, never charged.']
  usageSubscriptionId String [note: '''The one metered subscription, and the item hosted usage is reported on.
Null between the customer being created and the subscription existing,
which is where a half-finished onboarding resumes from.''']
  usageSubscriptionItemId String
  termStartsAt DateTime [not null]
  termEndsAt DateTime [not null]
  commitUsdCents Int [default: 0, not null, note: 'Prepaid usage for the term, in USD cents. The credit grants add up to it.']
  seatCurrency Currency [not null, note: 'The seat contract, which may be in another currency than hosted usage.']
  seatRateCents Int [not null]
  seats Int [not null]
  bankTransferType String [note: '''`us_bank_transfer` or `eu_bank_transfer` when the customer pays into a
virtual bank account at the provider. Null when it wires to LangWatch\'s
own account and finance marks the invoice paid.''']
  bankTransferCountry String
  billingEmail String [not null]
  pendingRenewal Json [note: '''A renewal whose credit is waiting for the last usage invoice of the old
term to be finalized: the new term\'s end and commit, and who asked.''']
  createdById String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]

  Note: '''How a connected customer is invoiced (ADR-139, section 7): one payment
provider customer, one quarterly usage subscription in USD, and the
commercial terms the annual invoice was raised from.

One row per organization. Every write through it is addressed by a stored
provider id, so running onboarding or a renewal twice changes nothing.'''
}

Table ConnectedCreditGrant {
  id String [pk]
  accountId String [not null, note: '''The `ConnectedBillingAccount` row. A plain column ref, like
`IssuedLicense.replacesId`: relationMode="prisma" carries no foreign keys.''']
  stripeCreditGrantId String [unique, not null, note: 'The grant at the payment provider. Unique, so a retry records one row.']
  amountUsdCents Int [not null]
  kind ConnectedCreditGrantKind [not null]
  termEndsAt DateTime [not null, note: '''The term this credit was granted for, and when the provider lets it lapse:
after the last invoice of that term has been finalized, never on the day
the term ends.''']
  expiresAt DateTime [not null]
  createdAt DateTime [default: `now()`, not null]

  Note: '''A paid credit at the payment provider, which only metered usage draws down.
Kept here so a grant is created once per reason and the backoffice can show
what the customer holds without asking the provider.'''
}

Table ConnectedInvoice {
  id String [pk]
  accountId String [not null, note: 'The `ConnectedBillingAccount` row, as a plain column ref.']
  stripeInvoiceId String [unique, not null]
  kind ConnectedInvoiceKind [not null]
  currency Currency [not null]
  amountCents Int [not null]
  status String [not null, note: 'The provider\'s own status: `draft`, `open`, `paid`, `void` or `uncollectible`.']
  paidOutOfBandAt DateTime
  termStartsAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]

  Note: '''An invoice LangWatch raised for a connected customer, as the backoffice
reads it.'''
}

Table ScimRequestLog {
  id String [pk]
  organizationId String [not null]
  connectionId String [note: '''Null when the refusal resolved an organization and stopped before the
connection — a lapsed plan is answered off the token alone.''']
  method String [not null]
  resource String [not null, note: '''The SCIM resource asked for ("Users", "Users/:id", "Groups"), never the
raw path: a path carries ids and query strings, and this is read by
people rather than matched by machines.''']
  status Int [not null]
  reason String [note: '''A stable slug, only on a refusal, so a reader branches on this and never
on the sentence beside it.''']
  detail String [note: 'Our own short sentence, customer-safe.']
  occurredAt DateTime [default: `now()`, not null]

  Note: '''Every SCIM request we could attribute, and what we answered (ADR-126).

EVIDENCE, NOT TRUTH. A request authors nothing — an HTTP round trip that
was refused decided nothing — so this is a table and not an event: nothing
downstream derives from it, rebuilding the world from the log must not
depend on how often a provider retried a GET, and rows age out of a
retention window an event log would never have.

NO ROW FOR A REQUEST WE CANNOT ATTRIBUTE. A token that does not verify is
answered 401 and recorded nowhere: we do not know whose organization to
file it under, and a table unauthenticated traffic can write is a table
anybody on the internet can fill. What answers that case instead is
`ScimToken.lastUsedAt` being null. The 403 IS recorded — a lapsed plan is
a credential we recognize.

THE PAYLOAD RULE HOLDS. A method, a resource name, a status, a reason slug
and our own sentence. Never a token, never a header, never a provider\'s
raw message — the same reason `scim_apply_failed` carries a code and not a
message.'''
}

Table ScimToken {
  id String [pk]
  organizationId String [not null]
  connectionId String [note: '''D08: the SSO connection this token was issued for, and its ENTIRE write
authority — a token minted for one connection can never touch another
connection\'s people. No relation, matching `SsoConnection` itself: that
projection carries no foreign keys, so neither may a row pointing at it.

Nullable only for the tokens that predate the column. They were minted
when "which organization" was the whole answer, so they keep the
organization-wide authority they were sold with; the backfill points
each at its organization\'s first connection where there is one. Minting
a NEW token without a connection is refused (`scim_connection_required`).''']
  hashedToken String [unique, not null, note: '''UNIQUE, and that is a tenancy boundary rather than tidiness.

The lookup that turns a bearer token into an organization is keyed on
this column alone — it has to be, since the token is the only thing the
caller presents. While every token was 32 random bytes a collision was
impossible and the missing constraint cost nothing. An administrator may
now supply a value they already hold, so two organizations CAN choose the
same string, and without this the lookup would answer with whichever row
the planner reached first: one customer\'s directory provisioning and
deleting another customer\'s people.''']
  hashScheme String [default: 'sha256', not null, note: '''How `hashedToken` was derived, so the two schemes can coexist while
tokens minted under the old one are still in use.

`sha256` is a bare digest, which is correct for 32 random bytes and wrong
for a value a person chose — a database dump of those is a wordlist away
from live credentials. `hmac-sha256` is keyed on the deployment\'s own
secret, so a dump on its own is inert. Every new row is the latter.''']
  description String
  createdAt DateTime [default: `now()`, not null]
  lastUsedAt DateTime
}

Table ScimExternalId {
  organizationId String [not null]
  id String [pk]
  connectionId String [not null]
  externalId String [not null]
  userId String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]

  indexes {
    (connectionId, externalId) [unique]
  }

  Note: '''D08 — who the directory means, per connection.

The identity provider\'s own identifier for a person, which is what
survives their email changing: an address is not identity, people change
theirs, and the same person carries different identifiers on two different
connections. So the PAIR is the key and `externalId` alone never is.

No relation to `SsoConnection` (that projection carries no foreign keys);
the `User` relation is real, so a deleted user takes their directory
identities with them rather than stranding a mapping that resolves to
nobody.'''
}

Table ScimUserResource {
  organizationId String [not null]
  userId String [not null]
  userName String [not null]
  name String
  active Boolean [default: true, not null]
  deletedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]

  indexes {
    (organizationId, userId) [pk]
  }

  Note: 'Directory profile and lifecycle are tenant facts, independent of the shared account.'
}

Table ScimDirectoryUser {
  organizationId String [not null]
  connectionId String [not null]
  userId String [not null]

  indexes {
    (connectionId, userId) [pk]
  }

  Note: '''A connection\'s managed users, including resources without an externalId.
Scalar keys only; readers exclude users that no longer exist.'''
}

Table ScimSyncState {
  id String [pk, note: 'The aggregate: the connection\'s id, which IS its sync\'s id.']
  connectionId String [not null]
  organizationId String [not null]
  state String [not null, note: 'TOKEN_ISSUED | SYNCING | ERROR | REVOKED']
  lastPushedAt DateTime
  lastFailure Json [note: '''The failure standing right now: { op, errorCode, attempts, retiredAtMs,
userId, occurredAtMs }. A reason CODE and ids — never a token, never a
secret, never an internal hostname.''']
  deadLetters Json [default: '[]', not null, note: '''Every failure retired without ever being applied, newest last. The dead
letters an administrator has to see; retiring never drops one.''']
  revokedCause String [note: 'revoke | teardown, once the sync has ended.']
  occurredAt DateTime [not null]
  lastEventId String [not null]
  acceptedAt DateTime [not null]
  projectionVersion String [not null]
  createdAt DateTime [not null, note: '''Event-derived, not database-managed: `@default(now())` / `@updatedAt`
would make a replayed row differ from the row it rebuilds, which is
exactly the parity this projection has to keep.''']
  updatedAt DateTime [not null]

  Note: '''D08 — one connection\'s directory sync, as the `scim-sync` pipeline\'s fold
writes it.

Pure event truth: every column is fold-written, rows are never deleted,
and REVOKED is a tombstone rather than an absence — a dead letter that
vanished when a connection was torn down would be a removal nobody could
check afterwards.

No relation to Organization or SsoConnection, matching `SsoConnection`
itself: a projection is rebuilt from events, and a foreign key would make
a replay depend on relational state the log does not carry.'''
}

Table ScimSsoConnectionView {
  id String [pk, note: 'The aggregate: identity\'s connection id.']
  organizationId String [not null]
  folded Json [not null, note: 'The connection as the reducer folded it (SsoConnectionState + LastEventOccurredAt).']
  appliedEventIds String[] [not null, note: 'The event ids of the last delivery folded in, so a redelivery folds once.']
  projectionVersion String [not null, note: 'A row of another version reads as undecodable and is re-folded from the log.']
  createdAt DateTime [not null, note: 'Event-derived, so a replayed row equals the row it rebuilds.']
  updatedAt DateTime [not null]

  Note: '''SCIM\'s own copy of an organization\'s SSO connections: a peer fold over
identity\'s connection facts (ARCHITECTURE §9), folded with identity-contract\'s
reducer, one row per connection. SCIM reads this instead of asking identity.
Rebuilt from identity\'s event log by a projection replay, so no relation:
a foreign key would make a replay depend on state the log does not carry.'''
}

Table OrganizationSeatPeak {
  organizationId String [pk, note: 'The organization, which is also the aggregate id.']
  openedAt Float [not null, note: 'When the opening snapshot was taken, epoch milliseconds.']
  fullSeats Int [not null]
  liteSeats Int [not null]
  developerSeats Int [not null]
  latestChangeAt Float [not null, note: 'The latest change time applied to any holder; invitations expire up to it.']
  mismatches Int [not null, note: 'Changes whose `from` disagreed with the seat the fold held.']

  Note: '''Organization\'s monthly seat peak, folded from its seat changes (modules/organization, ADR-002).
A read model, one row per organization: rebuildable by replaying the event log, so no relation.
Epochs in milliseconds.
Organization\'s seat-peak counts (ADR-002): one row per organization once counting opened.'''
}

Table OrganizationSeatPeakHolder {
  organizationId String [not null]
  holderKind String [not null, note: '`member`, `invitation` or `hold` (a seat held after somebody left).']
  holderId String [not null, note: 'The member\'s or the hold\'s userId, or the invitation\'s id.']
  seat String [not null, note: '`full`, `lite`, `developer` or `none`.']
  lastChangedAt Float [not null]
  lastChangeId String [note: 'Absent for a seat the opening snapshot recorded.']
  expiresAt Float [note: 'An invitation\'s expiry; null for a member or an invitation that never expires.']
  expiredByFold Boolean [default: false, not null, note: 'The fold gave the invitation\'s seat back at `expiresAt`.']
  suppressedBy String [note: 'A hold whose seat a live full invitation to its address took: that invitation\'s id.']
  restoredByFold Boolean [default: false, not null, note: 'The fold gave a suppressed hold its seat back when that invitation expired.']

  indexes {
    (organizationId, holderKind, holderId) [pk]
  }

  Note: 'One member\'s or pending invitation\'s seat as the seat peak last applied it (ADR-002).'
}

Table OrganizationSeatPeakMonth {
  organizationId String [not null]
  month String [not null, note: '`YYYY-MM`.']
  fullPeak Int [not null]
  fullPeakAt Float [not null]
  litePeak Int [not null]
  litePeakAt Float [not null]
  fullAtEnd Int [not null]
  liteAtEnd Int [not null]

  indexes {
    (organizationId, month) [pk]
  }

  Note: 'One calendar month\'s (UTC) seat peaks for an organization (ADR-002).'
}

Table Project {
  id String [pk]
  name String [not null]
  slug String [unique, not null]
  apiKey String [unique, not null]
  legacyApiKeyLastUsedAt DateTime [note: '''When the legacy apiKey last authenticated a request, written at most once a
minute per project and process. Spec: modules/api-key/specs/request-credential-type.feature''']
  lwqlKey String [unique, not null, note: '''Random per-project secret whose SHA-256 digest is this project\'s LangWatchQL
SQL tenant capability in ClickHouse. Deliberately NOT the API key: the
credential a caller authenticates with and the capability the database
resolves a tenant from stay decoupled, so rotating one never invalidates
the other, and a leak of the ClickHouse key map\'s input discloses nothing
a caller could authenticate with. Generated by the database on insert.''']
  teamId String [not null]
  language String [not null]
  framework String [not null]
  kind String [default: 'application', not null, note: '''Project kind:
- "application": user-facing workspace where developers send their
own app traces. The default for everything created via the
onboarding/quickstart flow.
- "internal_governance": hidden per-org routing/tenancy artifact
for IngestionSource ingest data. Auto-created lazily on the
first IngestionSource mint via ensureHiddenGovernanceProject().
MUST be filtered out of every user-visible Project surface
(project picker, /api/v1/projects, billing exports, RBAC
pickers, etc.) - the regression-test invariant in
specs/ai-gateway/governance/ui-contract.feature codifies this.
- "aggregate": a project that owns no traces and reads its member
projects through shared project-reader grants (ADR-177). Hidden
from every "send traces here" picker and from ingestion; visible in
the project switcher to organisation admins only.
Stored as a free-form string (matching IngestionSource.sourceType
pattern) so future routing kinds can ship without schema migrations.''']
  aggregateRule Json [note: '''The scope rule an aggregate project materialises into grants. Null on
every other kind; decided in ADR-177. Shapes: { kind: "all-personal" } |
{ kind: "personal-by-department", departmentId } |
{ kind: "explicit", projectIds: string[] }.''']
  firstMessage Boolean [default: false, not null]
  integrated Boolean [default: false, not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]
  userLinkTemplate String
  traceSharingEnabled Boolean [default: true, not null]
  presenceEnabled Boolean [default: true, not null]
  s3Endpoint String
  s3AccessKeyId String
  s3SecretAccessKey String
  s3Bucket String
  archivedAt DateTime
  isPersonal Boolean [default: false, not null]
  ownerUserId String
  personalFeatures Json [default: '{}', not null, note: '''Per-feature unlock flags for personal projects only. Shape:
`{ evaluations: bool, datasets: bool, annotations: bool, automations: bool }`.
Empty `{}` (default) reads as all-false at the service layer -
existing rows pre-migration require no backfill. The bundle is
a UI/nav predicate, NOT an auth gate (the underlying tRPC
routers stay open even when the bundle is off; admin tooling +
offline migration scripts can still operate on the data).
Team / org-scope projects are not feature-gated - this column
is meaningful only when `isPersonal=true`.''']
  departmentId String [note: '''Department assignment for spend attribution (the project / agent
lens, used when a trace has no principal user). Accounting-only.''']
  langyEgressAllowlist Json [note: '''Per-project Langy egress allow-list (ADR-076). A nullable JSON array of
host patterns (`["registry.npmjs.org", "*.internal.acme.com"]`) that the
project\'s Langy workers may reach outbound. The *presence* of the list is
the enforcement mode: null/absent ⇒ monitor-only (watch, never block);
non-empty ⇒ the worker\'s egress adapter restricts outbound to
floor ∪ this list. Enforced in the agent pod\'s egress adapter — NOT the
gateway — so it lives on the project, not the VirtualKey. Resolved by
LangyCredentialService.getEgressAllowlist and threaded through the
per-request credentials envelope. See specs/langy/langy-egress-enforcement.feature.''']
  lastCodingAgentSessionAt DateTime [note: '''When a coding-agent session was last folded for this project, and when a
pull request was last mapped for a branch one of those sessions ran on.
Both are instrumentation signals, not counters: the project sidebar shows
its Sessions and Pull requests destinations only while the matching column
is inside the recency window, so a project that never sends coding-agent
telemetry never grows the two links, and one that stops sending loses
them again. Written through the throttled touch methods on
ProjectService, which skip the write while the stored value is still
recent, so a busy project costs at most one update an hour per column.
No index: every read is by project id, which is the primary key.
See specs/coding-agent/project-menu-links.feature.''']
  lastCodingAgentPullRequestAt DateTime
}

Table Department {
  id String [pk]
  organizationId String [not null]
  name String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]
  archivedAt DateTime

  Note: '''A department is a single-valued accounting dimension, separate from
RBAC, for rolling up AI spend by org unit (Engineering, Marketing,
...). Assigned to OrganizationUser, Team, and Project via their
`departmentId` column. Pure accounting: never grants or restricts
access. See specs/ai-gateway/governance/departments.feature.'''
}

Table DepartmentMembershipHistory {
  id String [pk]
  organizationId String [not null]
  userId String [not null]
  departmentId String [not null]
  validFrom DateTime [not null]
  validTo DateTime [note: 'Null means the link is open. Reassignment and clearing close it.']
  createdAt DateTime [default: `now()`, not null]

  Note: '''One dated person → department link (ADR-128 §13, #7882).

`OrganizationUser.departmentId` stays the CURRENT assignment every screen
reads; these rows are its history, appended by the same `assignUser` write
so the two cannot drift. They exist for the cost reads: January\'s spend
stays with January\'s department, so a read resolves against the link that
was open on the cost\'s day, not against today\'s pointer. Members with no
link on a day resolve to "unassigned", never to an error.

Same shape as IdentityMatch\'s dated links, same one-open-link guard: the
partial unique index in the migration rejects a second open row per
(organizationId, userId) with SQLSTATE 23505.'''
}

Table PlatformToolPolicy {
  id String [pk]
  organizationId String [not null]
  toolSlug String [not null]
  allowVk Boolean [default: true, not null]
  allowOtelDirect Boolean [default: true, not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]

  indexes {
    (organizationId, toolSlug) [unique]
  }

  Note: '''Per-(organization, tool) override for which `langwatch <tool>` paths the
CLI may use: `allowVk` gates the gateway / virtual-key path (Path A) and
`allowOtelDirect` gates the direct-OTLP ingestion path (Path B). A missing
row resolves to the hardcoded defaults (both true for claude/codex/gemini/
opencode; cursor allows the gateway path only), so the policy is purely
additive: disabling a path is an explicit admin choice. The CLI caches the
resolved map at login and gates path selection on it.
See specs/ai-gateway/governance/cli-tool-mode-policy.feature.'''
}

Table OrganizationInvite {
  id String [pk]
  email String [not null]
  inviteCode String [unique, not null]
  expiration DateTime
  status INVITE_STATUS [default: 'PENDING', not null]
  organizationId String [not null]
  teamIds String [not null]
  teamAssignments Json
  role OrganizationUserRole [not null]
  requestedBy String
  subscriptionId String
  acceptedByUserId String
  acceptedViaIdentifierId String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]
}

Table Monitor {
  id String [pk]
  projectId String [not null]
  experimentId String [unique]
  evaluatorId String
  checkType String [not null]
  name String [not null]
  slug String [not null]
  executionMode EvaluationExecutionMode [default: 'ON_MESSAGE', not null]
  enabled Boolean [default: true, not null]
  preconditions Json [not null]
  parameters Json [not null]
  mappings Json
  sample Float [default: 1, not null]
  level String [default: 'trace', not null]
  threadIdleTimeout Int
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]
  autoPausedAt DateTime
  autoPausedReason String
  evaluatorLabel String
  createdById String
  updatedById String

  indexes {
    (projectId, slug) [unique]
  }
}

Table Cost {
  id String [pk]
  projectId String [not null]
  costType CostType [not null]
  costName String
  referenceType CostReferenceType [not null]
  referenceId String [not null]
  amount Float [not null]
  currency String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]
  extraInfo Json
}

Table Topic {
  id String [pk]
  projectId String [not null]
  name String [not null]
  parentId String
  embeddings_model String [not null]
  centroid Json [not null]
  p95Distance Float [not null]
  automaticallyGenerated Boolean [default: true, not null]
  lastEventId String [note: '''The `topics_recorded` event that recorded this topic (its id in the
event log). Null means the row predates event ownership and has not
been seeded onto the stream yet; the projection sets it on every row
it writes.''']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]

  Note: '''PROJECTION of the topic-clustering event stream (ADR-051): topics are
`topics_recorded` events; this table is written ONLY by
TopicModelFoldProjection (cursor: TopicModelProjection) and is
rebuildable by replay. Kept named `Topic` because it is the domain
entity every surface reads — the `*Projection` suffix is reserved for
cursor/read-model tables.'''
}

Table Dataset {
  id String [pk]
  projectId String [not null]
  name String [not null]
  slug String [not null]
  columnTypes Json [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]
  archivedAt DateTime
  mapping Json
  useS3 Boolean [default: false, not null]
  s3RecordCount Int
  contentLayout String [default: 'postgres', not null]
  status String [default: 'ready', not null]
  statusError String
  stagingKey String
  sourceStoredObjectId String
  uploadFilename String
  rowCount Int
  sizeBytes BigInt
  chunkCount Int
  chunkOffsets Json

  indexes {
    (projectId, slug) [unique]
  }
}

Table DatasetRecord {
  id String [pk]
  datasetId String [not null]
  projectId String [not null]
  entry Json [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]
}

Table DatasetVersion {
  id String [pk]
  projectId String [not null]
  datasetId String [not null]
  version Int [not null]
  name String [note: 'A name given by hand; a named version is never thinned by retention.']
  trigger String [not null, note: '"autosave", "manual", "experiment_run", "restore" or "initial".']
  contentHash String [not null, note: 'SHA-256 over the columns and the rows in order; equal content saves no new version.']
  columnTypes Json [not null]
  rowCount Int [not null]
  sizeBytes BigInt [not null]
  chunkCount Int [not null]
  restoredFromVersion Int
  authorId String
  authorKind String [note: '"user", "api_key" or "system": who saved the version when authorId is null.']
  pinnedAt DateTime [note: 'Set when an experiment pins this version; a pinned version is never thinned.']
  createdAt DateTime [default: `now()`, not null]

  indexes {
    (datasetId, version) [unique]
  }

  Note: 'One immutable snapshot of a dataset\'s columns and rows; the rows are JSONL chunks in object storage.'
}

Table DatasetVersionRun {
  id String [pk]
  projectId String [not null]
  datasetId String [not null]
  versionId String [not null]
  runId String [not null]
  experimentId String
  createdAt DateTime [default: `now()`, not null]

  indexes {
    (projectId, runId, datasetId) [unique]
  }

  Note: 'An experiment run that read one dataset version; a version a run read is never thinned.'
}

Table Dashboard {
  id String [pk]
  projectId String [not null, note: 'The project that owns the board; only there can it be edited.']
  name String [not null]
  order Int [default: 0, not null, note: '''Legacy board sort position. The Dashboards v2 app orders boards by a
member\'s favourites and never writes this; kept because the legacy
Analytics reports section and the REST reorder endpoint still write it,
and a rolling deploy\'s older image still reads it.''']
  description String [note: '''Free text under the board\'s name; null until a member writes one.
Retiring: Dashboards v2 boards live in DashboardsV2, so no new write sets it.''']
  createdById String [note: '''The member who created it; null for boards that predate the column.
Retiring: Dashboards v2 boards live in DashboardsV2, so no new write sets it.''']
  scope DashboardScope [default: 'PROJECT', not null, note: '''Who sees it. Only the author changes it; a board with no author stays PROJECT.
Retiring: Dashboards v2 boards live in DashboardsV2, so no new write sets it.''']
  organizationId String [note: '''The owning project\'s organization, stamped when the board is first set to
ORGANIZATION; null before. No relation, per the database rule.
Retiring: Dashboards v2 boards live in DashboardsV2, so no new write sets it.''']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]
}

Table DashboardFavourite {
  id String [pk]
  userId String [not null]
  dashboardId String [note: '''A DashboardsV2 board\'s id (copied boards kept their Dashboard id); null when
the star is a template.''']
  templateId String [note: 'The starred From LangWatch template id; null when the star is a board.']
  projectId String [not null]
  position Int [not null, note: 'The member\'s drag order among their own stars in the project.']
  createdAt DateTime [default: `now()`, not null]

  indexes {
    (userId, dashboardId) [unique]
    (userId, projectId, templateId) [unique]
  }

  Note: '''A member\'s star, in their own order within a project: a board or a From
LangWatch template. Personal: one member\'s stars never show to another. No
foreign key (per the database rule): the dashboard service removes a board\'s
favourites when it deletes the board, so a star never outlives its dashboard.'''
}

Table DashboardsV2 {
  id String [pk]
  projectId String [not null, note: 'The project that owns the board; only there can it be edited.']
  name String [not null]
  description String [note: 'Free text under the board\'s name; null until a member writes one.']
  createdById String [note: 'The member who created it; null for boards that predate authorship.']
  scope DashboardScope [default: 'PROJECT', not null, note: 'Who sees it. Only the author changes it; a board with no author stays PROJECT.']
  organizationId String [note: '''The owning project\'s organization, stamped when the board is first set to
ORGANIZATION; null before.''']
  excludedOrigins Json [note: '''Deprecated: unused since each widget query names its own sources (dashboards-v2 AC200,
2026-10-28); dropped in a later migration, once no serving release reads it.''']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]

  Note: '''A Dashboards v2 board, apart from the Analytics Reports boards in Dashboard. Boards
made before the split were copied here with their ids, so stars and insight
pointers still name them. No relation, per the database rule.'''
}

Table DashboardWidget {
  id String [pk]
  projectId String [not null]
  dashboardId String [note: 'The DashboardsV2 board it sits on; null while unplaced.']
  name String [not null]
  definition Json [not null, note: 'The widget\'s srcdoc definition.']
  gridColumn Int [default: 0, not null]
  gridRow Int [default: 0, not null]
  colSpan Int [default: 1, not null]
  rowSpan Int [default: 1, not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]

  Note: '''A Dashboards v2 widget: a srcdoc definition placed on a DashboardsV2 board, or
unplaced. Widgets made before the split were copied from CustomGraph with their
ids. No relation, per the database rule.'''
}

Table InsightProjection {
  id String [pk, note: 'The insight id, which is also its aggregate id.']
  projectId String [not null]
  title String [not null]
  body String [not null]
  tone String [not null, note: 'bad | watch | good']
  topic String
  validDays Int [not null]
  lwql String
  sourceConversationId String
  sourceMessageId String
  filedByUserId String
  filedAt Float [not null]
  renewedAt Float [note: 'Set by a later run that found the insight still true.']
  createdAt Float [not null]
  updatedAt Float [not null]
  occurredAt Float [not null]
  acceptedAt Float [not null]
  lastEventId String [not null]
  projectionVersion String [not null]
  boardId String [note: '''The board and widget it came from. A pointer only, never a relation: the row reads the
same once either is deleted, so the names are kept as filed.''']
  boardName String
  widgetId String
  widgetName String
  filedVia String [default: 'chat', not null, note: 'chat | run']
  replayStart Float [note: 'The fixed window `lwql` replays over (epoch milliseconds, half-open) and its step.']
  replayEnd Float
  replayGranularitySeconds Int
  replayContext Json [note: 'The values in force when it was filed: `{ period, parameters }`.']
  ownerUserId String [note: '''Whose insight it is: the one person who reads it. NULL on a row folded before the
column existed, which is owned by whoever filed it (`filedByUserId`).''']
  findingKey String [note: '''The stable key a daily run matches a repeated finding by, so it renews the insight
and files no twin. NULL for an insight saved from a chat and on a row folded before
the column existed.''']

  Note: '''One insight in its owner\'s inbox in a project, folded from its `insight` aggregate
(modules/insight). A read model: rebuildable by replaying the event log. Epochs in
milliseconds.'''
}

Table InsightReaderProjection {
  id String [pk]
  projectId String [not null]
  insightId String [not null]
  userId String [not null]
  seenAt Float
  archivedAt Float
  keptAt Float
  createdAt Float [not null]
  updatedAt Float [not null]
  occurredAt Float [not null]
  acceptedAt Float [not null]
  lastEventId String [not null]
  projectionVersion String [not null]

  indexes {
    (projectId, insightId, userId) [unique]
  }

  Note: '''One reader\'s own state on one insight (seen, done, kept), folded from the same stream.
An insight has one reader today, its owner; a later forward may add more.'''
}

Table InsightDailyScheduleProjection {
  id String [pk, note: 'The schedule id, which is also its aggregate id: one per project, person and board.']
  projectId String [not null]
  userId String [not null]
  boardKind String [not null, note: 'dashboard | template. A pointer only, never a relation: a run checks the board is there.']
  boardId String [not null]
  boardName String [not null]
  state String [default: 'undecided', not null, note: 'on | off | undecided.']
  offReason String [note: '''board_deleted | skipped_days | member_removed | project_archived. Why the system turned
it off. NULL while it is on, and when the person turned it off.''']
  hour Int
  timezone String
  maxInsights Int
  lastRunId String [note: 'The last run that recorded an outcome. NULL until one did.']
  lastRunAt Float
  lastRunOutcome String [note: 'filed | nothing | failed | skipped']
  lastRunReason String
  lastRunFiled Int
  lastRunRenewed Int [note: 'How many insights the run found still true and renewed.']
  lastRunConversationId String
  consecutiveSkips Int [default: 0, not null, note: 'The scheduled days in a row whose run ended skipped, and the slot of the newest counted.']
  skipStreakSlot Float
  createdAt Float [not null]
  updatedAt Float [not null]
  occurredAt Float [not null]
  acceptedAt Float [not null]
  lastEventId String [not null]
  projectionVersion String [not null]

  indexes {
    (projectId, userId, boardKind, boardId) [unique]
  }

  Note: '''One person\'s daily insights run on one board in a project, folded from its
`insight_daily_schedule` aggregate (modules/insight). A read model: rebuildable by
replaying the event log. Epochs in milliseconds.'''
}

Table SavedView {
  id String [pk]
  projectId String [not null]
  userId String
  name String [not null]
  filters Json [default: '{}', not null]
  query String
  period Json
  order Int [default: 0, not null]
  kind String [default: 'v1-traces-filter', not null, note: '''Discriminator for the two storage shapes that share this table:
- "v1-traces-filter" (default) - legacy /messages page filter map saved views
- "v2-traces-lens"             - new traces v2 lens configs (columns, addons, grouping, sort, filterText) encoded inside `filters` JSON
Each client filters by its own kind on read so neither sees the other\'s rows.''']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]
}

Table CustomGraph {
  id String [pk]
  projectId String [not null]
  name String [not null]
  graph Json [not null, note: 'The chart\'s definition, in the shape its `kind` names.']
  filters Json
  kind String [default: 'builder', not null, note: '''Discriminator for the chart shapes that share this table:
- "builder" (default) - the chart builder\'s own `graph` payload
- "workbench_sql"     - a saved LangWatchQL workbench chart, whose
`graph` holds the versioned { sql, parameters, vegaLiteSpec }
definition (see server/analytics/saved-workbench-charts)
- "dashboard_srcdoc"  - frozen legacy copies of Dashboards v2 widgets, which
now live in DashboardWidget; nothing new writes this kind
Each reader filters by its own kind, so neither sees the other\'s rows and
a builder chart can never be interpreted as a workbench definition.''']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]
  dashboardId String
  gridColumn Int [default: 0, not null]
  gridRow Int [default: 0, not null]
  colSpan Int [default: 1, not null]
  rowSpan Int [default: 1, not null]
}

Table BatchEvaluation {
  id String [pk]
  experimentId String [not null]
  projectId String [not null]
  data Json [default: '{}', not null]
  status String [not null]
  score Float [not null]
  label String
  passed Boolean [not null]
  details String [not null]
  cost Float [not null]
  datasetSlug String [not null]
  datasetId String [not null]
  evaluation String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]
}

Table Trigger {
  id String [pk]
  name String [not null]
  projectId String [not null]
  action TriggerAction [not null]
  triggerKind TriggerKind [default: 'AUTOMATION', not null]
  actionParams Json [not null]
  filters Json [not null]
  filterQuery String
  lastRunAt Float [default: 0, not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]
  active Boolean [default: true, not null]
  pausedReason String
  pausedAt DateTime
  message String
  deleted Boolean [default: false, not null]
  alertType AlertType
  slackTemplateType String
  slackTemplate String
  emailSubjectTemplate String
  emailBodyTemplate String
  notificationCadence String [default: 'immediate', not null]
  traceDebounceMs Int [default: 30000, not null]
  customGraphId String [unique]
}

Table SlackIntegration {
  id String [pk]
  name String [not null]
  kind SlackIntegrationKind [not null]
  scopeType SlackIntegrationScopeType [not null]
  scopeId String [not null]
  organizationId String [not null]
  botTokenEncrypted String
  webhookUrlEncrypted String
  secretFingerprint String [not null]
  secretHint String [not null]
  slackTeamId String
  slackTeamName String
  createdById String [not null]
  updatedById String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]

  indexes {
    (organizationId, scopeType, scopeId, secretFingerprint) [unique]
  }

  Note: '''One named Slack connection (ADR-093 §5a); an organization holds as many as
it likes, each scoped to the organization or to one project. The secret is
AES-256-GCM ciphertext and never returned to a client. `secretFingerprint`
is an HMAC of the plaintext, so one secret is one connection per scope
without decrypting anything. No foreign key: `scopeId` is
polymorphic (ADR-021), as on RetentionPolicy and CustomLLMModelCost.'''
}

Table slack_connection_claim {
  connectionId String [not null]
  claimantId String [not null]
  claimantLabel String [not null]
  organizationId String [not null]
  projectId String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]

  indexes {
    (connectionId, claimantId) [pk]
  }

  Note: '''An automation holding a Slack connection in use (ARCHITECTURE.md §3, the
claims ruling): a claimed connection is never deleted. `projectId` is the
claimant\'s project; `organizationId` is the connection\'s tenancy anchor.
No foreign key: slack\'s service refuses to delete a claimed connection.'''
}

Table WebhookEndpoint {
  id String [pk]
  organizationId String [not null]
  destinationKind WebhookDestinationKind [default: 'http', not null, note: '''Where this endpoint delivers. Everything above the last hop is shared:
same batching, same retry ladder, same delivery log, same signature over
the same bytes.''']
  url String [note: '''The receiver URL. Present on `http` endpoints and null on the others;
the per-kind shape is pinned by a CHECK constraint Prisma cannot model.''']
  sqsQueueUrl String [note: '''The Amazon SQS queue this endpoint delivers to, on `sqs` endpoints. The
region and the owning account are read off it rather than configured
separately, so they can never disagree with the queue.''']
  sqsRoleArn String [note: '''The role we assume to write to the queue, and the ExternalId that proves
the request came from us rather than from anyone who learned the role\'s
name. The recommended credential mode.''']
  sqsExternalId String
  sqsAccessKeyId String [note: '''A static key pair for the queue, encrypted at rest exactly like the
signing secret. Both halves are present or both are absent: a half-filled
pair is what the AWS SDK reads as "we have credentials" and stops looking
with, so the CHECK constraint refuses it.''']
  sqsSecretAccessKeyEncrypted String
  secretEncrypted String [not null]
  signatureScheme String [note: '''How deliveries are formatted and signed. Null: the batch envelope signed
`t=,v1=`. `legacy_sha256`: one raw message per POST signed `sha256=`, kept
only for endpoints migrated from governance anomaly destinations.''']
  idempotencyKey String [note: '''Set only by governance\'s anomaly destination migration: a create that
repeats it in the same organization answers the endpoint it made. An
archived endpoint gives its key up, so a retry after cleanup creates anew.''']
  previousSecretEncrypted String [note: '''The secret this endpoint signed with before the last roll. Deliveries
carry a second `v1=` computed from it until it expires, so a receiver
swaps secrets on its own schedule instead of dropping deliveries in the
gap. Null once the window closes or if the secret was never rolled.''']
  previousSecretExpiresAt DateTime [note: 'When the previous secret stops being signed with and accepted.']
  enabledEvents String[] [not null]
  status WebhookEndpointStatus [default: 'ACTIVE', not null]
  disabledReason String [note: 'Why the endpoint is disabled: "auto_failures_72h" or "manual".']
  disabledAt DateTime
  failingSince DateTime [note: '''Start of the current consecutive-failure streak; cleared on any 2xx.
72 hours of unbroken failures from this instant auto-disables.''']
  maxBatchSize Int [default: 100, not null, note: '''Delivery controls, each server-bounded (see webhookDeliveryControls
constants): envelopes per POST, coalescing window before a partial
batch ships, and concurrent POSTs to this receiver.''']
  maxBatchDelayMs Int [default: 250, not null]
  maxInFlight Int [default: 4, not null]
  allowSelfSignedCertificate Boolean [default: false, not null, note: '''Self-hosted only: deliveries accept the receiver\'s self-signed TLS
certificate. Off by default; the hosted product ignores it.''']
  lastSuccessAt DateTime
  lastFailureAt DateTime
  archivedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]

  indexes {
    (organizationId, idempotencyKey) [unique]
  }

  Note: '''Org-anchored outbound webhook endpoint (the webhook platform, enterprise
only). The signing secret is AES-256-GCM encrypted at rest (shared
encrypt/decrypt, CREDENTIALS_SECRET) and returned in plaintext exactly
once, at create or roll time. `enabledEvents` holds registry event types
or family wildcards ("gateway.*", "*"). Failure-streak columns drive the
72h auto-disable. Spec: specs/webhooks/webhook-endpoints.feature.'''
}

Table WebhookEndpointDelivery {
  id String [pk]
  channel WebhookDeliveryChannel [default: 'platform', not null]
  organizationId String [note: 'Platform tenancy. Null on automations rows.']
  endpointId String
  projectId String [note: 'Automations tenancy. Null on platform rows.']
  triggerId String
  dispatchId String [not null]
  attempt Int [note: '''1-based attempt and the batch\'s envelope count. Both null on automations
rows, which record neither: one trigger fire is one event, and the
channel\'s sender does not thread its attempt number into the log.''']
  eventCount Int
  responseStatus Int
  latencyMs Int
  error String
  response Json
  outcome WebhookDeliveryOutcome [not null]
  firedAt DateTime [default: `now()`, not null]
  createdAt DateTime [default: `now()`, not null]

  Note: '''The per-ATTEMPT delivery log for BOTH webhook channels: the endpoints
platform\'s batches and the automations channel\'s trigger fires. One row per
HTTP attempt; `dispatchId` groups every attempt of one logical send (the
value of the X-LangWatch-Delivery-Id or X-LangWatch-Event-Id header). A slim
facts table: outcome, status, latency, a capped error message, and a
truncated copy of a failure response. Our request content (URL, headers,
body) is never stored. Pruned after 30 days.

The two channels used to keep separate tables with the same columns and two
prune implementations. They are one table with a discriminator now, so the
tenancy columns of the channel that did not write a row are null.'''
}

Table Experiment {
  id String [pk]
  name String
  type ExperimentType [not null]
  slug String [not null]
  projectId String [not null]
  workflowId String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]
  archivedAt DateTime
  workbenchState Json
  workbenchVersion Int [default: 0, not null]

  indexes {
    (projectId, slug) [unique]
  }
}

Table ExperimentVersion {
  id String [pk]
  experimentId String [not null]
  projectId String [not null]
  version Int [not null, note: '''The number the version is addressed and displayed by. Numbered rows hold
a gap-free sequence. The rolling autosave row rides on the counter
instead, which is what keeps it clear of that sequence.''']
  counterVersion Int [not null, note: '''`Experiment.workbenchVersion` at the moment this row was last written.
The rolling row is rewritten in place, so this is the only column that
says how recent its content is, and the version list sorts and pages by
it. It also joins a row to the live state: the row whose `counterVersion`
equals the experiment\'s counter holds what the workbench shows now.''']
  autoSaved Boolean [default: false, not null]
  commitMessage String
  authorId String
  authorLabel String [not null, note: 'Who wrote this version: "user", "langy" or "api".']
  runId String [note: '''The run that wrote this version, when a run wrote it.

A run writes its cells into the workbench state, which advances the
counter. Without this, the page that started that run reads the bump as
somebody else\'s write, refuses to save, and asks the reader to reload
over their own unsaved edits. Named here, the page adopts the version and
carries on.''']
  state Json [not null]
  schemaVersion String [default: '1', not null, note: 'Schema version of `state`, so a later shape change can be read forward.']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]

  indexes {
    (experimentId, version) [unique]
  }
}

Table Annotation {
  id String [pk]
  projectId String [not null]
  traceId String [not null]
  comment String
  isThumbsUp Boolean
  userId String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]
  email String
  scoreOptions Json
  expectedOutput String
  anchorKind String
  anchorId String
  anchorPath String
}

Table ModelProvider {
  id String [pk]
  name String [not null]
  provider String [not null]
  routingHandle String
  enabled Boolean [not null]
  customKeys Json
  extraHeaders Json
  customModels Json
  customEmbeddingsModels Json
  deploymentMapping Json
  rateLimitRpm Int
  rateLimitTpm Int
  rateLimitRpd Int
  rotationPolicy GatewayProviderRotationPolicy [default: 'MANUAL', not null]
  providerConfig Json
  fallbackPriorityGlobal Int
  langySkipPermissionsModels Json
  healthStatus GatewayProviderHealthStatus [default: 'UNKNOWN', not null]
  circuitOpenedAt DateTime
  lastHealthCheckAt DateTime
  disabledAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]
  organizationId String [not null]

  indexes {
    (organizationId, routingHandle) [unique]
  }
}

Table ModelProviderScope {
  id String [pk]
  modelProviderId String [not null]
  scopeType ModelProviderScopeType [not null]
  scopeId String [not null]
  createdAt DateTime [default: `now()`, not null]

  indexes {
    (modelProviderId, scopeType, scopeId) [unique]
  }
}

Table ModelDefaultConfig {
  id String [pk]
  config Json [not null]
  authorId String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  organizationId String [not null]
}

Table ModelDefaultConfigScope {
  id String [pk]
  configId String [not null]
  scopeType ModelDefaultScopeType [not null]
  scopeId String [not null]
  createdAt DateTime [default: `now()`, not null]

  indexes {
    (configId, scopeType, scopeId) [unique]
  }
}

Table GithubInstallation {
  id String [pk]
  installationId String [unique, not null, note: 'GitHub installation id (numeric; stored as string). Globally unique.']
  organizationId String [not null]
  accountLogin String [not null, note: 'The GitHub account (organization or user) the App is installed on.']
  accountType String [not null, note: '"Organization" or "User".']
  accountId String [not null, note: 'GitHub numeric account id (stable across renames).']
  repositorySelection String [not null, note: '''"all" or "selected" — whether the App can see every repo on the account
or only a chosen subset.''']
  repositories Json [note: '''Cached repository list [{ id, fullName }] when repositorySelection =
"selected". Null when "all" (the full set is resolved live at mint time).''']
  suspendedAt DateTime [note: '''Set when GitHub suspends the installation; cleared on unsuspend. A
suspended installation cannot mint tokens.''']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]

  Note: '''The organization\'s GitHub connection: a GitHub App installation mapped to a
LangWatch organization. Short-lived (1h) installation access tokens are
minted against these rows on demand, by Langy for writes (bot-authored pull
requests, scoped to the installation\'s repositories) and by pull-request
linkage for reads. No user token and no secret are stored here, the crown
jewel is the App private key, held only in the control-plane env.
Spec: specs/integrations/github-connection.feature.

installationId is globally unique (one GitHub installation, one row); a
single LangWatch organization may own MANY installations (different GitHub
accounts), so the org to installation relationship is one-to-many.'''
}

Table GithubPullRequest {
  id String [pk]
  organizationId String [not null]
  repositoryHost String [not null, note: 'The GitHub host the repository lives on, e.g. "github.com".']
  repositoryFullName String [not null, note: '''"owner/repo", stored LOWERCASED so a lookup matches whatever casing the
session reported.''']
  headBranch String [not null, note: 'The branch the pull request was opened from.']
  prNumber Int [not null]
  htmlUrl String [not null]
  title String [not null]
  state String [not null, note: 'GitHub\'s own state string: "open" or "closed".']
  isDraft Boolean [default: false, not null]
  authorLogin String
  prCreatedAt DateTime [not null]
  prClosedAt DateTime
  prMergedAt DateTime
  prUpdatedAt DateTime [note: '''GitHub\'s own `updated_at` for the snapshot this row holds, and the
freshness guard on every write to it: a snapshot older than the stored one
is skipped. GitHub may deliver webhooks out of order, and without the
guard a late `opened` lands after `closed` and reopens a merged pull
request. NULL means the row predates the column, so any write is accepted.''']
  mappedAt DateTime [default: `now()`, not null, note: 'When this row was first mapped to its branch.']
  lastCheckedAt DateTime [default: `now()`, not null, note: 'When the snapshot columns were last refreshed from GitHub.']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]

  indexes {
    (organizationId, repositoryHost, repositoryFullName, prNumber) [unique]
  }

  Note: '''A pull request discovered through the organization\'s GitHub connection and
mapped to the branch it was opened from, so a coding-agent session that
knows only its branch can name the pull request it produced.
Spec: specs/integrations/github-connection.feature.

The stored title, state, draft and timestamp columns are SNAPSHOTS taken
when the mapping was last refreshed. They are fallback labels only: the
frontend reads live status from GitHub, so a stale row never presents
itself as current truth.'''
}

Table GithubBranchPullRequestCheck {
  id String [pk]
  organizationId String [not null]
  repositoryHost String [not null]
  repositoryFullName String [not null, note: '"owner/repo", stored LOWERCASED, matching GithubPullRequest.']
  headBranch String [not null]
  lastCheckedAt DateTime [not null]
  prCount Int [default: 0, not null]
  notFoundAt DateTime [note: '''Set while the branch resolves to no pull request; cleared once one is
found.''']
  recheckAfter DateTime [note: 'The earliest instant GitHub may be asked about this branch again.']
  attempts Int [default: 0, not null, note: 'Consecutive lookups that found nothing, backing off the recheck.']
  lastRequestedAt DateTime [not null, note: '''When a reader last asked about this branch, whether or not GitHub was
called.''']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]

  indexes {
    (organizationId, repositoryHost, repositoryFullName, headBranch) [unique]
  }

  Note: '''The per-branch bookkeeping behind pull-request mapping: when a branch was
last looked up on GitHub, how many pull requests it resolved to, and when it
may be asked about again. A branch with no pull request is the common case,
so `notFoundAt` plus `recheckAfter` is what keeps an unmapped branch from
costing a GitHub call on every read.
Spec: specs/integrations/github-connection.feature.'''
}

Table LangyConversationProjection {
  id String [pk]
  projectId String [not null]
  conversationId String [not null]
  userId String [not null, note: 'Owner; first-writer-wins from the first message\'s userId.']
  title String
  titleSource LangyProjectionTitleSource [not null, note: 'derived | auto | user — governs auto-title precedence (user is sticky).']
  origin String [default: 'interactive', not null, note: '''Who started the conversation: `interactive` for the person in the panel, `run` for a
module acting for them with nobody at the keyboard. A row folded before the column
existed reads as interactive.''']
  status String [not null]
  isShared Boolean [default: false, not null]
  sharedAt Float
  sharedById String
  messageCount Int [default: 0, not null]
  lastActivityAt Float
  currentTurnId String [note: 'The turn in flight, or null when idle (busy guard reads this).']
  lastError String
  lastModel String [note: 'The model the latest accepted turn ran on; reopening seeds the picker from it.']
  pendingHandoffToken String [note: 'ADR-048 shutdown-handoff resume token (opaque, worker-authored).']
  pendingHandoffTurnId String
  runToken String [note: 'Per-conversation HMAC key for worker stream frames; server-side only.']
  archivedAt Float
  createdAt Float [not null]
  updatedAt Float [not null]
  occurredAt Float [not null, note: 'Business time of the latest applied event.']
  acceptedAt Float [not null, note: 'Event-log acceptance time. Together with lastEventId this is the cursor.']
  lastEventId String [not null]
  projectionVersion String [not null]

  indexes {
    (projectId, conversationId) [unique]
  }

  Note: '''Rebuildable operational state folded from Langy\'s canonical event stream.
The source of truth remains the ClickHouse event log.'''
}

Table LangyTurnRequest {
  id String [pk]
  projectId String [not null]
  userId String [not null]
  requestId String [not null]
  conversationId String [not null]
  turnId String [not null]
  status String [not null]
  leaseOwner String [not null]
  leaseExpiresAt DateTime [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]

  indexes {
    (projectId, userId, requestId) [unique]
  }

  Note: '''Durable idempotency receipt for one logical Langy send. A transport retry
reuses the same requestId and receives the original conversation/turn ids
instead of minting a second message or turn.'''
}

Table LangyActiveTurn {
  id String [pk]
  projectId String [not null]
  conversationId String [not null]
  turnId String [not null]
  requestId String [not null]
  userId String [not null]
  status String [not null]
  leaseOwner String [not null]
  leaseExpiresAt DateTime [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]

  indexes {
    (projectId, conversationId) [unique]
  }

  Note: '''Postgres-authoritative one-turn admission for a conversation. PREPARING
claims are leased so a crash before the durable start event can recover;
COMMITTED claims are released only by the matching terminal event.'''
}

Table LangyConversationTurnProjection {
  id String [pk]
  projectId String [not null]
  conversationId String [not null]
  turnId String [not null]
  status String [not null, note: '''LangyConversationTurnStatus. Deliberately TEXT, not a Postgres enum: this
is a PROJECTION — one writer (the fold), rebuildable from the event log,
and nothing queries or indexes on it. An enum bought no selectivity here,
only typo protection, and charged a migration for every new status that
Postgres then could not remove. The one definition lives in
`LANGY_CONVERSATION_TURN_STATUS`; the repository validates against it.''']
  questionParts Json [not null, note: 'LangyMessagePart[] — the user question that opened the turn.']
  answerParts Json [not null, note: 'LangyMessagePart[] — the agent\'s whole final answer.']
  toolCalls Json [not null, note: 'LangyTurnToolCall[] — tool-call lifecycle audit in initiation order.']
  plan Json [note: 'LangyPlanItemData[] | null — null means the turn never kept a plan.']
  error String
  startedAt Float
  endedAt Float
  createdAt Float [not null]
  updatedAt Float [not null]
  occurredAt Float [not null]
  acceptedAt Float [not null]
  lastEventId String [not null]
  projectionVersion String [not null]

  indexes {
    (projectId, conversationId, turnId) [unique]
  }

  Note: 'Rebuildable per-turn operational render document.'
}

Table LangyMessageProjection {
  id String [pk]
  projectId String [not null]
  conversationId String [not null]
  messageId String [not null]
  role String [not null]
  parts Json [not null]
  sourceEventId String [not null]
  occurredAt Float [not null]
  acceptedAt Float [not null]
  createdAt Float [not null]
  updatedAt Float [not null]

  indexes {
    (projectId, conversationId, messageId) [unique]
    (projectId, sourceEventId) [unique]
  }

  Note: 'Rebuildable operational message fact. One source event produces one row.'
}

