Table Subscription {
  id String [pk]
  organizationId String [not null]
  plan PlanTypes [not null]
  stripeSubscriptionId String [unique]
  status SubscriptionStatus [not null]
  startDate DateTime
  endDate DateTime
  lastPaymentFailedDate DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]
  maxMembers Int
  maxProjects Int
  maxMessagesPerMonth Int
  maxWorkflows Int
  maxRetentionDays Int
  maxMembersLite Int
  maxMembersDeveloper Int [note: 'Developer seats the organization pays for; null falls to the plan\'s own cap.']
  maxTeams Int
  maxPrompts Int
  maxEvaluators Int
  maxScenarios Int
  maxAgents Int
  maxExperiments Int
  maxOnlineEvaluations Int
  maxDatasets Int
  maxDashboards Int
  maxCustomGraphs Int
  maxAutomations Int
  seatsKept Int [note: 'Seats paid for this period that stay usable after a seat decrease, until seatsKeptUntil.']
  seatsKeptUntil DateTime
  seatLineQuantity Int [note: 'The seat quantity the last finished seat change set the seat line to; provider events never write it.']
  seatLineQuantityAt DateTime
  seatLineWriteQuantities Int[] [not null, note: '''A Stripe seat line write recorded before it is sent and cleared once it is known to have
finished under the lease; one left behind is settled by the seat line repair.
Every seat quantity written while this record was pending.''']
  seatLineWriteSince DateTime [note: 'The first write still pending; a later holder\'s write keeps it.']
  seatLineWriteAt DateTime [note: 'The latest write sent; the repair waits a grace window after it.']
  seatLineWriteAttempts Int
  seatLineWriteFlaggedAt DateTime
  seatRepairQuantity Int [note: 'The seat quantity Stripe should bill if a seat change stops after lifting the seat line; null once settled.']
  seatRepairLiftedQuantity Int [note: 'The quantity the change lifted the line to; the repair moves the line back only while Stripe still bills it.']
  seatRepairSince DateTime
  seatRepairAttempts Int
