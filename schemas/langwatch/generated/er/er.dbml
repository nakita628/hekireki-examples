  snapshot Json [not null, note: '''Envelope { schemaVersion, fields, changedFields } holding the editable
field set as saved and the names of the fields this save changed.''']
  schemaVersion Int [default: 1, not null, note: 'Schema version of `snapshot`, so a later shape change can be read forward.']
