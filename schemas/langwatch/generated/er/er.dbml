  codingActiveDays Int [default: 0, not null]
  codingLastActiveDay String
  codingTerminalTypes String[] [not null]
  codingRepositoryKeys String[] [not null]
  codingFirstDays Int[] [not null]
  lastTraceAt DateTime
  updatedAt DateTime [not null]

  Note: '''Nurturing\'s read model per organization: its admin and its milestone counts.
`seeded` marks an organization learned from the project backfill: its first_* already happened.'''
}

Table NurturingProjectUsageView {
  projectId String [not null]
  owner String [not null, note: '''The owner pipeline whose peer fold wrote the row (prompt, evaluator, scenario, simulation),
or `evaluation`: the project\'s evaluation days, written by a subscriber, at most once a day.''']
  folded Json [not null, note: 'The project\'s usage as the fold folded it (NurturingProjectUsageState).']
  appliedEventIds String[] [not null, note: 'The event ids of the last delivery folded in, so a redelivery folds once.']
  projectionVersion String [not null, note: 'A row of another version reads as undecodable and is re-folded from the log.']
  updatedAt DateTime [not null, note: 'Event-derived, so a replayed row equals the row it rebuilds.']

  indexes {
    (projectId, owner) [pk]
  }

  Note: '''Nurturing\'s own per-project usage: a peer fold over the owners\' prompt, evaluator, scenario
and simulation-run events (ARCHITECTURE §9), one peer fold per owner pipeline, summed per
organization for the per-email traits. Traces are counted in NurturingProjectTraceDay.'''
}

Table NurturingProjectTraceDay {
  projectId String [not null]
  day String [not null, note: 'UTC `YYYY-MM-DD` of the root spans\' append time.']
  traceCount Int [default: 0, not null]
  errorCount Int [default: 0, not null, note: 'Traces trace recorded failed (lw.trace.trace_failed).']
  lastTraceAt DateTime [note: 'Append time of the newest root span.']
  lastFailedTraceAt DateTime [note: 'Append time of the newest trace_failed.']

  indexes {
    (projectId, day) [pk]
  }

  Note: '''Nurturing\'s own trace counts from trace\'s span_received and trace_failed (ARCHITECTURE §9), a
root span being one trace, one row per project and UTC day of append time, incremented in place
by each batch. A redelivered batch can count a trace twice; accepted (issue 9378). Kept 30 days.'''
}

Table NurturingPersonalProject {
  projectId String [pk]
