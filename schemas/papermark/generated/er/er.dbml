  indexes {
    (questionId, linkId) [unique]
    (questionId, groupId) [unique]
    (questionId, viewerId) [unique]
    (questionId, email) [unique]
  }
}

Table ConversationParticipant {
  id String [pk]
  conversationId String [not null]
  role ParticipantRole [default: 'PARTICIPANT', not null]
  viewerId String
  userId String
  receiveNotifications Boolean [default: false, not null]
  createdAt DateTime [default: `now()`, not null]

  indexes {
    (conversationId, viewerId) [unique]
    (conversationId, userId) [unique]
  }
}

Table Message {
  id String [pk]
  content String [not null]
  conversationId String [not null]
