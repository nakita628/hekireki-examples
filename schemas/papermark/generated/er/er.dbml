}

Table Link {
  id String [pk]
  documentId String
  dataroomId String
  linkType LinkType [default: 'DOCUMENT_LINK', not null]
  url String [unique]
  name String
  slug String
  expiresAt DateTime
  password String
  allowList String[] [not null]
  denyList String[] [not null]
  emailProtected Boolean [default: true, not null]
  emailAuthenticated Boolean [default: false, not null]
  allowDownload Boolean [default: false]
  isArchived Boolean [default: false, not null]
  deletedAt DateTime
  domainId String
  domainSlug String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  enableNotification Boolean [default: true]
  enableFeedback Boolean [default: false]
  enableQuestion Boolean [default: false]
  enableScreenshotProtection Boolean [default: false]
  enableConfidentialView Boolean [default: false]
  enableAgreement Boolean [default: false]
  agreementId String
  showBanner Boolean [default: false]
  enableWatermark Boolean [default: false]
  watermarkConfig Json
  audienceType LinkAudienceType [default: 'GENERAL', not null]
  groupId String
  permissionGroupId String
  metaTitle String
  metaDescription String
  metaImage String
  metaFavicon String
  enableCustomMetatag Boolean [default: false]
  welcomeMessage String
  enableConversation Boolean [default: false, not null]
  enableAIAgents Boolean [default: false]
  enableUpload Boolean [default: false]
  isFileRequestOnly Boolean [default: false]
  uploadFolderId String [note: '''Deprecated: replaced by `uploadFolderIds`. Retained in the DB only so old
rows can be inspected; no application code reads or writes this column.''']
  uploadFolderIds String[] [not null]
  enableIndexFile Boolean [default: false]
  teamId String
  brandId String
  ownerId String

  indexes {
    (domainSlug, slug) [unique]
  }
}

