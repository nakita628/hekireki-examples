  defaultShowBanner Boolean [default: true, not null]
  defaultGroupPermissionStrategy DefaultPermissionStrategy [default: 'INHERIT_FROM_PARENT', not null]
  defaultRootItemAccess RootItemAccess [default: 'VIEW_ONLY', not null]
  defaultGroupRootItemAccess RootItemAccess [default: 'VIEW_ONLY', not null]
  allowBulkDownload Boolean [default: true, not null]
  showLastUpdated Boolean [default: true, not null]
  introductionEnabled Boolean [default: false, not null]
  introductionContent Json
  isFrozen Boolean [default: false, not null]
  frozenAt DateTime
