  contactId String
  plan String [default: 'free', not null]
  stripeId String [unique]
  subscriptionId String [unique]
  startsAt DateTime
  endsAt DateTime
  referralTrack ReferralTrack
  referralTrackSelectedAt DateTime
  referralProfile Json
}

Table VerificationToken {
  identifier String [not null]
  token String [unique, not null]
  expires DateTime [not null]

  indexes {
    (identifier, token) [unique]
  }
}

Table Domain {
  id String [pk]
  slug String [unique, not null]
  userId String
  teamId String [not null]
  verified Boolean [default: false, not null]
  isDefault Boolean [default: false, not null]
  redirectUrl String
  lastChecked DateTime [default: `now()`, not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table View {
  id String [pk]
  linkId String [not null]
  documentId String
  dataroomId String
  dataroomViewId String
  viewerEmail String
  viewerName String
  verified Boolean [default: false, not null]
  viewedAt DateTime [default: `now()`, not null]
  downloadedAt DateTime
  downloadType DownloadType
  downloadMetadata Json
  viewType ViewType [default: 'DOCUMENT_VIEW', not null]
  viewerId String
  groupId String
  isArchived Boolean [default: false, not null]
  teamId String
}

Table Viewer {
  id String [pk]
  email String [not null]
  verified Boolean [default: false, not null]
  invitedAt DateTime
  notificationPreferences Json
  dataroomId String
  teamId String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (teamId, email) [unique]
  }
}

Table Reaction {
  id String [pk]
  viewId String [not null]
  pageNumber Int [not null]
  type String [not null]
  createdAt DateTime [default: `now()`, not null]
}

Table Invitation {
  email String [not null]
  expires DateTime [not null]
  teamId String [not null]
  createdAt DateTime [default: `now()`, not null]
  token String [unique, not null]
  role Role [default: 'MEMBER', not null]
  dataroomIds String[] [not null]

  indexes {
    (email, teamId) [unique]
  }
}

Table SentEmail {
  id String [pk]
  type EmailType [not null]
  recipient String [not null]
  marketing Boolean [default: false, not null]
  createdAt DateTime [default: `now()`, not null]
  teamId String [not null]
  domainSlug String
}

Table Chat {
  id String [pk]
  title String
  teamId String [not null]
  documentId String
  dataroomId String
  linkId String
  viewId String
  userId String
  viewerId String
  vectorStoreId String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  lastMessageAt DateTime
}

Table ChatMessage {
  id String [pk]
  chatId String [not null]
  role String [not null]
  content String [not null]
  metadata Json
  createdAt DateTime [default: `now()`, not null]
}

Table Feedback {
  id String [pk]
  linkId String [unique, not null]
  data Json [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table FeedbackResponse {
  id String [pk]
  feedbackId String [not null]
  data Json [not null]
  viewId String [unique, not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table Agreement {
  id String [pk]
  name String [not null]
  content String [not null]
  contentType String [default: 'LINK', not null]
  signingProvider String [default: 'LEGACY', not null]
  signingExternalId String [unique]
  signingEnvelopeId String
  signingTemplateId String
  requireName Boolean [default: true, not null]
  teamId String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  deletedAt DateTime
  deletedBy String
}

Table AgreementResponse {
  id String [pk]
  agreementId String [not null]
  viewId String [unique]
  linkId String
  signerEmail String
  signerName String
  signingStatus String [default: 'PENDING', not null]
  signingExternalId String [unique]
  signingEnvelopeId String
  signingDocumentId Int
  signedAt DateTime
  completedAt DateTime
  signedFileKey String
  signedFileName String
  signedFileStorageType DocumentStorageType
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table IncomingWebhook {
  id String [pk]
  externalId String [unique, not null]
  name String [not null]
  secret String
  source String
  actions String
  consecutiveFailures Int [default: 0, not null]
  lastFailedAt DateTime
  disabledAt DateTime
  teamId String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table RestrictedToken {
  id String [pk]
  name String [not null]
  hashedKey String [unique, not null]
  partialKey String [not null]
  scopes String
  mode String [default: 'live', not null]
  source String [default: 'dashboard', not null]
  subjectType String [default: 'user', not null]
  clientId String
  expires DateTime
  lastUsed DateTime
  rateLimit Int [default: 60, not null]
  userId String [not null]
  teamId String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table Webhook {
  id String [pk]
  pId String [unique, not null]
  name String [not null]
  url String [not null]
  secret String [not null]
  triggers Json [not null]
  teamId String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table YearInReview {
  id String [pk]
  teamId String [not null]
  status String [default: 'pending', not null]
  attempts Int [default: 0, not null]
  lastAttempted DateTime
  error String
  stats Json [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table Tag {
  id String [pk]
  name String [not null]
  color String [not null]
  description String
  teamId String [not null]
  createdBy String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (teamId, name) [unique]
  }
}

Table TagItem {
  id String [pk]
  tagId String [not null]
  itemType TagType [not null]
  linkId String
  documentId String
  dataroomId String
  taggedBy String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table ViewerInvitation {
  id String [pk]
  viewerId String [not null]
  linkId String [not null]
  groupId String
  invitedBy String [not null]
  customMessage String
  sentAt DateTime [default: `now()`, not null]
  status InvitationStatus [default: 'SENT', not null]
  createdAt DateTime [default: `now()`, not null]
}

Table Team {
  id String [pk]
  name String [not null]
  slug String [unique]
  defaultBrandId String
  plan String [default: 'free', not null]
  stripeId String [unique]
  subscriptionId String [unique]
  startsAt DateTime
  endsAt DateTime
  pausedAt DateTime
  pauseStartsAt DateTime
  pauseEndsAt DateTime
  cancelledAt DateTime
  trialStartedAt DateTime
  trialEndsAt DateTime
  trialReminderRunId String
  trialExpiredRunId String
  limits Json
  enableExcelAdvancedMode Boolean [default: false, not null]
  replicateDataroomFolders Boolean [default: true, not null]
  timezone String [default: 'Etc/UTC', not null]
  ssoEnabled Boolean [default: false, not null]
  ssoEmailDomain String [unique]
  ssoEnforcedAt DateTime
  surveyData Json
  agentsEnabled Boolean [default: false, not null]
  vectorStoreId String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  ignoredDomains String[] [not null]
  globalBlockList String[] [not null]
  referralTrack ReferralTrack
  referralTrackSelectedAt DateTime
  referralProfile Json
}

Table UserDataroom {
  userId String [not null]
  teamId String [not null]
  dataroomId String [not null]
  createdAt DateTime [default: `now()`, not null]

  indexes {
    (userId, dataroomId) [pk]
  }
}

Table UserTeam {
  role Role [default: 'MEMBER', not null]
  status String [default: 'ACTIVE', not null]
  userId String [not null]
  teamId String [not null]
  blockedAt DateTime
  notificationPreferences Json

  indexes {
    (userId, teamId) [pk]
  }
}

Table Workflow {
  id String [pk]
  name String [not null]
  description String
  entryLinkId String [unique, not null]
  teamId String [not null]
  isActive Boolean [default: true, not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table WorkflowStep {
  id String [pk]
  workflowId String [not null]
  name String [not null]
  stepOrder Int [not null]
  stepType WorkflowStepType [default: 'ROUTER', not null]
  conditions Json [not null]
  actions Json [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (workflowId, stepOrder) [unique]
  }
}

Table WorkflowExecution {
  id String [pk]
  workflowId String [not null]
  visitorEmail String
  visitorIp String
  status ExecutionStatus [not null]
  startedAt DateTime [default: `now()`, not null]
  completedAt DateTime
  result Json
  metadata Json
}

Table WorkflowStepLog {
  id String [pk]
  executionId String [not null]
  workflowStepId String [not null]
  conditionsMatched Boolean [not null]
  conditionResults Json
  actionsExecuted Json
  executedAt DateTime [default: `now()`, not null]
  duration Int
  error String
}

