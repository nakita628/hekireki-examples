Enum ConversationVisibility {
  PRIVATE
  PUBLIC_LINK
  PUBLIC_GROUP
  PUBLIC_DOCUMENT
  PUBLIC_DATAROOM
}

Enum ParticipantRole {
  OWNER
  PARTICIPANT
}

Enum FaqVisibility {
  PUBLIC_DATAROOM
  PUBLIC_LINK
  PUBLIC_DOCUMENT
}

Enum FaqStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

Enum ItemType {
  DATAROOM_DOCUMENT
  DATAROOM_FOLDER
}

Enum DefaultPermissionStrategy {
  INHERIT_FROM_PARENT
  ASK_EVERY_TIME
  HIDDEN_BY_DEFAULT
}

Enum RootItemAccess {
  VIEW_ONLY
  VIEW_AND_DOWNLOAD
  HIDDEN
}

Enum DocumentStorageType {
  S3_PATH
  VERCEL_BLOB
}

Enum LinkType {
  DOCUMENT_LINK
  DATAROOM_LINK
  WORKFLOW_LINK
}

Enum LinkAudienceType {
  GENERAL
  GROUP
  TEAM
}

Enum CustomFieldType {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  PHONE_NUMBER
  URL
  CHECKBOX
  SELECT
  MULTI_SELECT
}

Enum ReferralTrack {
  AFFILIATE
  PARTNER_DISCOUNT
}

Enum ViewType {
  DOCUMENT_VIEW
  DATAROOM_VIEW
}

Enum DownloadType {
  SINGLE
  BULK
  FOLDER
}

Enum EmailType {
  FIRST_DAY_DOMAIN_REMINDER_EMAIL
  FIRST_DOMAIN_INVALID_EMAIL
  SECOND_DOMAIN_INVALID_EMAIL
  FIRST_TRIAL_END_REMINDER_EMAIL
  FINAL_TRIAL_END_REMINDER_EMAIL
}

Enum TagType {
  LINK_TAG
  DOCUMENT_TAG
  DATAROOM_TAG
}

Enum InvitationStatus {
  SENT
  FAILED
  BOUNCED
}

Enum Role {
  ADMIN
  MANAGER
  MEMBER
  DATAROOM_MEMBER
}

Enum WorkflowStepType {
  ROUTER
}

Enum ExecutionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  BLOCKED
}

Table DocumentAnnotation {
  id String [pk]
  title String [not null]
  content Json [not null]
  pages Int[] [not null]
  documentId String [not null]
  teamId String [not null]
  createdById String [not null]
  isVisible Boolean [default: true, not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table AnnotationImage {
  id String [pk]
  filename String [not null]
  url String [not null]
  size Int
  mimeType String
  annotationId String [not null]
  createdAt DateTime [default: `now()`, not null]
}

Table Brand {
  id String [pk]
  logo String
  hideLogo Boolean [default: false, not null]
  banner String
  brandColor String
  accentColor String
  accentButtonColor String
  applyAccentColorToDataroomView Boolean [default: false, not null]
  welcomeMessage String
  ctaLabel String
  ctaUrl String
  privacyPolicyUrl String
  cardLayout String [default: 'LIST', not null]
  showFolderTree Boolean [default: true, not null]
  viewerLayoutPreset String [default: 'STANDARD', not null]
  viewerHeaderStyle String [default: 'DEFAULT', not null]
  hideFolderIconsInMain Boolean [default: false, not null]
  customLinkPreviewEnabled Boolean [default: false, not null]
  linkPreviewTitle String
  linkPreviewDescription String
  linkPreviewImage String
  linkPreviewFavicon String
  defaultLanguage String [default: 'en', not null]
  name String [default: 'Default', not null]
  teamId String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (teamId, name) [unique]
  }
}

Table Conversation {
  id String [pk]
  title String
  isEnabled Boolean [default: true, not null]
  visibilityMode ConversationVisibility [default: 'PRIVATE', not null]
  dataroomId String [not null]
  dataroomDocumentId String
  documentVersionNumber Int
  documentPageNumber Int
  linkId String
  viewerGroupId String
  questionId String
  origin String [default: 'visitor', not null]
  category String
  priority String
  recipientViewerId String
  initialViewId String
  teamId String [not null]
  lastMessageAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (questionId, recipientViewerId) [unique]
  }
}

Table DataroomQuestion {
  id String [pk]
  content String [not null]
  category String
  priority String
  status String [default: 'unanswered', not null]
  orderIndex Int
  importBatchId String
  dataroomId String [not null]
  teamId String [not null]
  createdByUserId String
  dataroomDocumentId String
  documentPageNumber Int
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table DataroomQuestionAssignment {
  id String [pk]
  questionId String [not null]
  linkId String
  groupId String
  viewerId String
  email String
