  emailRateLimits Json [not null, note: '[RateLimitArray] @zod.custom.use(ZRateLimitArraySchema)']
  emailQuota Int
  apiRateLimits Json [not null, note: '[RateLimitArray] @zod.custom.use(ZRateLimitArraySchema)']
  apiQuota Int
  emailTransportId String

  Note: '@zod.import(["import { ZClaimFlagsSchema, ZRateLimitArraySchema } from \'@documenso/lib/types/subscription\';"])'
}

Table OrganisationMonthlyStat {
  id String [pk]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  organisationId String [not null]
  period String [not null, note: 'UTC calendar month in `YYYY-MM` form, e.g. "2026-05".']
  documentCount Int [default: 0, not null]
  emailCount Int [default: 0, not null]
  apiCount Int [default: 0, not null]
  emailReports Int [default: 0, not null]

  indexes {
    (organisationId, period) [unique]
  }
}

Table Account {
  id String [pk]
  createdAt DateTime [default: `now()`, not null]
  userId Int [not null]
  type String [not null]
  provider String [not null]
  providerAccountId String [not null]
  refresh_token String
  access_token String
  expires_at Int
  created_at Int
  ext_expires_in Int
  token_type String
  scope String
  id_token String
  session_state String
  password String

  indexes {
    (provider, providerAccountId) [unique]
  }
}

Table Session {
  id String [pk]
  sessionToken String [unique, not null]
  userId Int [not null]
  ipAddress String
  userAgent String
  expiresAt DateTime [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  isEmbed Boolean [default: false, not null]
}

Table AuthHandoff {
  id String [pk]
  type String [not null]
