  Note: '@zod.import(["import { ZDocumentEmailSettingsSchema } from \'@documenso/lib/types/document-email\';", "import { ZDefaultRecipientsSchema } from \'@documenso/lib/types/default-recipients\';", "import { ZEnvelopeExpirationPeriod as ZEnvelopeExpirationPeriodSchema } from \'@documenso/lib/constants/envelope-expiration\';", "import { ZEnvelopeReminderSettings as ZEnvelopeReminderSettingsSchema } from \'@documenso/lib/constants/envelope-reminder\';", "import { ZCssVarsSchema } from \'@documenso/lib/types/css-vars\';"])'
}

