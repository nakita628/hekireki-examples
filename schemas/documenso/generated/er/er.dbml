  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]
  visibility DocumentVisibility [default: 'EVERYONE', not null]
  type FolderType [not null]
}

Table Envelope {
  id String [pk]
  secondaryId String [unique, not null]
  externalId String [note: '@zod.string.describe("A custom external ID you can use to identify the document.")']
  type EnvelopeType [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  completedAt DateTime
  deletedAt DateTime
  title String [not null]
  status DocumentStatus [default: 'DRAFT', not null]
  source DocumentSource [not null]
  qrToken String [note: '@zod.string.describe("The token for viewing the document using the QR code on the certificate.")']
  signatureLevel String [not null, note: '[SignatureLevel] @zod.custom.use(ZSignatureLevelSchema)']
  internalVersion Int [not null]
  useLegacyFieldInsertion Boolean [default: false, not null]
  authOptions Json [note: '[DocumentAuthOptions] @zod.custom.use(ZDocumentAuthOptionsSchema)']
  formValues Json [note: '[DocumentFormValues] @zod.custom.use(ZDocumentFormValuesSchema)']
  visibility DocumentVisibility [default: 'EVERYONE', not null]
  templateType TemplateType [default: 'PRIVATE', not null]
  publicTitle String [default: '', not null]
  publicDescription String [default: '', not null]
  templateId Int
  userId Int [not null, note: '@zod.number.describe("The ID of the user that created this document.")']
  teamId Int [not null]
  folderId String
  documentMetaId String [unique, not null]

  Note: '@zod.import(["import { ZDocumentAuthOptionsSchema } from \'@documenso/lib/types/document-auth\';", "import { ZDocumentFormValuesSchema } from \'@documenso/lib/types/document-form-values\';", "import { ZSignatureLevelSchema } from \'@documenso/lib/types/signature-level\';"])'
}

Table EnvelopeItem {
  id String [pk]
  title String [not null]
  order Int [not null]
  documentDataId String [unique, not null]
  envelopeId String [not null]
}

Table DocumentAuditLog {
  id String [pk]
  envelopeId String
  createdAt DateTime [default: `now()`, not null]
  type String [not null]
  data Json [not null]
  name String
  email String
  userId Int
  userAgent String
  ipAddress String
}

Table DocumentData {
  id String [pk]
  type DocumentDataType [not null]
  data String [not null]
  initialData String [not null]
}

Table DocumentMeta {
  id String [pk]
  subject String
  message String
  timezone String [default: 'Etc/UTC']
  dateFormat String [default: 'yyyy-MM-dd hh:mm a']
  redirectUrl String
  signingOrder DocumentSigningOrder [default: 'PARALLEL', not null]
  allowDictateNextSigner Boolean [default: false, not null]
  typedSignatureEnabled Boolean [default: true, not null]
  uploadSignatureEnabled Boolean [default: true, not null]
  drawSignatureEnabled Boolean [default: true, not null]
  language String [default: 'en', not null]
  distributionMethod DocumentDistributionMethod [default: 'EMAIL', not null]
  emailSettings Json [note: '[DocumentEmailSettings] @zod.custom.use(ZDocumentEmailSettingsSchema)']
  emailReplyTo String
  emailId String
  envelopeExpirationPeriod Json [note: '[EnvelopeExpirationPeriod] @zod.custom.use(ZEnvelopeExpirationPeriodSchema)']
  reminderSettings Json [note: '[EnvelopeReminderSettings] @zod.custom.use(ZEnvelopeReminderSettingsSchema)']

  Note: '@zod.import(["import { ZDocumentEmailSettingsSchema } from \'@documenso/lib/types/document-email\';", "import { ZEnvelopeExpirationPeriod as ZEnvelopeExpirationPeriodSchema } from \'@documenso/lib/constants/envelope-expiration\';", "import { ZEnvelopeReminderSettings as ZEnvelopeReminderSettingsSchema } from \'@documenso/lib/constants/envelope-reminder\';"])'
}

Table EnvelopeAttachment {
  id String [pk]
  type String [not null, note: '[EnvelopeAttachmentType] @zod.custom.use(ZEnvelopeAttachmentTypeSchema)']
  label String [not null]
  data String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  envelopeId String [not null]

  Note: '@zod.import(["import { ZEnvelopeAttachmentTypeSchema } from \'@documenso/lib/types/envelope-attachment\';"])'
}

Table Recipient {
  id Int [pk, increment]
  envelopeId String [not null]
  email String [not null]
  name String [default: '', not null]
  token String [not null]
  documentDeletedAt DateTime
  expired DateTime
  expiresAt DateTime
  expirationNotifiedAt DateTime
  sentAt DateTime
  signedAt DateTime
  lastReminderSentAt DateTime
  nextReminderAt DateTime
  reminderCount Int [default: 0, not null]
  authOptions Json [note: '[RecipientAuthOptions] @zod.custom.use(ZRecipientAuthOptionsSchema)']
  signingOrder Int [note: '@zod.number.describe("The order in which the recipient should sign the document. Only works if the document is set to sequential signing.")']
  rejectionReason String
  role RecipientRole [default: 'SIGNER', not null]
  readStatus ReadStatus [default: 'NOT_OPENED', not null]
  signingStatus SigningStatus [default: 'NOT_SIGNED', not null]
  sendStatus SendStatus [default: 'NOT_SENT', not null]

  Note: '@zod.import(["import { ZRecipientAuthOptionsSchema } from \'@documenso/lib/types/document-auth\';"])'
}

Table Field {
  id Int [pk, increment]
  secondaryId String [unique, not null]
  envelopeId String [not null]
  envelopeItemId String [not null]
  recipientId Int [not null]
  type FieldType [not null]
  page Int [not null, note: '@zod.number.describe("The page number of the field on the document. Starts from 1.")']
  positionX Decimal [default: 0, not null]
  positionY Decimal [default: 0, not null]
  width Decimal [default: -1, not null]
  height Decimal [default: -1, not null]
  customText String [not null]
  inserted Boolean [not null]
  fieldMeta Json [note: '[FieldMeta] @zod.custom.use(ZFieldMetaNotOptionalSchema)']

  Note: '@zod.import(["import { ZFieldMetaNotOptionalSchema } from \'@documenso/lib/types/field-meta\';"])'
}

Table Signature {
  id Int [pk, increment]
  created DateTime [default: `now()`, not null]
  recipientId Int [not null]
  fieldId Int [unique, not null]
  signatureImageAsBase64 String
  typedSignature String
}

Table CscCredential {
  id String [pk]
  providerId String [not null]
  credentialId String [not null]
  certCache Bytes [note: '''TSP-validated certificate chain (length-prefixed). Nullable until the
service-scope OAuth callback successfully retrieves and validates it.''']
  signatureAlgorithm String [not null, note: '''Algorithm metadata derived from the CSC `credentials/info` response.
Held as flat scalars so each is independently queryable.''']
  keyType String [not null]
  digestAlgorithm String [not null]
  keyLenBits Int
  signAlgoParams String
  serviceTokenCiphertext Bytes [note: '''Service-scope access token, symmetric-encrypted at the application layer
before persistence. Nullable until the service-scope OAuth callback runs.''']
  serviceTokenExpiresAt DateTime
  recipientId Int [unique, not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  Note: '''Per-recipient cached credential metadata for the configured Cloud Signature
Consortium (CSC) provider. Holds the TSP-validated certificate chain and the
symmetric-encrypted service-scope access token. One row per recipient on a
CSC envelope; absent for SES recipients.'''
}

Table CscSession {
  id String [pk]
  envelopeId String [not null, note: '''Denormalised envelope id for ergonomic lookups. No FK relation — cleanup
flows through the Recipient cascade.''']
  signingTime DateTime [not null, note: '''Pinned at prep time; stable across overlay re-renders so the captured
signedAttrs digest matches the bytes the TSP signs.''']
  itemsJson Json [not null, note: '''Contract between prep and sign: an array of
`{ envelopeItemId, documentDataId, hashB64, ordinal }` per envelope item.
`documentDataId` pins the immutable bytes that produced the captured
digest so sign-time can re-derive the same hash against the same content.
[CscSessionItems] @zod.custom.use(ZCscSessionItemsSchema)''']
  encryptedSad Bytes [note: '''Populated by the credential-scope OAuth callback. Both nullable at row
creation; set together when the SAD is exchanged.''']
  sadExpiresAt DateTime
  createdAt DateTime [default: `now()`, not null]
  recipientId Int [unique, not null]

  Note: '''Per-recipient transient sign-time state held across the credential-scope
OAuth round-trip. The `recipientId @unique` constraint caps each recipient
to at most one in-flight session — re-clicking Sign UPSERTs the row.
Cleaned up transitively when the Recipient is deleted.
@zod.import(["import { ZCscSessionItemsSchema } from \'@documenso/lib/types/csc-session\';"])'''
}

