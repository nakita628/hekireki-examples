Table TemplateDirectLink {
  id String [pk]
  envelopeId String [unique, not null]
  token String [unique, not null]
  createdAt DateTime [default: `now()`, not null]
  enabled Boolean [not null]
  directTemplateRecipientId Int [not null]
}

Table SiteSettings {
  id String [pk]
  enabled Boolean [default: false, not null]
  data Json [not null]
  lastModifiedByUserId Int
  lastModifiedAt DateTime [default: `now()`, not null]
}

Table BackgroundJob {
  id String [pk]
  status BackgroundJobStatus [default: 'PENDING', not null]
  payload Json
  retried Int [default: 0, not null]
  maxRetries Int [default: 3, not null]
  jobId String [not null]
  name String [not null]
  version String [not null]
  submittedAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  completedAt DateTime
  lastRetriedAt DateTime
}

Table BackgroundJobTask {
  id String [pk]
  name String [not null]
  status BackgroundJobTaskStatus [default: 'PENDING', not null]
  result Json
  retried Int [default: 0, not null]
  maxRetries Int [default: 3, not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  completedAt DateTime
  jobId String [not null]
}

Table AvatarImage {
  id String [pk]
  bytes String [not null]
}

Table EmailDomain {
  id String [pk]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  status EmailDomainStatus [default: 'PENDING', not null]
  selector String [unique, not null]
  domain String [unique, not null]
  publicKey String [not null]
  privateKey String [not null]
  lastVerifiedAt DateTime
  organisationId String [not null]
}

Table OrganisationEmail {
  id String [pk]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  email String [unique, not null]
  emailName String [not null]
  emailDomainId String [not null]
  organisationId String [not null]
}

Table EmailTransport {
  id String [pk]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  name String [not null]
  type EmailTransportType [not null]
  fromName String [not null]
  fromAddress String [not null]
  config String [not null]
}

Table OrganisationAuthenticationPortal {
  id String [pk]
  enabled Boolean [default: false, not null]
  clientId String [default: '', not null]
  clientSecret String [default: '', not null]
  wellKnownUrl String [default: '', not null]
  defaultOrganisationRole OrganisationMemberRole [default: 'MEMBER', not null]
  autoProvisionUsers Boolean [default: true, not null]
  allowedDomains String[] [not null]
  allowPersonalOrganisations Boolean [default: false, not null]
}

Table Counter {
  id String [pk]
  value Int [not null]
}

Table EmbedSignature {
  key String [pk]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  organisationId String [not null]
  recipientId Int [not null, note: '''Last writer. Not a relation so the row survives document deletion and
remains useful for abuse tracing.''']
  signature String [not null]

  Note: '''`key` is sha256(organisationId:lower(recipientEmail):clientUserId) so neither
the recipient email nor the embedder\'s identifier is stored in plaintext.'''
}

Table RateLimit {
  key String [not null]
  action String [not null]
  bucket DateTime [not null]
  count Int [default: 1, not null]
  createdAt DateTime [default: `now()`, not null]

  indexes {
    (key, action, bucket) [pk]
  }
}

