Enum IdentityProvider {
  DOCUMENSO
  GOOGLE
  OIDC
}

Enum Role {
  ADMIN
  USER
}

Enum UserSecurityAuditLogType {
  ACCOUNT_PROFILE_UPDATE
  ACCOUNT_SSO_LINK
  ACCOUNT_SSO_UNLINK
  ORGANISATION_SSO_LINK
  ORGANISATION_SSO_UNLINK
  AUTH_2FA_DISABLE
  AUTH_2FA_ENABLE
  PASSKEY_CREATED
  PASSKEY_DELETED
  PASSKEY_UPDATED
  PASSWORD_RESET
  PASSWORD_UPDATE
  SESSION_REVOKED
  SIGN_OUT
  SIGN_IN
  SIGN_IN_FAIL
  SIGN_IN_2FA_FAIL
  SIGN_IN_PASSKEY_FAIL
}

Enum WebhookTriggerEvents {
  DOCUMENT_CREATED
  DOCUMENT_SENT
  DOCUMENT_OPENED
  DOCUMENT_SIGNED
  DOCUMENT_COMPLETED
  DOCUMENT_REJECTED
  DOCUMENT_CANCELLED
  RECIPIENT_EXPIRED
  DOCUMENT_RECIPIENT_COMPLETED
  DOCUMENT_REMINDER_SENT
  TEMPLATE_CREATED
  TEMPLATE_UPDATED
  TEMPLATE_DELETED
  TEMPLATE_USED
}

Enum WebhookCallStatus {
  SUCCESS
  FAILED
}

Enum ApiTokenAlgorithm {
  SHA512
}

Enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  INACTIVE
}

Enum DocumentStatus {
  DRAFT
  PENDING
  COMPLETED
  REJECTED
  CANCELLED
}

Enum DocumentSource {
  DOCUMENT
  TEMPLATE
  TEMPLATE_DIRECT_LINK
}

Enum DocumentVisibility {
  EVERYONE
  MANAGER_AND_ABOVE
  ADMIN
}

Enum FolderType {
  DOCUMENT
  TEMPLATE
}

Enum EnvelopeType {
  DOCUMENT
  TEMPLATE
}

Enum DocumentDataType {
  S3_PATH
  BYTES
  BYTES_64
}

Enum DocumentSigningOrder {
  PARALLEL
  SEQUENTIAL
}

Enum DocumentDistributionMethod {
  EMAIL
  NONE
}

Enum ReadStatus {
  NOT_OPENED
  OPENED
}

Enum SendStatus {
  NOT_SENT
  SENT
}

Enum SigningStatus {
  NOT_SIGNED
  SIGNED
  REJECTED
}

Enum RecipientRole {
  CC
  SIGNER
  VIEWER
  APPROVER
  ASSISTANT
}

Enum FieldType {
  SIGNATURE
  FREE_SIGNATURE
  INITIALS
  NAME
  EMAIL
  DATE
  TEXT
  NUMBER
  RADIO
  CHECKBOX
  DROPDOWN
}

Enum OrganisationType {
  PERSONAL
  ORGANISATION
}

Enum OrganisationGroupType {
  INTERNAL_ORGANISATION
  INTERNAL_TEAM
  CUSTOM
}

Enum OrganisationMemberRole {
  ADMIN
  MANAGER
  MEMBER
}

Enum TeamMemberRole {
  ADMIN
  MANAGER
  MEMBER
}

Enum OrganisationMemberInviteStatus {
  ACCEPTED
  PENDING
  DECLINED
}

Enum TemplateType {
  PUBLIC
  PRIVATE
  ORGANISATION
}

Enum BackgroundJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

Enum BackgroundJobTaskStatus {
  PENDING
  COMPLETED
  FAILED
}

Enum EmailDomainStatus {
  PENDING
  ACTIVE
}

Enum EmailTransportType {
  SMTP_AUTH
  SMTP_API
  RESEND
  MAILCHANNELS
}

Table User {
  id Int [pk, increment]
  name String
  email String [unique, not null]
  emailVerified DateTime
  password String
  source String
  signature String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]
  lastSignedIn DateTime [default: `now()`, not null]
  roles Role[] [not null]
  identityProvider IdentityProvider [default: 'DOCUMENSO', not null]
  avatarImageId String
  disabled Boolean [default: false, not null]
  twoFactorSecret String
  twoFactorEnabled Boolean [default: false, not null]
  twoFactorBackupCodes String
}

Table TeamProfile {
  id String [pk]
  enabled Boolean [default: false, not null]
  teamId Int [unique, not null]
  bio String
}

Table UserSecurityAuditLog {
  id Int [pk, increment]
  userId Int [not null]
  createdAt DateTime [default: `now()`, not null]
  type UserSecurityAuditLogType [not null]
  userAgent String
  ipAddress String
}

Table PasswordResetToken {
  id Int [pk, increment]
  token String [unique, not null]
  createdAt DateTime [default: `now()`, not null]
  expiry DateTime [not null]
  userId Int [not null]
}

Table Passkey {
  id String [pk]
  userId Int [not null]
  name String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]
  lastUsedAt DateTime
  credentialId Bytes [not null, note: '@zod.custom.use(z.instanceof(Uint8Array))']
  credentialPublicKey Bytes [not null, note: '@zod.custom.use(z.instanceof(Uint8Array))']
  counter BigInt [not null]
  credentialDeviceType String [not null]
  credentialBackedUp Boolean [not null]
  transports String[] [not null]
}

Table AnonymousVerificationToken {
  id String [pk]
  token String [unique, not null]
  expiresAt DateTime [not null]
  createdAt DateTime [default: `now()`, not null]
}

Table VerificationToken {
  id Int [pk, increment]
  secondaryId String [unique, not null]
  identifier String [not null]
  token String [unique, not null]
  completed Boolean [default: false, not null]
  expires DateTime [not null]
  createdAt DateTime [default: `now()`, not null]
  metadata Json
  userId Int [not null]
}

Table Webhook {
  id String [pk]
  webhookUrl String [not null]
  eventTriggers WebhookTriggerEvents[] [not null]
  secret String
  enabled Boolean [default: true, not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [default: `now()`, not null]
  userId Int [not null]
  teamId Int [not null]
}

Table WebhookCall {
  id String [pk]
  status WebhookCallStatus [not null]
  url String [not null]
  event WebhookTriggerEvents [not null]
  requestBody Json [not null]
  responseCode Int [not null]
  responseHeaders Json
  responseBody Json
  createdAt DateTime [default: `now()`, not null]
  webhookId String [not null]
}

Table ApiToken {
  id Int [pk, increment]
  name String [not null]
  token String [unique, not null]
  algorithm ApiTokenAlgorithm [default: 'SHA512', not null]
  expires DateTime
  createdAt DateTime [default: `now()`, not null]
  lastUsedAt DateTime
  userId Int
  teamId Int [not null]
}

Table Subscription {
  id Int [pk, increment]
  status SubscriptionStatus [default: 'INACTIVE', not null]
  planId String [unique, not null]
  priceId String [not null]
  periodEnd DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  cancelAtPeriodEnd Boolean [default: false, not null]
  customerId String [not null]
  organisationId String [unique, not null]
}

Table SubscriptionClaim {
  id String [pk]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  name String [not null]
  locked Boolean [default: false, not null]
  teamCount Int [not null]
  memberCount Int [not null]
  envelopeItemCount Int [not null]
  recipientCount Int [not null]
  flags Json [not null, note: '[ClaimFlags] @zod.custom.use(ZClaimFlagsSchema)']
  documentRateLimits Json [not null, note: '[RateLimitArray] @zod.custom.use(ZRateLimitArraySchema)']
  documentQuota Int
  emailRateLimits Json [not null, note: '[RateLimitArray] @zod.custom.use(ZRateLimitArraySchema)']
  emailQuota Int
  apiRateLimits Json [not null, note: '[RateLimitArray] @zod.custom.use(ZRateLimitArraySchema)']
  apiQuota Int
  emailTransportId String

  Note: '@zod.import(["import { ZClaimFlagsSchema, ZRateLimitArraySchema } from \'@documenso/lib/types/subscription\';"])'
}

Table OrganisationClaim {
  id String [pk]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  originalSubscriptionClaimId String
  teamCount Int [not null]
  memberCount Int [not null]
  envelopeItemCount Int [not null]
  recipientCount Int [not null]
  flags Json [not null, note: '[ClaimFlags] @zod.custom.use(ZClaimFlagsSchema)']
  documentRateLimits Json [not null, note: '[RateLimitArray] @zod.custom.use(ZRateLimitArraySchema)']
