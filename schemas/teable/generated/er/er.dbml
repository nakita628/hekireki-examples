Table computed_update_outbox {
  id String [pk]
  base_id String [not null]
  worker_lane String [default: 'production', not null]
  seed_table_id String [not null]
  seed_record_ids Json
  change_type String [not null]
  steps Json
  edges Json
  status String [not null]
  attempts Int [default: 0, not null]
  max_attempts Int [default: 8, not null]
  next_run_at DateTime [default: `now()`, not null]
  locked_at DateTime
  locked_by String
  last_error String
  estimated_complexity Int [default: 0, not null]
  plan_hash String [not null]
  dirty_stats Json
  run_id String [not null]
  origin_run_ids String[] [not null]
  run_total_steps Int [default: 0, not null]
  run_completed_steps_before Int [default: 0, not null]
  affected_table_ids String[] [not null]
  affected_field_ids String[] [not null]
  sync_max_level Int
  source_changed_at DateTime
  stage_depth Int [default: 0, not null]
  predecessor_task_id String
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime [not null]
}

Table computed_update_outbox_seed {
  id String [pk]
  task_id String [not null]
  table_id String [not null]
  record_id String [not null]

  indexes {
    (task_id, table_id, record_id) [unique]
  }
}

Table computed_update_change_frontier {
  scope_id String [not null]
  kind String [not null]
  table_id String [not null]
  record_id String [not null]
  field_id String [not null]

  indexes {
    (scope_id, kind, table_id, record_id, field_id) [pk]
  }

  Note: 'Actual output-value evidence; independent from continuation progress.'
}

Table computed_update_stage_ledger {
  scope_id String [not null]
  kind String [not null]
  table_id String [not null]
  record_id String [not null]
  seq BigInt [default: 0, not null]

  indexes {
    (scope_id, kind, table_id, record_id) [pk]
  }

  Note: '''Durable per-stage state for budget-staged computed updates, keyed by the
continuation chain\'s root task id (its scope). Rows are written once per
record and never copied between continuation tasks:
- kind \'excluded\': processed-target exclusion ledger for partial batches;
- kind \'frontier\': seq-ordered queue of sources whose outgoing propagation
is not finished (self-referential generations + migrated explicit seeds);
- kind \'consumed\': retired frontier sources preserved for deferred edge
chunks, handed to the continuation as seeds at stage completion.
Cleared when the chain\'s stage completes or the chain dead-letters.'''
}

Table computed_update_dead_letter {
  id String [pk]
  base_id String [not null]
  worker_lane String [default: 'production', not null]
  seed_table_id String [not null]
  seed_record_ids Json
  change_type String [not null]
  steps Json
  edges Json
  status String [not null]
  attempts Int [default: 0, not null]
  max_attempts Int [default: 8, not null]
  next_run_at DateTime [not null]
  locked_at DateTime
  locked_by String
  last_error String
  estimated_complexity Int [default: 0, not null]
  plan_hash String [not null]
  dirty_stats Json
  run_id String [not null]
  origin_run_ids String[] [not null]
  run_total_steps Int [default: 0, not null]
  run_completed_steps_before Int [default: 0, not null]
  affected_table_ids String[] [not null]
  affected_field_ids String[] [not null]
  sync_max_level Int
  source_changed_at DateTime
  stage_depth Int [default: 0, not null]
  predecessor_task_id String
  trace_data Json
  failed_at DateTime [not null]
  created_at DateTime [not null]
  updated_at DateTime [not null]
}

Table computed_update_dead_letter_seed {
  task_id String [not null]
  table_id String [not null]
  record_id String [not null]

  indexes {
    (task_id, table_id, record_id) [pk]
  }
}

Table computed_update_run_history {
  task_id String [pk]
  base_id String [not null]
  seed_table_id String [not null]
  change_type String [not null]
  run_id String [not null]
  origin_run_ids String[] [not null]
  steps Json
  edges Json
  affected_table_ids String[] [not null]
  affected_field_ids String[] [not null]
  source_field_ids String[] [not null, note: '''Source (changed) field ids; populated for seed tasks, where
affected_field_ids carries the trigger fields rather than targets.''']
  seed_record_count Int [default: 0, not null]
  stage_depth Int [default: 0, not null]
  predecessor_task_id String
  run_total_steps Int [default: 0, not null]
  run_completed_steps_before Int [default: 0, not null]
  sync_max_level Int
  estimated_complexity Int [default: 0, not null]
  attempts Int [default: 0, not null]
  outcome String [not null]
  source_changed_at DateTime
  enqueued_at DateTime [not null]
  started_at DateTime
  completed_at DateTime [not null]
  duration_ms Int [default: 0, not null]

  Note: '''Completion ledger for computed-update outbox tasks (lineage / latency
tracing). Successful tasks are hard-deleted from the outbox on markDone,
so this table keeps a retention-bounded trail per completed task: the
run/stage chain (runId, stageDepth, predecessorTaskId) and the timeline
from source mutation to converged write (sourceChangedAt → completedAt).
Observability only — the worker never reads it; rows are pruned after a
retention window.'''
}

