  created_by String [not null]
  last_modified_time DateTime
  last_modified_by String
}

Table user_last_visit {
  id String [pk]
  user_id String [not null]
  resource_type String [not null]
  resource_id String [not null]
  parent_resource_id String [not null]
  last_visit_time DateTime [default: `now()`, not null]

  indexes {
    (user_id, resource_type, resource_id) [unique]
  }
}

Table user_base_order {
  id String [pk]
  user_id String [not null]
  base_id String [not null]
  order Float [not null]
  created_time DateTime [default: `now()`, not null]
  last_modified_time DateTime

  indexes {
    (user_id, base_id) [unique]
  }
}

Table template {
  id String [pk]
  base_id String [unique]
  cover String
  name String
  description String
  markdown_description String
  category_id String[] [not null]
  created_time DateTime [default: `now()`, not null]
  created_by String [not null]
  last_modified_time DateTime
  last_modified_by String
  is_system Boolean
  is_published Boolean
  featured Boolean
  snapshot String
  order Float [not null]
  usage_count Int [default: 0, not null]
  publish_info Json
  visit_count Int [default: 0, not null]
  kind String
  version Int [default: 1, not null]
  manifest Json
  review Json
  history Json
  parent_template_id String
  slug String [unique]
}

Table template_category {
  id String [pk]
  name String [unique, not null]
  created_time DateTime [default: `now()`, not null]
  created_by String [not null]
  last_modified_time DateTime
  last_modified_by String
  order Float [not null]
  parent_id String
  kind String [default: 'industry', not null]
  key String [unique]
}

Table task {
  id String [pk]
  type String [not null]
  status String [not null]
  snapshot String
  created_time DateTime [default: `now()`, not null]
  last_modified_time DateTime
  created_by String [not null]
  last_modified_by String
}

Table task_run {
  id String [pk]
  task_id String [not null]
  base_id String [not null]
  status String [not null]
  snapshot String [not null]
  depends_on_run_ids String[] [not null]
  spent Int
  log String
  error_msg String
  started_time DateTime
  created_time DateTime [default: `now()`, not null]
  last_modified_time DateTime
}

Table task_reference {
  id String [pk]
  from_field_id String [not null]
  to_field_id String [not null]
  created_time DateTime [default: `now()`, not null]

  indexes {
    (to_field_id, from_field_id) [unique]
  }
}

Table waitlist {
  email String [unique, not null]
  invite Boolean
  invite_time DateTime
  created_time DateTime [default: `now()`, not null]
}

Table base_node {
  id String [pk]
  parent_id String
  base_id String [not null]
  resource_type String [not null]
  resource_id String [not null]
  order Float [not null]
  created_time DateTime [default: `now()`, not null]
  created_by String [not null]
  last_modified_time DateTime
  last_modified_by String

  indexes {
    (base_id, resource_type, resource_id) [unique]
  }
}

Table base_node_folder {
  id String [pk]
  base_id String [not null]
  name String [not null]
  created_time DateTime [default: `now()`, not null]
  created_by String [not null]
  last_modified_time DateTime
  last_modified_by String
  deleted_time DateTime
}

Table base_share {
  id String [pk]
  base_id String [not null]
  share_id String [unique, not null]
  password String
  node_id String
  allow_save Boolean
  allow_copy Boolean
  allow_edit Boolean
  enabled Boolean [default: true, not null]
  created_time DateTime [default: `now()`, not null]
  created_by String [not null]
  last_modified_time DateTime

  indexes {
    (base_id, node_id) [unique]
  }
}

Table short_link {
  id String [pk]
  code String [unique, not null]
  type String [not null]
  resource_id String [not null]
  created_time DateTime [default: `now()`, not null]
  created_by String [not null]
  deleted_time DateTime

  indexes {
    (type, resource_id) [unique]
  }
}

