}

Table data_db_connection {
  id String [pk]
  provider DataDbProvider [default: 'postgres', not null]
  encrypted_url String [not null]
  url_fingerprint String [unique, not null]
  display_host String
  display_database String
  internal_schema String [not null]
  status DataDbConnectionStatus [default: 'pending', not null]
  schema_version String
  capabilities Json
  last_validated_at DateTime
  last_error String
  health_state DataDbConnectionHealthState [default: 'healthy', not null]
  health_reason String
  health_changed_at DateTime
  last_health_check_at DateTime
  consecutive_health_failures Int [default: 0, not null]
  created_by String [not null]
  created_time DateTime [default: `now()`, not null]
  last_modified_time DateTime
}

Table space_data_db_binding {
  id String [pk]
