Enum ProvisionState {
  pending
  ready
  error
  deleting
}

Enum DataDbProvider {
  postgres
}

Enum DataDbConnectionStatus {
  pending
  validating
  ready
  error
  migrating
  disabled
}

Enum DataDbConnectionHealthState {
  healthy
  read_only
  unreachable
  degraded
}

Enum SpaceDataDbBindingMode {
  default
  byodb
}

Enum SpaceDataDbBindingState {
  ready
  validating
  initializing
  migrating
  error
  disabled
}

Enum SpaceDataDbMigrationJobState {
  pending
  waiting_worker
  preflight
  freezing_writes
  copying
  validating
  switching
  succeeded
  failed
  canceled
  rolled_back
}

Enum BaseDataDbMoveJobState {
  pending
  waiting_worker
  copying_base_schema
  copying_shared_rows
  validating
  switching
  succeeded
  failed
  cancelled
}

Table space {
  id String [pk]
  name String [not null]
