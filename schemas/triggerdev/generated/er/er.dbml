  runId String [not null]
  createdAt DateTime [default: `now()`, not null]
}

Table TaskEventPartitioned {
  id String [not null]
  message String [not null, note: 'This matches the span name for a trace event, or the log body for a log event']
  traceId String [not null]
  spanId String [not null]
  parentId String
  tracestate String
  isError Boolean [default: false, not null]
  isPartial Boolean [default: false, not null]
  isCancelled Boolean [default: false, not null]
  serviceName String [not null]
  serviceNamespace String [not null]
  level TaskEventLevel [default: 'TRACE', not null]
  kind TaskEventKind [default: 'INTERNAL', not null]
  status TaskEventStatus [default: 'UNSET', not null]
  links Json
  events Json
  startTime BigInt [not null, note: 'This is the time the event started in nanoseconds since the epoch']
  duration BigInt [default: 0, not null, note: 'This is the duration of the event in nanoseconds']
  attemptId String
  attemptNumber Int
  environmentId String [not null]
  environmentType RuntimeEnvironmentType [not null]
  organizationId String [not null]
  projectId String [not null]
  projectRef String [not null]
  runId String [not null]
  runIsTest Boolean [default: false, not null]
  idempotencyKey String
  taskSlug String [not null]
  taskPath String
  taskExportName String
  workerId String
  workerVersion String
  queueId String
  queueName String
  batchId String
  properties Json [not null, note: 'This represents all the span attributes available, like http.status_code, and special attributes like $style.icon, $output, $metadata.payload.userId, as it\'s used for searching and filtering']
  metadata Json [note: 'This represents all span attributes in the $metadata namespace, like $metadata.payload']
  style Json [note: 'This represents all span attributes in the $style namespace, like $style']
  output Json [note: 'This represents all span attributes in the $output namespace, like $output']
  outputType String [note: 'This represents the mimetype of the output, such as application/json or application/super+json']
  payload Json
  payloadType String
  createdAt DateTime [default: `now()`, not null]
  usageDurationMs Int [default: 0, not null]
  usageCostInCents Float [default: 0, not null]
  machinePreset String
  machinePresetCpu Float
  machinePresetMemory Float
  machinePresetCentsPerMs Float

  indexes {
    (id, createdAt) [pk]
  }

  Note: 'This is the unified otel span/log model that will eventually be replaced by clickhouse'
}

