  integrationDeploymentId String [not null, note: 'External ID']
  commitSHA String [not null]
  deploymentId String
  status String [note: 'External deployment status']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table MetricsDashboard {
  id String [pk]
  friendlyId String [unique, not null]
  title String [not null]
  description String [default: '', not null]
  organizationId String [not null]
  projectId String
  ownerId String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  layout String [not null, note: '''JSON that defines the config, queries, layout and config of all widgets.
There will be a version field for the format.''']

  Note: 'A user-defined metrics dashboard'
}

Table llm_models {
  id String [pk]
  friendly_id String [unique, not null]
  project_id String
  model_name String [not null]
  match_pattern String [not null]
  start_date DateTime
  source String [default: 'default', not null]
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime [not null]
  provider String
  description String
  context_window Int
  max_output_tokens Int
  capabilities String[] [not null]
  is_hidden Boolean [default: false, not null]
  base_model_name String
  pricing_unit String

  indexes {
    (project_id, model_name, start_date) [unique]
  }

  Note: 'A known LLM model or model pattern for cost tracking'
}

Table llm_pricing_tiers {
  id String [pk]
  model_id String [not null]
  name String [not null]
  is_default Boolean [default: true, not null]
  priority Int [default: 0, not null]
  conditions Json [default: '[]', not null]

  indexes {
    (model_id, priority) [unique]
    (model_id, name) [unique]
  }

  Note: 'A pricing tier for a model (supports volume-based or conditional pricing)'
}

Table llm_prices {
  id String [pk]
  model_id String [not null]
  pricing_tier_id String [not null]
  usage_type String [not null]
  price Decimal [not null]

  indexes {
    (model_id, usage_type, pricing_tier_id) [unique]
  }

  Note: 'A price point for a usage type within a pricing tier'
}

Table PlatformNotification {
  id String [pk]
  friendlyId String [unique, not null]
  title String [not null, note: 'Admin-facing title for identification in admin tools']
  payload Json [not null, note: 'Versioned JSON rendering content (see payload schema in spec)']
  surface PlatformNotificationSurface [not null]
  scope PlatformNotificationScope [not null]
  userId String
  organizationId String
  projectId String
  startsAt DateTime [not null, note: 'When notification becomes active']
  endsAt DateTime [not null, note: 'When notification expires']
  cliMaxDaysAfterFirstSeen Int [note: 'CLI: auto-expire N days after user first saw it']
  cliMaxShowCount Int [note: 'CLI: auto-expire after shown N times to user']
  cliShowEvery Int [note: 'CLI: only show every N-th request (e.g. cliShowEvery=3 means show on 3rd, 6th, 9th…)']
  priority Int [default: 0, not null, note: 'Ordering within same scope level (higher = more important)']
  isDraft Boolean [default: false, not null, note: '''Staged-but-unpublished. While true the notification is hidden from all
user-facing reads regardless of startsAt/endsAt; publishing sets real
dates and flips this to false.''']
  archivedAt DateTime [note: 'Soft delete']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  Note: 'Admin-created notification definitions'
}

Table PlatformNotificationInteraction {
  id String [pk]
  notificationId String [not null]
  userId String [not null]
  firstSeenAt DateTime [default: `now()`, not null, note: 'Set by beacon/CLI GET on first impression']
  showCount Int [default: 1, not null, note: 'Times shown (incremented per beacon/CLI view)']
  webappDismissedAt DateTime [note: 'User dismissed in webapp']
  webappClickedAt DateTime [note: 'User clicked a link in webapp']
  cliDismissedAt DateTime [note: 'Auto-dismissed or expired in CLI']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (notificationId, userId) [unique]
  }

  Note: 'Per-user tracking of notification views and dismissals'
}

Table ErrorGroupState {
  id String [pk]
  organizationId String [not null]
  projectId String [not null]
  environmentId String
  taskIdentifier String [not null]
  errorFingerprint String [not null]
  status ErrorGroupStatus [default: 'UNRESOLVED', not null]
  ignoredUntil DateTime [note: '''*
* Error is ignored until this date''']
  ignoredUntilOccurrenceRate Int [note: '''*
* Error is ignored until this occurrence rate''']
  ignoredUntilTotalOccurrences Int [note: '''*
* Error is ignored until this total occurrences''']
  ignoredAtOccurrenceCount BigInt [note: '''Total occurrence count at the time the error was ignored (from ClickHouse).
Used with ignoredUntilTotalOccurrences to compute occurrences since ignoring.''']
  ignoredAt DateTime [note: '''*
* Error was ignored at this date''']
  ignoredReason String [note: '''*
* Reason for ignoring the error''']
  ignoredByUserId String [note: '''*
* User who ignored the error''']
  resolvedAt DateTime [note: '''*
* Error was resolved at this date''']
  resolvedInVersion String [note: '''*
* Error was resolved in this version''']
  resolvedBy String [note: '''*
* User who resolved the error''']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (environmentId, taskIdentifier, errorFingerprint) [unique]
  }

  Note: '''*
* Error group state is used to track when a user has interacted with an error (ignored/resolved)
* The actual error data is in ClickHouse.'''
}

Table TaskIdentifier {
  id String [pk]
  runtimeEnvironmentId String [not null]
  projectId String [not null]
  slug String [not null]
  currentTriggerSource TaskTriggerSource [default: 'STANDARD', not null]
  currentWorkerId String
  firstSeenAt DateTime [default: `now()`, not null]
  lastSeenAt DateTime [default: `now()`, not null]
  isInLatestDeployment Boolean [default: true, not null]

  indexes {
    (runtimeEnvironmentId, slug) [unique]
  }
}

Table OrganizationDataStore {
  id String [pk]
  key String [unique, not null, note: 'Human-readable unique key (e.g. "hipaa-clickhouse-us-east")']
  organizationIds String[] [not null, note: 'Organization IDs that use this data store']
  kind DataStoreKind [not null]
  config Json [not null, note: 'Versioned config JSON. Structure is discriminated by the top-level `version` field.']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  Note: '''Defines org-scoped data store overrides (e.g. dedicated ClickHouse for HIPAA orgs).
Multiple organizations can share a single data store row via organizationIds.'''
}

Ref User_mfaSecretReferenceId_fk: User.mfaSecretReferenceId > SecretReference.id

Ref User_invitationCodeId_fk: User.invitationCodeId > InvitationCode.id

Ref MfaBackupCode_userId_fk: MfaBackupCode.userId > User.id

Ref AuthorizationCode_personalAccessTokenId_fk: AuthorizationCode.personalAccessTokenId > PersonalAccessToken.id [delete: cascade, update: cascade]

Ref PersonalAccessToken_userId_fk: PersonalAccessToken.userId > User.id

Ref OrganizationAccessToken_organizationId_fk: OrganizationAccessToken.organizationId > Organization.id

Ref OrgMember_organizationId_fk: OrgMember.organizationId > Organization.id [delete: cascade, update: cascade]

Ref OrgMember_userId_fk: OrgMember.userId > User.id [delete: cascade, update: cascade]

Ref OrgMemberInvite_organizationId_fk: OrgMemberInvite.organizationId > Organization.id [delete: cascade, update: cascade]

Ref OrgMemberInvite_inviterId_fk: OrgMemberInvite.inviterId > User.id [delete: cascade, update: cascade]

Ref RuntimeEnvironment_parentEnvironmentId_fk: RuntimeEnvironment.parentEnvironmentId > RuntimeEnvironment.id [delete: cascade, update: cascade]

Ref RuntimeEnvironment_organizationId_fk: RuntimeEnvironment.organizationId > Organization.id [delete: cascade, update: cascade]

Ref RuntimeEnvironment_projectId_fk: RuntimeEnvironment.projectId > Project.id [delete: cascade, update: cascade]

Ref RuntimeEnvironment_orgMemberId_fk: RuntimeEnvironment.orgMemberId > OrgMember.id [delete: set null, update: cascade]

Ref RuntimeEnvironment_currentSessionId_fk: RuntimeEnvironment.currentSessionId > RuntimeEnvironmentSession.id [delete: set null, update: cascade]

Ref api_keys_runtime_environment_id_fk: api_keys.runtime_environment_id > RuntimeEnvironment.id [delete: cascade, update: cascade]

Ref api_keys_created_by_user_id_fk: api_keys.created_by_user_id > User.id [delete: set null, update: cascade]

Ref RevokedApiKey_runtimeEnvironmentId_fk: RevokedApiKey.runtimeEnvironmentId > RuntimeEnvironment.id [delete: cascade, update: cascade]

Ref Project_organizationId_fk: Project.organizationId > Organization.id [delete: cascade, update: cascade]

Ref Project_defaultWorkerGroupId_fk: Project.defaultWorkerGroupId > WorkerInstanceGroup.id

Ref EnvironmentEncryptionPolicy_environmentId_fk: EnvironmentEncryptionPolicy.environmentId - RuntimeEnvironment.id [delete: cascade]

Ref EnvironmentEncryptionPolicy_(activeKeyId, environmentId)_fk: EnvironmentEncryptionPolicy.(activeKeyId, environmentId) > EnvironmentEncryptionKey.(id, environmentId) [delete: no action, update: no action]

Ref EnvironmentEncryptionKey_environmentId_fk: EnvironmentEncryptionKey.environmentId > RuntimeEnvironment.id [delete: cascade]

Ref BackgroundWorker_projectId_fk: BackgroundWorker.projectId > Project.id [delete: cascade, update: cascade]

Ref BackgroundWorker_runtimeEnvironmentId_fk: BackgroundWorker.runtimeEnvironmentId > RuntimeEnvironment.id [delete: cascade, update: cascade]

Ref BackgroundWorker_workerGroupId_fk: BackgroundWorker.workerGroupId > WorkerInstanceGroup.id [delete: set null, update: cascade]

Ref BackgroundWorkerFile_projectId_fk: BackgroundWorkerFile.projectId > Project.id [delete: cascade, update: cascade]

Ref prompts_organizationId_fk: prompts.organizationId > Organization.id [delete: cascade, update: cascade]

Ref prompts_projectId_fk: prompts.projectId > Project.id [delete: cascade, update: cascade]

