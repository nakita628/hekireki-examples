  integrationData Json [not null, note: 'Save useful data like config or external entity name']
  installedBy String [note: 'UserId who installed the integration']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  deletedAt DateTime
}

Table BulkActionGroup {
  id String [pk]
  friendlyId String [unique, not null]
  projectId String [not null]
  environmentId String
  type BulkActionType [not null]
  status BulkActionStatus [default: 'PENDING', not null, note: 'When the group is created it\'s pending. After we\'ve processed all the items it\'s completed. This does not mean the associated runs are completed.']
  queryName String [note: 'The query that will be executed to get the runs to process (if null, we are passing run ids directly)']
  params Json [note: 'The params that will be passed to the query']
  dedupeKey String [note: 'Billing-limit dedupe key (grace hitAt or resolve job key). Null for dashboard bulk actions.']
  cursor Json [note: 'The cursor that will be passed to the query (null for the first page)']
  successCount Int [default: 0, not null, note: 'The number of runs that have been processed successfully']
  failureCount Int [default: 0, not null, note: 'The number of runs that have been failed']
  totalCount Int [default: 0, not null, note: 'The total number of runs that will be processed']
  completionNotification BulkActionNotificationType [default: 'NONE', not null]
  userId String
  name String [note: 'The name of the bulk action']
  completedAt DateTime [note: 'The time the bulk action was completed']
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  Note: 'Bulk actions, like canceling and replaying runs'
}

Table BulkActionItem {
  id String [pk]
  friendlyId String [note: '@deprecated not used in new BulkActions']
  groupId String [not null]
  type BulkActionType [not null]
  status BulkActionItemStatus [default: 'PENDING', not null, note: 'When the item is created it\'s pending. After we\'ve processed the item it\'s completed. This does not mean the associated runs are completed.']
  sourceRunId String [not null]
  destinationRunId String
  error String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table RealtimeStreamChunk {
