  environmentTypes RuntimeEnvironmentType[] [not null]
  errorAlertConfig Json
  projectId String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (projectId, deduplicationKey) [unique]
  }
}

