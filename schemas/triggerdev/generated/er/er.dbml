}

Table WorkerDeployment {
  id String [pk]
  contentHash String [not null]
  friendlyId String [unique, not null]
  shortCode String [not null]
  version String [not null]
  runtime String
  runtimeVersion String
  cliVersion String [note: 'CLI version that initiated the deploy, stamped at initialization']
  imageReference String
  imagePlatform String [default: 'linux/amd64', not null]
  templateKey String [note: 'Key of the microVM template prebuilt from this deployment\'s image, set when the builder succeeds']
  indexObjectKey String [note: 'Object key of the full index snapshot in the deployment index store. Set only after the upload succeeds.']
  indexSha256 String [note: 'sha256 hex of the snapshot\'s uncompressed JSON']
  indexFormatVersion Int
  externalBuildData Json
  buildServerMetadata Json
  buildEnvVars Json [note: '''Encrypted build-time env vars for pre-bundled (fromBundle) deploys, as an
EncryptedSecretValue envelope. Kept for the redeploy window, then cleared by a sweep.''']
  status WorkerDeploymentStatus [default: 'PENDING', not null]
  type WorkerDeploymentType [default: 'V1', not null]
  projectId String [not null]
  environmentId String [not null]
  workerId String [unique]
  triggeredById String
  triggeredVia String
  commitSHA String
  externalId String
  startedAt DateTime
  installedAt DateTime
  builtAt DateTime
  deployedAt DateTime
  failedAt DateTime
  errorData Json
  canceledAt DateTime
  canceledReason String
  git Json
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (projectId, shortCode) [unique]
    (environmentId, version) [unique]
  }
}

Table WorkerDeploymentPromotion {
  id String [pk]
  label String [not null, note: 'This is the promotion label, e.g. "current"']
  deploymentId String [not null]
  environmentId String [not null]

  indexes {
    (environmentId, label) [unique]
  }
}

Table TaskSchedule {
  id String [pk]
  type ScheduleType [default: 'IMPERATIVE', not null]
  friendlyId String [unique, not null, note: 'users see this as `id`. They start with schedule_']
  taskIdentifier String [not null, note: 'a reference to a task (not a foreign key because it\'s across versions)']
  deduplicationKey String [not null, note: 'can be provided and we won\'t create another with the same key']
  userProvidedDeduplicationKey Boolean [default: false, not null]
  generatorExpression String [not null, note: 'the CRON pattern']
  generatorDescription String [default: '', not null]
  generatorType ScheduleGeneratorType [default: 'CRON', not null]
  timezone String [default: 'UTC', not null, note: 'These are IANA format string, or the default "UTC". E.g. "America/New_York"']
  windowDurationSeconds Int
  windowPercentage Int
  defaultWindowDurationSeconds Int
  minimumWindowDurationSeconds Int
  externalId String [note: 'Can be provided by the user then accessed inside a run']
  lastRunTriggeredAt DateTime [note: '@deprecated stop writing 2026-04-30; reads moved out of code (UI now derives from cron\'s previous slot). Drop in follow-up.']
  projectId String [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  active Boolean [default: true, not null]

  indexes {
    (projectId, deduplicationKey) [unique]
  }

  Note: 'Schedules can be attached to tasks to trigger them on a schedule'
}

Table TaskScheduleInstance {
  id String [pk]
  taskScheduleId String [not null]
  environmentId String [not null]
  projectId String [not null]
  schedulePhase Int
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
  active Boolean [default: true, not null]
  lastScheduledTimestamp DateTime [note: '@deprecated stop writing 2026-04-30; engine derives from cron + exactScheduleTime. Drop in follow-up.']
  nextScheduledTimestamp DateTime [note: '@deprecated stop writing 2026-04-30; engine derives from cron + now(). Drop in follow-up.']

  indexes {
    (taskScheduleId, environmentId) [unique]
  }

  Note: 'An instance links a schedule with an environment'
}

Table RuntimeEnvironmentSession {
  id String [pk]
