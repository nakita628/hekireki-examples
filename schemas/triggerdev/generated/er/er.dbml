}

Table CustomerQuery {
  id String [pk]
  query String [not null, note: 'The TSQL query text that was executed']
  scope CustomerQueryScope [not null, note: 'The scope of the query (determines which tenant IDs were used)']
  stats Json [not null, note: 'Query execution statistics from ClickHouse']
  title String [note: 'AI-generated title summarizing the query']
  source CustomerQuerySource [default: 'DASHBOARD', not null, note: 'Where the query originated from']
  organizationId String [not null]
  projectId String
  environmentId String
  userId String
  filterPeriod String [note: '''Time filter settings used when the query was executed
Period like "7d", "24h", etc.''']
  filterFrom DateTime [note: 'Custom start date (ISO 8601)']
  filterTo DateTime [note: 'Custom end date (ISO 8601)']
  createdAt DateTime [default: `now()`, not null]
}

Table IntegrationDeployment {
