// ---- models/poll.prisma

enum ParticipantVisibility {
  full
  scoresOnly
  limited

  @@map("participant_visibility")
}

enum PollStatus {
  open
  closed
  scheduled
  canceled

  @@map("poll_status")
}

enum PollKind {
  date
  time

  @@map("poll_kind")
}

enum PollClosedReason {
  auto
  manual

  @@map("poll_closed_reason")
}

model Poll {
  id                      String            @id @unique @map("id")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")
  deadline                DateTime?
  title                   String
  description             String?
  location                String?
  /// What the organizer asked for: a provider to mint a link with at
  /// finalize ("zoom" | "meet" | "teams" | "webex"), or a link they pasted
  /// themselves.
  conferencing            Json?
  userId                  String?           @map("user_id")
  timeZone                String?           @map("time_zone")
  status                  PollStatus        @default(open)
  closedReason            PollClosedReason? @map("closed_reason")
  kind                    PollKind          @default(date)
  deleted                 Boolean           @default(false)
  deletedAt               DateTime?         @map("deleted_at")
  eventId                 String?           @unique @map("event_id")
  scheduledEventId        String?           @map("scheduled_event_id")
  hideParticipants        Boolean           @default(false) @map("hide_participants")
  hideScores              Boolean           @default(false) @map("hide_scores")
  disableComments         Boolean           @default(true) @map("disable_comments")
  requireParticipantEmail Boolean           @default(false) @map("require_participant_email")
  /// Whether participants may cast the tentative "if need be" vote. Positive
  /// flag so a future vote-type expansion adds columns rather than inverting a
  /// negative. Turning it off only blocks new tentative votes; existing ones
  /// are kept and stay visible.
  allowTentativeVotes     Boolean           @default(true) @map("allow_tentative_votes")
  muted                   Boolean           @default(false)

  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledEvent ScheduledEvent? @relation(fields: [scheduledEventId], references: [id], onDelete: SetNull)
  options        Option[]
  participants   Participant[]
  comments       Comment[]
  votes          Vote[]
  invites        PollInvite[]
  activities     PollActivity[]
  space          Space?          @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  spaceId        String?         @map("space_id")

  @@index([spaceId])
  @@index([userId])
  @@map("polls")
}

model Participant {
  id        String    @id @default(cuid())
  name      String
  email     String?
  note      String?
  /// Per response edit link: grants edit access to this response without a session. App minted at creation, CSPRNG alphanumeric ≥32 chars (nanoid customAlphabet — url safe with no linkifier edge cases, unlike base64url); never a DB default so a code path that forgets to mint fails loudly. A response created through an emailed invite takes the invite's token. Rows that predate minting were backfilled with gen_random_uuid() hex
  token     String    @unique
  userId    String?   @map("user_id")
  pollId    String    @map("poll_id")
  locale    String?
  timeZone  String?   @map("time_zone")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  votes  Vote[]
  invite PollInvite?

  poll Poll  @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([pollId], type: Hash)
  @@index([userId])
  @@map("participants")
}

model PollInvite {
  id     String @id @default(cuid())
  pollId String @map("poll_id")
  email  String @db.Citext
  /// Per invitee link. App minted, CSPRNG alphanumeric ≥32 chars (nanoid customAlphabet) — no schema default, so forgetting to mint fails loudly. Rotated on reactivation so a revoked (possibly leaked) token never regains access
  token  String @unique

  openedAt   DateTime? @map("opened_at")
  remindedAt DateTime? @map("reminded_at")
  /// Revocation is always explicit: set when the host removes a pending invite, never as a side effect of close, schedule or reopen. Deleting a response instead hard deletes the participant, so the SetNull FK clears participantId and reverts the invite to pending with its token intact — the token the deleted response held is freed with it, so the next response through the same link can take it again. Cleared only by re-inviting (reactivation), which also rotates the token
  revokedAt  DateTime? @map("revoked_at")

  /// Conversion join, merges invite history into the response timeline. Set only when the invitee responds via their token: a typed email is unverified, so a generic link response never claims an invite
  participantId String? @unique @map("participant_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  poll        Poll         @relation(fields: [pollId], references: [id], onDelete: Cascade)
  participant Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@unique([pollId, email])
  @@map("poll_invites")
}

model PollActivity {
  id     String @id @default(cuid())
  pollId String @map("poll_id")
  /// Validated by a zod union in the feature, not a DB enum: the activity vocabulary grows without migrations
  type   String

  /// Subject ids are soft references (no FKs): activity must outlive its subjects — including account deletion — so refs persist as identity and the payload carries the display snapshot; whether a ref still resolves is the renderer's question
  userId        String? @map("user_id")
  participantId String? @map("participant_id")
  inviteId      String? @map("invite_id")
  optionId      String? @map("option_id")
  payload       Json    @default("{}")

  createdAt DateTime @default(now()) @map("created_at")

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@index([pollId, createdAt(sort: Desc)])
  @@index([pollId, participantId])
  @@index([pollId, optionId])
  @@index([pollId, inviteId])
  @@index([userId])
  @@map("poll_activities")
}

model Option {
  id        String   @id @default(cuid())
  startTime DateTime @map("start_time") @db.Timestamp(0)
  duration  Int      @default(0) @map("duration_minutes")
  pollId    String   @map("poll_id")
  createdAt DateTime @default(now()) @map("created_at")

  votes Vote[]

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@index([pollId], type: Hash)
  @@map("options")
}

enum VoteType {
  yes
  no
  ifNeedBe

  @@map("vote_type")
}

model Vote {
  id            String    @id @default(cuid())
  participantId String    @map("participant_id")
  optionId      String    @map("option_id")
  pollId        String    @map("poll_id")
  type          VoteType  @default(yes)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime? @updatedAt @map("updated_at")

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  option      Option      @relation(fields: [optionId], references: [id], onDelete: Cascade)
  poll        Poll        @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@index([pollId], type: Hash)
  @@index([participantId], type: Hash)
  @@index([optionId], type: Hash)
  @@map("votes")
}

model Comment {
  id         String    @id @default(cuid())
  content    String
  pollId     String    @map("poll_id")
  authorName String    @map("author_name")
  userId     String?   @map("user_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  poll Poll  @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([pollId])
  @@index([userId])
  @@map("comments")
}

// ---- models/registered-instance.prisma

model RegisteredInstance {
  id          String   @id @default(cuid())
  instanceId  String   @unique @map("instance_id")
  version     String
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @updatedAt @map("last_seen_at")

  @@map("registered_instances")
}

// ---- models/sheet.prisma

model Sheet {
  id          String  @id @default(cuid())
  spaceId     String  @map("space_id")
  hostId      String  @map("host_id")
  title       String
  description String?
  urlId       String  @unique @map("url_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deleted   Boolean   @default(false)
  deletedAt DateTime? @map("deleted_at")

  space Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  host  User        @relation(fields: [hostId], references: [id], onDelete: Cascade)
  slots SheetSlot[]

  @@index([spaceId])
  @@index([hostId])
  @@map("sheets")
}

model SheetSlot {
  id          String   @id @default(cuid())
  sheetId     String   @map("sheet_id")
  eventTypeId String   @map("event_type_id")
  startTime   DateTime @map("start_time")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sheet          Sheet           @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  eventType      EventType       @relation(fields: [eventTypeId], references: [id], onDelete: Restrict)
  scheduledEvent ScheduledEvent?

  @@index([sheetId, startTime])
  @@index([eventTypeId])
  @@map("sheet_slots")
}

// ---- models/space.prisma

model Space {
  id                         String     @id @default(uuid())
  name                       String
  image                      String?
  ownerId                    String     @map("owner_id")
  tier                       SpaceTier  @default(hobby)
  spaceType                  SpaceType? @map("space_type")
  // Self-declared sector, optional. Stored as a string rather than an enum
  // because the taxonomy is expected to change; validation lives in
  // features/space/schema.ts.
  industry                   String?
  primaryColor               String?    @map("primary_color")
  showBranding               Boolean    @default(false) @map("show_branding")
  hideAttribution            Boolean    @default(false) @map("hide_attribution")
  // The Team collaboration setting (Settings -> Collaboration).
  // Whether members share everything they create (everyone sees
  // everything) or work independently (everyone, admins included, only
  // sees what they create; roles grant administrative capabilities, not
  // visibility). Defaults to not shared — sharing is opt-in; the backfill
  // kept existing multi-member spaces shared to preserve their behavior.
  // When the org layer lands, shared
  // spaces map to teams and unshared spaces to organizations.
  shared                     Boolean    @default(false)
  // Set by hand when support grants the nonprofit discount; checkout applies
  // the coupon from this. An existing subscription gets it in Stripe.
  nonprofitDiscountGrantedAt DateTime?  @map("nonprofit_discount_granted_at")
  createdAt                  DateTime   @default(now()) @map("created_at")
  updatedAt                  DateTime   @updatedAt @map("updated_at")

  owner           User             @relation("UserSpaces", fields: [ownerId], references: [id], onDelete: Cascade)
  polls           Poll[]
  scheduledEvents ScheduledEvent[]
  eventTypes      EventType[]
  sheets          Sheet[]
  subscriptions   Subscription[]   @relation("SpaceToSubscription")

  members SpaceMember[]

  memberInvites SpaceMemberInvite[]

  apiKeys SpaceApiKey[]

  nonprofitApplications NonprofitApplication[]

  webhooks SpaceWebhook[]

  @@index([ownerId])
  @@map("spaces")
}

enum SpaceMemberRole {
  ADMIN
  MEMBER
}

enum SpaceType {
  personal
  work

  @@map("space_types")
}

enum SpaceTier {
  hobby
  pro

  @@map("space_tiers")
}

model SpaceMember {
  id             String          @id @default(uuid())
  spaceId        String          @map("space_id")
  userId         String          @map("user_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  role           SpaceMemberRole @default(MEMBER)
  lastSelectedAt DateTime        @default(now()) @map("last_selected_at")

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@index([userId])
  @@map("space_members")
}

model SpaceMemberInvite {
  id        String          @id @default(uuid())
  spaceId   String          @map("space_id")
  email     String
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  role      SpaceMemberRole @default(MEMBER)
  inviterId String          @map("inviter_id")

  invitedBy User  @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  space     Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, email])
  @@map("space_member_invites")
}

model SpaceApiKey {
  id        String @id @default(cuid())
  spaceId   String @map("space_id")
  name      String
  prefix    String @unique
  hashedKey String @map("hashed_key") @db.Text

  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId], name: "space_api_key_space_idx")
  @@index([expiresAt], name: "space_api_key_expires_idx")
  @@index([revokedAt], name: "space_api_key_revoked_idx")
  @@map("space_api_keys")
}

model SpaceWebhook {
  id      String   @id @default(cuid())
  spaceId String   @map("space_id")
  url     String
  /// AES-256-GCM under SECRET_PASSWORD (see @rallly/utils/encryption); the plaintext is shown once at creation
  secret  String
  /// Subscribed event names (`poll.closed`, ...); validated by the feature schema, not a DB enum, so the vocabulary grows without migrations
  events  String[]
  enabled Boolean  @default(true)
  /// The payload contract this endpoint was built against (WEBHOOK_VERSION at creation). No default: a writer that forgets it fails instead of recording a stale contract. A breaking payload change branches on this so existing endpoints keep their shape
  version String
  /// Fan-out position in the poll activity log: activities created after this instant are still to be delivered. Starts at creation so a new endpoint never replays history
  cursor  DateTime @default(now())

  lastDeliveredAt     DateTime? @map("last_delivered_at")
  lastFailedAt        DateTime? @map("last_failed_at")
  /// Exhausted deliveries in a row; reset by any success. The dispatcher disables the endpoint once it reaches its cap
  consecutiveFailures Int       @default(0) @map("consecutive_failures")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  space      Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([spaceId])
  @@map("space_webhooks")
}

enum WebhookDeliveryStatus {
  pending
  in_flight
  succeeded
  failed
  exhausted

  @@map("webhook_delivery_status")
}

model WebhookDelivery {
  id         String @id @default(cuid())
  webhookId  String @map("webhook_id")
  /// Soft reference to the PollActivity row this delivery was fanned out from; with webhookId it makes fan-out idempotent
  activityId String @map("activity_id")
  eventType  String @map("event_type")
  /// Frozen at fan-out: retries resend exactly what the first attempt sent
  payload    Json

  status        WebhookDeliveryStatus @default(pending)
  attempts      Int                   @default(0)
  nextAttemptAt DateTime              @default(now()) @map("next_attempt_at")

  lastResponseStatus Int?    @map("last_response_status")
  lastError          String? @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  webhook SpaceWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@unique([webhookId, activityId])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

// ---- models/user.prisma

enum TimeFormat {
  hours12
  hours24

  @@map("time_format")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  scope             String?
  id_token          String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  password              String?   @map("password")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

enum UserRole {
  admin
  user

  @@map("user_role")
}

model User {
  id                String      @id @default(cuid())
  name              String
  email             String      @unique @db.Citext
  emailVerified     Boolean?    @map("email_verified")
  image             String?
  timeZone          String?     @map("time_zone")
  weekStart         Int?        @map("week_start")
  timeFormat        TimeFormat? @map("time_format")
  locale            String?
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime?   @updatedAt @map("updated_at")
  customerId        String?     @map("customer_id")
  banned            Boolean     @default(false)
  bannedAt          DateTime?   @map("banned_at")
  banReason         String?     @map("ban_reason")
  banExpires        DateTime?   @map("ban_expires")
  role              UserRole    @default(user)
  lastLoginMethod   String?     @map("last_login_method")
  isAnonymous       Boolean     @default(false) @map("anonymous")
  lastSeenAt        DateTime    @default(now()) @map("last_seen_at")
  deletedAt         DateTime?   @map("deleted_at")
  // Self-declared role, optional. Free-form string rather than an enum so
  // the taxonomy can change without a migration; validation lives in
  // features/user/schema.ts.
  jobTitle          String?     @map("job_title")
  // When the user was asked for a review on a third-party site, by the
  // review request email or a one-off campaign. Asked once per user, so a set
  // value means never ask again.
  reviewRequestedAt DateTime?   @map("review_requested_at")

  comments                Comment[]
  polls                   Poll[]
  notificationPreferences UserNotificationPreferences?
  queuedEmails            QueuedEmail[]
  accounts                Account[]
  participants            Participant[]
  paymentMethods          PaymentMethod[]
  spaceMemberInvites      SpaceMemberInvite[]
  nonprofitApplications   NonprofitApplication[]

  subscriptions Subscription[] @relation("UserToSubscription")
  spaces        Space[]        @relation("UserSpaces")
  memberOf      SpaceMember[]

  scheduledEvents       ScheduledEvent[]
  scheduledEventInvites ScheduledEventInvite[]
  hostedEventTypes      EventType[]
  hostedSheets          Sheet[]

  calendarConnections     CalendarConnection[]
  conferencingConnections ConferencingConnection[]
  credentials             Credential[]

  // Default destination calendar for new events
  defaultDestinationCalendarId String?           @map("default_destination_calendar_id")
  defaultDestinationCalendar   ProviderCalendar? @relation("UserDefaultDestinationCalendar", fields: [defaultDestinationCalendarId], references: [id], onDelete: SetNull)

  sessions             Session[]
  impersonatedSessions Session[] @relation("ImpersonatedSessions")

  @@index([deletedAt])
  // Supports the orphaned-anonymous-guest cleanup: filters anonymous users by
  // last-seen time before checking they own no resources.
  @@index([isAnonymous, lastSeenAt])
  @@map("users")
}

model Session {
  id             String   @id
  expiresAt      DateTime @map("expires_at")
  token          String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  userId         String   @map("user_id")
  impersonatedBy String?  @map("impersonated_by")

  user               User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedByUser User? @relation("ImpersonatedSessions", fields: [impersonatedBy], references: [id])

  @@unique([token])
  @@map("sessions")
}

model Verification {
  id         String   @id
  identifier String   @unique
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ---- schema.prisma

datasource db {
  provider = "postgresql"
}

// hekireki: every ORM generator, and the ER diagram as Mermaid, DBML and SVG. Every output is
// under generated/, which the Bazel target //schemas/rallly:generate writes and
// //schemas/rallly:generate.test holds the committed copy to.

generator Hekireki-Drizzle {
  provider = "hekireki-drizzle"
  output   = "generated/drizzle/schema.ts"
}

generator Hekireki-Kysely {
  provider = "hekireki-kysely"
  output   = "generated/kysely/types.ts"
}

generator Hekireki-SQLAlchemy {
  provider = "hekireki-sqlalchemy"
  output   = "generated/sqlalchemy"
}

generator Hekireki-Django {
  provider = "hekireki-django"
  output   = "generated/django"
}

generator Hekireki-GORM {
  provider = "hekireki-gorm"
  output   = "generated/gorm"
  package  = "model"
}

generator Hekireki-SeaORM {
  provider = "hekireki-sea-orm"
  output   = "generated/sea-orm"
}

generator Hekireki-Ecto {
  provider = "hekireki-ecto"
  output   = "generated/ecto"
  app      = "Rallly"
}

generator Hekireki-ActiveRecord {
  provider = "hekireki-activerecord"
  output   = "generated/activerecord"
}

generator Hekireki-EFCore {
  provider  = "hekireki-efcore"
  output    = "generated/efcore"
  namespace = "Rallly.Models"
  context   = "RalllyContext"
}

generator Hekireki-Eloquent {
  provider  = "hekireki-eloquent"
  output    = "generated/eloquent"
  namespace = "App\\Models"
}

generator Hekireki-Exposed {
  provider = "hekireki-exposed"
  output   = "generated/exposed"
  package  = "rallly.models"
}

generator Hekireki-ER {
  provider = "hekireki-er"
  outputs  = ["generated/er/er.md", "generated/er/er.dbml", "generated/er/er.svg"]
}
