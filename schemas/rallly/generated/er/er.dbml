Enum api_usage_resource {
  poll
}

Enum subscription_status {
  incomplete
  incomplete_expired
  active
  paused
  trialing
  past_due
  canceled
  unpaid
}

Enum subscription_interval {
  month
  year
}

Enum nonprofit_application_status {
  approved
  rejected
  failed
}

Enum queued_email_status {
  pending
  sent
  skipped
  failed
}

Enum scheduled_event_status {
  confirmed
  canceled
  unconfirmed
}

Enum scheduled_event_invite_status {
  pending
  accepted
  declined
  tentative
}

Enum CredentialType {
  OAUTH
}

Enum LicenseType {
  PLUS
  ORGANIZATION
  ENTERPRISE
}

Enum LicenseStatus {
  ACTIVE
  REVOKED
}

Enum participant_visibility {
  full
  scoresOnly
  limited
}

Enum poll_status {
  open
  closed
  scheduled
  canceled
}

Enum poll_kind {
  date
  time
}

Enum poll_closed_reason {
  auto
  manual
}

Enum vote_type {
  yes
  no
  ifNeedBe
}

Enum SpaceMemberRole {
  ADMIN
  MEMBER
}

Enum space_types {
  personal
  work
}

Enum space_tiers {
  hobby
  pro
}

Enum webhook_delivery_status {
  pending
  in_flight
  succeeded
  failed
  exhausted
}

Enum time_format {
  hours12
  hours24
}

Enum user_role {
  admin
  user
}

Table api_usage {
  space_id String [not null]
  resource api_usage_resource [not null]
  period DateTime [not null]
  count Int [default: 0, not null]
  near_limit_warned_at DateTime
  at_limit_warned_at DateTime
  updated_at DateTime [not null]

  indexes {
    (space_id, resource, period) [pk]
  }
}

Table subscriptions {
  id String [pk]
  price_id String [not null]
  quantity Int [default: 1, not null]
  subscription_item_id String [not null]
  amount Int [not null]
  discount_percent_off Float
  discount_amount_off Int
  status subscription_status [not null]
  active Boolean [not null]
  currency String [not null]
  interval subscription_interval [not null]
  created_at DateTime [default: `now()`, not null]
  period_start DateTime [not null]
  period_end DateTime [not null]
  cancel_at_period_end Boolean [default: false, not null]
  user_id String [not null]
  space_id String [not null]
  api_addon_item_id String
  api_addon_price_id String
  api_addon_amount Int
  api_poll_limit Int
  api_poll_retained_limit Int
  api_poll_retained_until DateTime
}

Table payment_methods {
  id String [pk]
  user_id String [not null]
  type String [not null]
  data Json [not null]
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime [not null]
}

Table nonprofit_applications {
  id String [pk]
  space_id String [not null]
  user_id String [not null]
  organization_name String [not null]
  website String [not null]
  email_domain String [not null]
  status nonprofit_application_status [not null]
  reason String
  model String
  created_at DateTime [default: `now()`, not null]
}

Table queued_emails {
  id String [pk]
  kind String [not null, note: '''Which handler builds the email. A string rather than an enum so a new
kind needs no migration; the claim only takes kinds the build knows.''']
  subject_id String [not null, note: '''The row the email is about, interpreted by the kind. Not a foreign key:
kinds point at different tables, and a subject deleted before the send
makes its handler skip the email.''']
  batch_id String [not null, note: '''Groups the emails one action queued, so the action can send its own
first batch at once and its progress can be read back.''']
  user_id String [not null, note: '''The account whose action queued the email. Banning it skips whatever
is still pending.''']
  status queued_email_status [default: 'pending', not null]
  send_after DateTime [note: 'Not claimed before this time. Unset sends at the next run.']
  attempts Int [default: 0, not null]
  claimed_at DateTime
  sent_at DateTime
  last_error String
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime [not null]

  Note: '''An email waiting to be sent by the queue, one row per recipient. The
email is built when it is sent, from the row its subject points at.'''
}

Table event_types {
  id String [pk]
  space_id String [not null]
  host_id String [not null]
  name String [not null]
  duration_minutes Int [not null]
  capacity Int
  description String
  location Json
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime [not null]
  deleted Boolean [default: false, not null]
  deleted_at DateTime
}

Table scheduled_events {
  id String [pk]
  user_id String [not null]
  space_id String [not null]
  event_type_id String
  sheet_slot_id String [unique]
  title String [not null]
  description String
  location Json
  conferencing Json
  capacity Int
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime [not null]
  status scheduled_event_status [default: 'confirmed', not null]
  time_zone String [note: 'Venue / anchor timezone for in-person or hybrid events. Null means no fixed venue (e.g. remote-only).']
  start DateTime [not null]
  end DateTime [not null]
  all_day Boolean [default: false, not null]
  deleted_at DateTime
  sequence Int [default: 0, not null]
  uid String [unique, not null]
  hide_attendees Boolean [default: false, not null]
}

Table rescheduled_event_dates {
  id String [pk]
  scheduled_event_id String [not null]
  start DateTime [not null]
  end DateTime [not null]
  all_day Boolean [default: false, not null]
  created_at DateTime [default: `now()`, not null]
}

Table scheduled_event_invites {
  id String [pk]
  uid String [unique, not null]
  scheduled_event_id String [not null]
  invitee_name String [not null]
  invitee_email String [not null]
  invitee_id String
  invitee_time_zone String
  invitee_locale String
  status scheduled_event_invite_status [default: 'pending', not null]
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime [not null]

  indexes {
    (scheduled_event_id, invitee_email) [unique]
  }
}

Table instance_settings {
  id Int [pk, default: 1]
  disable_user_registration Boolean [default: false, not null]
  instance_id String [unique, not null]
  app_name String
  primary_color String
  primary_color_dark String
  logo String
  logo_dark String
  logo_icon String
  hide_attribution Boolean
  footer_links Json [default: '[]', not null]
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime [default: `now()`, not null]
}

Table credentials {
  id String [pk]
  user_id String [not null]
  provider String [not null]
  provider_account_id String [not null]
  type CredentialType [not null]
  secret String [not null]
  scopes String[] [not null]
  expires_at DateTime
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime [not null]

  indexes {
    (user_id, provider, provider_account_id) [unique]
  }
}

Table calendar_connections {
  id String [pk]
  user_id String [not null]
  provider String [not null]
  integration_id String [not null]
  provider_account_id String [not null]
  email String [not null]
  display_name String
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime [not null]
  credential_id String [not null]

  indexes {
    (user_id, provider, provider_account_id) [unique]
  }
}

Table provider_calendars {
  id String [pk]
  calendar_connection_id String [not null]
  provider_calendar_id String [not null]
  name String [not null]
  primary Boolean [default: false, not null]
  time_zone String
  selected Boolean [default: false, not null]
  deleted Boolean [default: false, not null]
  writable Boolean [default: false, not null]
  provider_data Json
  last_synced_at DateTime [default: `now()`, not null]
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime [not null]

  indexes {
    (calendar_connection_id, provider_calendar_id) [unique]
  }
}

Table conferencing_connections {
  id String [pk]
  user_id String [not null]
  provider String [not null]
  integration_id String [not null]
  provider_account_id String [not null]
  email String [not null]
  display_name String
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime [not null]
  credential_id String [not null]

  indexes {
    (user_id, provider, provider_account_id) [unique]
  }
}

Table licenses {
  id String [pk]
  license_key String [unique, not null]
  idempotency_key String [unique]
  version Int
  type LicenseType [not null]
  seats Int
  issued_at DateTime [default: `now()`, not null]
  expires_at DateTime
  licensee_email String
  licensee_name String
  white_label_addon Boolean [default: false, not null]
  status LicenseStatus [default: 'ACTIVE', not null]
}

Table license_validations {
  id String [pk]
  license_id String [not null]
  ip_address String
  fingerprint String
  validated_at DateTime [default: `now()`, not null]
  user_agent String
}

Table instance_licenses {
  id String [pk]
  license_key String [unique, not null]
  version Int
  type LicenseType [not null]
  seats Int
  issued_at DateTime [default: `now()`, not null]
  expires_at DateTime
  licensee_email String
  licensee_name String
  white_label_addon Boolean [default: false, not null]
  status LicenseStatus [default: 'ACTIVE', not null]
}

Table user_notification_preferences {
  id String [pk]
  user_id String [unique, not null]
  prefs Json [default: '{}', not null]
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime [not null]
}

Table polls {
  id String [pk]
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime [not null]
  deadline DateTime
  title String [not null]
  description String
  location String
  conferencing Json [note: '''What the organizer asked for: a provider to mint a link with at
finalize ("zoom" | "meet" | "teams" | "webex"), or a link they pasted
themselves.''']
  user_id String
  time_zone String
  status poll_status [default: 'open', not null]
  closed_reason poll_closed_reason
  kind poll_kind [default: 'date', not null]
  deleted Boolean [default: false, not null]
  deleted_at DateTime
  event_id String [unique]
  scheduled_event_id String
  hide_participants Boolean [default: false, not null]
  hide_scores Boolean [default: false, not null]
  disable_comments Boolean [default: true, not null]
  require_participant_email Boolean [default: false, not null]
  allow_tentative_votes Boolean [default: true, not null, note: '''Whether participants may cast the tentative "if need be" vote. Positive
flag so a future vote-type expansion adds columns rather than inverting a
negative. Turning it off only blocks new tentative votes; existing ones
are kept and stay visible.''']
  muted Boolean [default: false, not null]
  space_id String
}

Table participants {
  id String [pk]
  name String [not null]
  email String
  note String
  token String [unique, not null, note: 'Per response edit link: grants edit access to this response without a session. App minted at creation, CSPRNG alphanumeric ≥32 chars (nanoid customAlphabet — url safe with no linkifier edge cases, unlike base64url); never a DB default so a code path that forgets to mint fails loudly. A response created through an emailed invite takes the invite\'s token. Rows that predate minting were backfilled with gen_random_uuid() hex']
  user_id String
  poll_id String [not null]
  locale String
  time_zone String
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime
}

Table poll_invites {
  id String [pk]
  poll_id String [not null]
  email String [not null]
  token String [unique, not null, note: 'Per invitee link. App minted, CSPRNG alphanumeric ≥32 chars (nanoid customAlphabet) — no schema default, so forgetting to mint fails loudly. Rotated on reactivation so a revoked (possibly leaked) token never regains access']
  opened_at DateTime
  reminded_at DateTime
  revoked_at DateTime [note: 'Revocation is always explicit: set when the host removes a pending invite, never as a side effect of close, schedule or reopen. Deleting a response instead hard deletes the participant, so the SetNull FK clears participantId and reverts the invite to pending with its token intact — the token the deleted response held is freed with it, so the next response through the same link can take it again. Cleared only by re-inviting (reactivation), which also rotates the token']
  participant_id String [unique, note: 'Conversion join, merges invite history into the response timeline. Set only when the invitee responds via their token: a typed email is unverified, so a generic link response never claims an invite']
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime [not null]

  indexes {
    (poll_id, email) [unique]
  }
}

Table poll_activities {
  id String [pk]
  poll_id String [not null]
  type String [not null, note: 'Validated by a zod union in the feature, not a DB enum: the activity vocabulary grows without migrations']
  user_id String [note: 'Subject ids are soft references (no FKs): activity must outlive its subjects — including account deletion — so refs persist as identity and the payload carries the display snapshot; whether a ref still resolves is the renderer\'s question']
  participant_id String
  invite_id String
  option_id String
  payload Json [default: '{}', not null]
  created_at DateTime [default: `now()`, not null]
}

Table options {
  id String [pk]
  start_time DateTime [not null]
  duration_minutes Int [default: 0, not null]
  poll_id String [not null]
  created_at DateTime [default: `now()`, not null]
}

Table votes {
  id String [pk]
  participant_id String [not null]
  option_id String [not null]
  poll_id String [not null]
  type vote_type [default: 'yes', not null]
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime
}

Table comments {
  id String [pk]
  content String [not null]
  poll_id String [not null]
  author_name String [not null]
  user_id String
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime
}

Table registered_instances {
  id String [pk]
  instance_id String [unique, not null]
  version String [not null]
  first_seen_at DateTime [default: `now()`, not null]
  last_seen_at DateTime [default: `now()`, not null]
}

Table sheets {
  id String [pk]
  space_id String [not null]
  host_id String [not null]
  title String [not null]
  description String
  url_id String [unique, not null]
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime [not null]
  deleted Boolean [default: false, not null]
  deleted_at DateTime
}

Table sheet_slots {
  id String [pk]
  sheet_id String [not null]
  event_type_id String [not null]
  start_time DateTime [not null]
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime [not null]
}

Table spaces {
  id String [pk]
  name String [not null]
  image String
  owner_id String [not null]
  tier space_tiers [default: 'hobby', not null]
  space_type space_types
  industry String
  primary_color String
  show_branding Boolean [default: false, not null]
  hide_attribution Boolean [default: false, not null]
  shared Boolean [default: false, not null]
  nonprofit_discount_granted_at DateTime
  api_poll_quota_override Int
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime [not null]
}

Table space_members {
  id String [pk]
  space_id String [not null]
  user_id String [not null]
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime [not null]
  role SpaceMemberRole [default: 'MEMBER', not null]
  last_selected_at DateTime [default: `now()`, not null]

  indexes {
    (space_id, user_id) [unique]
  }
}

Table space_member_invites {
  id String [pk]
  space_id String [not null]
  email String [not null]
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime [not null]
  role SpaceMemberRole [default: 'MEMBER', not null]
  inviter_id String [not null]

  indexes {
    (space_id, email) [unique]
  }
}

Table space_api_keys {
  id String [pk]
  space_id String [not null]
  name String [not null]
  prefix String [unique, not null]
  hashed_key String [not null]
  last_used_at DateTime
  expires_at DateTime
  revoked_at DateTime
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime [not null]
}

Table space_webhooks {
  id String [pk]
  space_id String [not null]
  url String [not null]
  secret String [not null, note: 'AES-256-GCM under SECRET_PASSWORD (see @rallly/utils/encryption); the plaintext is shown once at creation']
  events String[] [not null, note: 'Subscribed event names (`poll.closed`, ...); validated by the feature schema, not a DB enum, so the vocabulary grows without migrations']
  enabled Boolean [default: true, not null]
  version String [not null, note: 'The payload contract this endpoint was built against (WEBHOOK_VERSION at creation). No default: a writer that forgets it fails instead of recording a stale contract. A breaking payload change branches on this so existing endpoints keep their shape']
  cursor DateTime [default: `now()`, not null, note: 'Fan-out position in the poll activity log: activities created after this instant are still to be delivered. Starts at creation so a new endpoint never replays history']
  last_delivered_at DateTime
  last_failed_at DateTime
  consecutive_failures Int [default: 0, not null, note: 'Exhausted deliveries in a row; reset by any success. The dispatcher disables the endpoint once it reaches its cap']
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime [not null]
}

Table webhook_deliveries {
  id String [pk]
  webhook_id String [not null]
  activity_id String [not null, note: 'Soft reference to the PollActivity row this delivery was fanned out from; with webhookId it makes fan-out idempotent']
  event_type String [not null]
  payload Json [not null, note: 'Frozen at fan-out: retries resend exactly what the first attempt sent']
  status webhook_delivery_status [default: 'pending', not null]
  attempts Int [default: 0, not null]
  next_attempt_at DateTime [default: `now()`, not null]
  last_response_status Int
  last_error String
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime [not null]

  indexes {
    (webhook_id, activity_id) [unique]
  }
}

Table accounts {
  id String [pk]
  user_id String [not null]
  provider String [not null]
  provider_account_id String [not null]
  refresh_token String
  access_token String
  expires_at Int
  scope String
  id_token String
  access_token_expires_at DateTime
  refresh_token_expires_at DateTime
  password String
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime [not null]

  indexes {
    (provider, provider_account_id) [unique]
  }
}

Table users {
  id String [pk]
  name String [not null]
  email String [unique, not null]
  email_verified Boolean
  image String
  time_zone String
  week_start Int
  time_format time_format
  locale String
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime
  customer_id String
  banned Boolean [default: false, not null]
  banned_at DateTime
  ban_reason String
  ban_expires DateTime
  role user_role [default: 'user', not null]
  last_login_method String
  anonymous Boolean [default: false, not null]
  last_seen_at DateTime [default: `now()`, not null]
  deleted_at DateTime
  job_title String
  review_requested_at DateTime
  default_destination_calendar_id String
}

Table sessions {
  id String [pk]
  expires_at DateTime [not null]
  token String [unique, not null]
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime [not null]
  ip_address String
  user_agent String
  user_id String [not null]
  impersonated_by String
}

Table verifications {
  id String [pk]
  identifier String [unique, not null]
  value String [not null]
  expires_at DateTime [not null]
  created_at DateTime [default: `now()`, not null]
  updated_at DateTime [default: `now()`, not null]
}

Ref api_usage_space_id_fk: api_usage.space_id > spaces.id [delete: cascade]

Ref subscriptions_user_id_fk: subscriptions.user_id > users.id [delete: cascade]

Ref subscriptions_space_id_fk: subscriptions.space_id > spaces.id [delete: cascade]

Ref payment_methods_user_id_fk: payment_methods.user_id > users.id [delete: cascade]

Ref nonprofit_applications_space_id_fk: nonprofit_applications.space_id > spaces.id [delete: cascade]

Ref nonprofit_applications_user_id_fk: nonprofit_applications.user_id > users.id [delete: cascade]

Ref queued_emails_user_id_fk: queued_emails.user_id > users.id [delete: cascade]

Ref event_types_space_id_fk: event_types.space_id > spaces.id [delete: cascade]

Ref event_types_host_id_fk: event_types.host_id > users.id [delete: cascade]

Ref scheduled_events_user_id_fk: scheduled_events.user_id > users.id [delete: cascade]

Ref scheduled_events_space_id_fk: scheduled_events.space_id > spaces.id [delete: cascade]

Ref scheduled_events_event_type_id_fk: scheduled_events.event_type_id > event_types.id [delete: set null]

Ref scheduled_events_sheet_slot_id_fk: scheduled_events.sheet_slot_id - sheet_slots.id [delete: set null]

Ref rescheduled_event_dates_scheduled_event_id_fk: rescheduled_event_dates.scheduled_event_id > scheduled_events.id [delete: cascade]

Ref scheduled_event_invites_scheduled_event_id_fk: scheduled_event_invites.scheduled_event_id > scheduled_events.id [delete: cascade]

Ref scheduled_event_invites_invitee_id_fk: scheduled_event_invites.invitee_id > users.id [delete: set null]

Ref credentials_user_id_fk: credentials.user_id > users.id [delete: cascade]

Ref calendar_connections_credential_id_fk: calendar_connections.credential_id > credentials.id [delete: cascade]

Ref calendar_connections_user_id_fk: calendar_connections.user_id > users.id [delete: cascade]

Ref provider_calendars_calendar_connection_id_fk: provider_calendars.calendar_connection_id > calendar_connections.id [delete: cascade]

Ref conferencing_connections_credential_id_fk: conferencing_connections.credential_id > credentials.id [delete: cascade]

Ref conferencing_connections_user_id_fk: conferencing_connections.user_id > users.id [delete: cascade]

Ref license_validations_license_id_fk: license_validations.license_id > licenses.id [delete: cascade]

Ref user_notification_preferences_user_id_fk: user_notification_preferences.user_id - users.id [delete: cascade]

Ref polls_user_id_fk: polls.user_id > users.id [delete: cascade]

Ref polls_scheduled_event_id_fk: polls.scheduled_event_id > scheduled_events.id [delete: set null]

Ref polls_space_id_fk: polls.space_id > spaces.id [delete: set null]

Ref participants_poll_id_fk: participants.poll_id > polls.id [delete: cascade]

Ref participants_user_id_fk: participants.user_id > users.id [delete: set null]

Ref poll_invites_poll_id_fk: poll_invites.poll_id > polls.id [delete: cascade]

Ref poll_invites_participant_id_fk: poll_invites.participant_id - participants.id [delete: set null]

Ref poll_activities_poll_id_fk: poll_activities.poll_id > polls.id [delete: cascade]

Ref options_poll_id_fk: options.poll_id > polls.id [delete: cascade]

Ref votes_participant_id_fk: votes.participant_id > participants.id [delete: cascade]

Ref votes_option_id_fk: votes.option_id > options.id [delete: cascade]

Ref votes_poll_id_fk: votes.poll_id > polls.id [delete: cascade]

Ref comments_poll_id_fk: comments.poll_id > polls.id [delete: cascade]

Ref comments_user_id_fk: comments.user_id > users.id [delete: cascade]

Ref sheets_space_id_fk: sheets.space_id > spaces.id [delete: cascade]

Ref sheets_host_id_fk: sheets.host_id > users.id [delete: cascade]

Ref sheet_slots_sheet_id_fk: sheet_slots.sheet_id > sheets.id [delete: cascade]

Ref sheet_slots_event_type_id_fk: sheet_slots.event_type_id > event_types.id [delete: restrict]

Ref spaces_owner_id_fk: spaces.owner_id > users.id [delete: cascade]

Ref space_members_space_id_fk: space_members.space_id > spaces.id [delete: cascade]

Ref space_members_user_id_fk: space_members.user_id > users.id [delete: cascade]

Ref space_member_invites_inviter_id_fk: space_member_invites.inviter_id > users.id [delete: cascade]

