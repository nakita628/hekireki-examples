}

Table users {
  id Int [pk, increment]
  uuid String [unique, not null]
  username String
  name String
  email String [unique, not null, note: '@zod.import(["import { emailSchema } from \'../../zod-utils\'"]).custom.use(emailSchema)']
  emailVerified DateTime
  bio String
  avatarUrl String
  timeZone String [default: 'Europe/London', not null]
  weekStart String [default: 'Sunday', not null]
  bufferTime Int [default: 0, not null]
  hideBranding Boolean [default: false, not null]
  theme String
  appTheme String
  created DateTime [default: `now()`, not null]
  trialEndsAt DateTime
  lastActiveAt DateTime
  defaultScheduleId Int
  completedOnboarding Boolean [default: false, not null]
  locale String
  timeFormat Int [default: 12]
  twoFactorSecret String
  twoFactorEnabled Boolean [default: false, not null]
  backupCodes String
  identityProvider IdentityProvider [default: 'CAL', not null]
  identityProviderId String
  invitedTo Int
  brandColor String
  darkBrandColor String
  allowDynamicBooking Boolean [default: true]
  allowSEOIndexing Boolean [default: true]
  receiveMonthlyDigestEmail Boolean [default: true]
  requiresBookerEmailVerification Boolean [default: false]
  metadata Json [note: '@zod.import(["import { userMetadata } from \'../../zod-utils\'"]).custom.use(userMetadata)']
  verified Boolean [default: false]
  role UserPermissionRole [default: 'USER', not null]
  organizationId Int
  locked Boolean [default: false, not null]
  movedToProfileId Int [unique]
  isPlatformManaged Boolean [default: false, not null]
  smsLockState SMSLockState [default: 'UNLOCKED', not null]
  smsLockReviewedByAdmin Boolean [default: false, not null]
  referralLinkId String
  creationSource CreationSource
  autoOptInFeatures Boolean [default: false, not null]

  indexes {
    (email, username) [unique]
    (username, organizationId) [unique]
  }
}

Table NotificationsSubscriptions {
  id Int [pk, increment]
  userId Int [not null]
  subscription String [not null]
}

Table Profile {
  id Int [pk, increment]
