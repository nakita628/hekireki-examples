  eventTypeId Int
  title String [not null]
  description String
  startTime DateTime [not null]
  endTime DateTime [not null]
  createdAt DateTime [not null]
  updatedAt DateTime
  location String
  paid Boolean [not null]
  status BookingStatus [not null]
  rescheduled Boolean
  userId Int
  teamId Int
  eventLength Int
  eventParentId Int
  userEmail String
  userName String
  userUsername String
  ratingFeedback String
  rating Int
  noShowHost Boolean
  isTeamBooking Boolean [not null]
  timeStatus String
}

Table _user_eventtype {
  A Int [not null]
  B Int [not null]

  indexes {
    (A, B) [unique]
    B
  }
}

Table _PlatformOAuthClientToUser {
  A String [not null]
  B Int [not null]

  indexes {
    (A, B) [unique]
    B
  }
}

