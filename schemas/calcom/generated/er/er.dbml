Table Host {
  userId Int [not null]
  eventTypeId Int [not null]
  isFixed Boolean [default: false, not null]
  priority Int
  weight Int
  weightAdjustment Int
  scheduleId Int
  createdAt DateTime [default: `now()`, not null]
  groupId String
  memberId Int

  indexes {
    (userId, eventTypeId) [pk]
  }
}

Table HostGroup {
  id String [pk]
  name String [not null]
  eventTypeId Int
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table HostLocation {
  id String [pk]
  userId Int [not null]
  eventTypeId Int [not null]
  type String [not null]
  credentialId Int
  link String
  address String
  phoneNumber String
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (userId, eventTypeId) [unique]
  }
}

Table CalVideoSettings {
  eventTypeId Int [pk]
  disableRecordingForOrganizer Boolean [default: false, not null]
  disableRecordingForGuests Boolean [default: false, not null]
  enableAutomaticTranscription Boolean [default: false, not null]
  enableAutomaticRecordingForOrganizer Boolean [default: false, not null]
  redirectUrlOnExit String
  disableTranscriptionForGuests Boolean [default: false, not null]
  disableTranscriptionForOrganizer Boolean [default: false, not null]
  requireEmailForGuests Boolean [default: false, not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]
}

Table VideoCallGuest {
  id String [pk]
  bookingUid String [not null]
  email String [not null]
  name String [not null]
  joinedAt DateTime
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime [not null]

  indexes {
    (bookingUid, email) [unique]
  }
}

Table EventType {
  id Int [pk, increment]
  title String [not null, note: '@zod.string.min(1)']
  slug String [not null, note: '@zod.import(["import { eventTypeSlug } from \'../../zod-utils\'"]).custom.use(eventTypeSlug)']
  description String
  interfaceLanguage String
  position Int [default: 0, not null]
  locations Json [note: '@zod.import(["import { eventTypeLocations } from \'../../zod-utils\'"]).custom.use(eventTypeLocations)']
  length Int [not null, note: '@zod.number.min(1)']
  offsetStart Int [default: 0, not null]
  hidden Boolean [default: false, not null]
  userId Int
  profileId Int
  teamId Int
  useEventLevelSelectedCalendars Boolean [default: false, not null]
  eventName String
  parentId Int
  bookingFields Json [note: '@zod.import(["import { eventTypeBookingFields } from \'../../zod-utils\'"]).custom.use(eventTypeBookingFields)']
  timeZone String
  periodType PeriodType [default: 'unlimited', not null]
  periodStartDate DateTime [note: '@zod.import(["import { coerceToDate } from \'../../zod-utils\'"]).custom.use(coerceToDate)']
  periodEndDate DateTime [note: '@zod.import(["import { coerceToDate } from \'../../zod-utils\'"]).custom.use(coerceToDate)']
  periodDays Int
  periodCountCalendarDays Boolean
  lockTimeZoneToggleOnBookingPage Boolean [default: false, not null]
  lockedTimeZone String
  requiresConfirmation Boolean [default: false, not null]
  requiresConfirmationWillBlockSlot Boolean [default: false, not null]
  requiresConfirmationForFreeEmail Boolean [default: false, not null]
  requiresBookerEmailVerification Boolean [default: false, not null]
  canSendCalVideoTranscriptionEmails Boolean [default: true, not null]
  autoTranslateDescriptionEnabled Boolean [default: false, not null]
  autoTranslateInstantMeetingTitleEnabled Boolean [default: true, not null]
  recurringEvent Json [note: '@zod.import(["import { recurringEventType } from \'../../zod-utils\'"]).custom.use(recurringEventType)']
  disableGuests Boolean [default: false, not null]
  hideCalendarNotes Boolean [default: false, not null]
  hideCalendarEventDetails Boolean [default: false, not null]
  minimumBookingNotice Int [default: 120, not null, note: '@zod.number.min(0)']
  beforeEventBuffer Int [default: 0, not null]
  afterEventBuffer Int [default: 0, not null]
  seatsPerTimeSlot Int
  onlyShowFirstAvailableSlot Boolean [default: false, not null]
  showOptimizedSlots Boolean [default: false]
  disableCancelling Boolean [default: false]
  disableRescheduling Boolean [default: false]
  minimumRescheduleNotice Int [note: '@zod.number.min(0)']
  seatsShowAttendees Boolean [default: false]
  seatsShowAvailabilityCount Boolean [default: true]
  schedulingType SchedulingType
  scheduleId Int
  allowReschedulingCancelledBookings Boolean [default: false]
  price Int [default: 0, not null]
  currency String [default: 'usd', not null]
  slotInterval Int
  metadata Json [note: '@zod.import(["import { EventTypeMetaDataSchema } from \'../../zod-utils\'"]).custom.use(EventTypeMetaDataSchema)']
  successRedirectUrl String [note: '@zod.import(["import { successRedirectUrl } from \'../../zod-utils\'"]).custom.use(successRedirectUrl)']
  forwardParamsSuccessRedirect Boolean [default: true]
  bookingLimits Json [note: '@zod.import(["import { intervalLimitsType } from \'../../zod-utils\'"]).custom.use(intervalLimitsType)']
  durationLimits Json [note: '@zod.import(["import { intervalLimitsType } from \'../../zod-utils\'"]).custom.use(intervalLimitsType)']
  isInstantEvent Boolean [default: false, not null]
  instantMeetingExpiryTimeOffsetInSeconds Int [default: 90, not null]
  instantMeetingScheduleId Int
  instantMeetingParameters String[] [not null]
  assignAllTeamMembers Boolean [default: false, not null]
  assignRRMembersUsingSegment Boolean [default: false, not null]
  rrSegmentQueryValue Json [note: '@zod.import(["import { rrSegmentQueryValueSchema } from \'../../zod-utils\'"]).custom.use(rrSegmentQueryValueSchema)']
  useEventTypeDestinationCalendarEmail Boolean [default: false, not null]
  isRRWeightsEnabled Boolean [default: false, not null]
  maxLeadThreshold Int
  includeNoShowInRRCalculation Boolean [default: false, not null]
  allowReschedulingPastBookings Boolean [default: false, not null]
  hideOrganizerEmail Boolean [default: false, not null]
  maxActiveBookingsPerBooker Int
  maxActiveBookingPerBookerOfferReschedule Boolean [default: false, not null]
  customReplyToEmail String [note: '@zod.import(["import { emailSchema } from \'../../zod-utils\'"]).custom.use(emailSchema)']
  eventTypeColor Json [note: '@zod.import(["import { eventTypeColor } from \'../../zod-utils\'"]).custom.use(eventTypeColor)']
  rescheduleWithSameRoundRobinHost Boolean [default: false, not null]
  secondaryEmailId Int
  useBookerTimezone Boolean [default: false, not null]
  restrictionScheduleId Int
  bookingRequiresAuthentication Boolean [default: false, not null]
  rrHostSubsetEnabled Boolean [default: false, not null]
  requiresCancellationReason CancellationReasonRequirement [default: 'MANDATORY_HOST_ONLY']
  enablePerHostLocations Boolean [default: false, not null]
  createdAt DateTime [default: `now()`]
  updatedAt DateTime

  indexes {
    (userId, slug) [unique]
    (teamId, slug) [unique]
    (userId, parentId) [unique]
  }
}

Table Credential {
  id Int [pk, increment]
  type String [not null]
  key Json [not null]
  encryptedKey String
  userId Int
  teamId Int
  appId String
  subscriptionId String
  paymentStatus String
  billingCycleStart Int
  invalid Boolean [default: false]
  delegationCredentialId String
