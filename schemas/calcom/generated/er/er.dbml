  updatedAt DateTime
  status BookingStatus [default: 'accepted', not null]
  paid Boolean [default: false, not null]
  destinationCalendarId Int
  cancellationReason String
  rejectionReason String
  reassignReason String
  reassignById Int
  dynamicEventSlugRef String
  dynamicGroupSlugRef String
  rescheduled Boolean
  fromReschedule String
  recurringEventId String
  smsReminderNumber String
  scheduledJobs String[] [not null]
  metadata Json [note: '@zod.import(["import { bookingMetadataSchema } from \'../../zod-utils\'"]).custom.use(bookingMetadataSchema)']
  isRecorded Boolean [default: false, not null]
  iCalUID String [default: '']
  iCalSequence Int [default: 0, not null]
  rating Int
  ratingFeedback String
  noShowHost Boolean [default: false]
  oneTimePassword String [unique]
  cancelledBy String [note: '@zod.import(["import { emailSchema } from \'../../zod-utils\'"]).custom.use(emailSchema)']
  rescheduledBy String [note: '@zod.import(["import { emailSchema } from \'../../zod-utils\'"]).custom.use(emailSchema)']
