  hideBranding Boolean [default: false, not null]
  hideTeamProfileLink Boolean [default: false, not null]
  isPrivate Boolean [default: false, not null]
  hideBookATeamMember Boolean [default: false, not null]
  createdAt DateTime [default: `now()`, not null]
  metadata Json [note: '@zod.import(["import { teamMetadataSchema } from \'../../zod-utils\'"]).custom.use(teamMetadataSchema)']
  theme String
  rrResetInterval RRResetInterval [default: 'MONTH']
  rrTimestampBasis RRTimestampBasis [default: 'CREATED_AT', not null]
  brandColor String
  darkBrandColor String
  bannerUrl String
  parentId Int
  timeFormat Int
  timeZone String [default: 'Europe/London', not null]
  weekStart String [default: 'Sunday', not null]
  isOrganization Boolean [default: false, not null]
  pendingPayment Boolean [default: false, not null]
  isPlatform Boolean [default: false, not null]
  createdByOAuthClientId String
  smsLockState SMSLockState [default: 'UNLOCKED', not null]
  smsLockReviewedByAdmin Boolean [default: false, not null]
  bookingLimits Json [note: '@zod.import(["import { intervalLimitsType } from \'../../zod-utils\'"]).custom.use(intervalLimitsType)']
  includeManagedEventsInLimits Boolean [default: false, not null]
  autoOptInFeatures Boolean [default: false, not null]

  indexes {
    (slug, parentId) [unique]
  }
}

