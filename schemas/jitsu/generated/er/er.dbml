  requestHeaders Json
}

Table GlobalProps {
  id String [pk]
  createdAt DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  updatedAt DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  name String [not null]
  value Json
}

Table source_spec {
  package String [not null]
  version String [not null]
  specs Json
  timestamp DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  error String

  indexes {
    (package, version) [pk]
  }
}

Table source_check {
  package String [not null]
  version String [not null]
  key String [pk]
  status String [not null]
  description String
  timestamp DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
}

Table source_catalog {
  package String [not null]
  version String [not null]
  key String [not null]
  catalog Json
  timestamp DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  status String [not null]
  description String

  indexes {
    (package, version, key) [pk]
  }
}

Table reverse_sync_control {
  workspace_id String [not null]
  sync_id String [not null]
  run_id String [not null]
  run_order BigInt [default: 0, not null]
  detached Boolean [default: false, not null]
  revision String [not null]
  target_hash String [not null]
  phase String [default: 'new', not null]
  mode reverse_sync_mode [not null]
  extraction reverse_sync_extraction [not null]
  artifact_head Bytes
  base_sequence BigInt [default: 0, not null]
  next_sequence BigInt [default: 0, not null]
  checkpoint_sequence BigInt [default: 0, not null]
  finish_sequence BigInt
  store Bytes
  provider_state Bytes
  finish_result Bytes
  committed_generation String

  indexes {
    (workspace_id, sync_id, run_id) [pk]
    (workspace_id, sync_id, run_order) [unique]
  }
}

Table reverse_sync_target_owner {
  target_hash String [pk]
  workspace_id String [not null]
  sync_id String [not null]

  indexes {
    (workspace_id, sync_id) [unique]
  }
}

Table source_state {
  sync_id String [not null]
  stream String [not null]
  state Json [not null]
  timestamp DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']

  indexes {
    (sync_id, stream) [pk]
  }
}

Table source_task {
  sync_id String [not null]
  task_id String [pk]
  package String [not null]
  version String [not null]
  started_at DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  updated_at DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  started_by Json
  status String [not null]
  description String
  metrics Json
  error String
}

Table task_log {
  id String [pk]
  level String [not null]
  logger String [not null]
  message String [not null]
  sync_id String [not null]
  task_id String [not null]
  timestamp DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
}

Table ProfileBuilder {
  id String [pk]
  name String [not null]
  deleted Boolean [default: false]
  createdAt DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  updatedAt DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  workspaceId String [not null]
  intermediateStorageCredentials Json [not null]
  destinationId String
  connectionOptions Json
  version Int [default: 0, not null]
}

Table ProfileBuilderFunction {
  id String [pk]
  createdAt DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  updatedAt DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
