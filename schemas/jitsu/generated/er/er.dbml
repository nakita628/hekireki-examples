Enum WorkspaceRole {
  owner
  editor
  analyst
}

Enum reverse_sync_mode {
  upsert
  mirror
}

Enum reverse_sync_extraction {
  cursor
  full
}

Table EmailLog {
  id String [pk]
  time DateTime [default: `now()`, not null]
  email Json [not null]
  error String
  previewUrl String
  messageId String
  status String [not null]
}

Table UserPreferences {
  id String [pk]
  createdAt DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  updatedAt DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  userId String [not null]
  workspaceId String
  scope String
  preferences Json [not null]
}

Table UserProfile {
  id String [pk]
  name String [not null]
  email String [not null]
  admin Boolean [default: false]
  createdAt DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  updatedAt DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  loginProvider String [not null]
  externalUsername String
  externalId String [not null]

  indexes {
    (loginProvider, externalId) [unique]
  }
}

Table UserPassword {
  id String [pk]
  createdAt DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  updatedAt DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  userId String [unique, not null]
  hash String [not null]
  changeAtNextLogin Boolean [default: false, not null]
}

Table Workspace {
  id String [pk]
  createdAt DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  updatedAt DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  name String [not null]
  deleted Boolean [default: false, not null]
  slug String [unique]
  featuresEnabled String[] [not null]
}

Table WorkspaceOptions {
  id String [pk]
  createdAt DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  updatedAt DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  workspaceId String [not null]
  namespace String [not null]
  value Json [not null]
}

Table WorkspaceAccess {
  workspaceId String [not null]
  createdAt DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  updatedAt DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  userId String [not null]
  role WorkspaceRole [default: 'owner', not null]

  indexes {
    (userId, workspaceId) [pk]
  }
}

Table WorkspaceUserProperties {
  workspaceId String [not null]
  userId String [not null]
  lastUsed DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']

  indexes {
    (workspaceId, userId) [pk]
  }
}

Table UserApiToken {
  id String [pk]
  createdAt DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  updatedAt DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  lastUsed DateTime [note: '@zod.custom(z.coerce.date())']
  hint String [not null]
  hash String [not null]
  userId String [not null]
  type String
  name String
  expiresAt DateTime [note: '@zod.custom(z.coerce.date())']
  workspaceId String
  role String
  oauthClientId String
}

Table OAuthClient {
  id String [pk]
  createdAt DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  updatedAt DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  clientSecretHash String [not null]
  name String [not null]
  redirectUris String[] [not null]
}

Table kv {
  key String [pk]
  value Json [not null]
  expires_at DateTime [note: '@zod.custom(z.coerce.date())']
}

Table OAuthAccessToken {
  id String [pk]
  createdAt DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  lastUsed DateTime [note: '@zod.custom(z.coerce.date())']
  hash String [not null]
  expiresAt DateTime [not null, note: '@zod.custom(z.coerce.date())']
  refreshTokenId String [not null]
}

Table InvitationToken {
  id String [pk]
  workspaceId String [not null]
  email String [not null]
  createdAt DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  updatedAt DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  token String [not null]
  usedBy String
