  updatedAt DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  type String [default: 'push']
  data Json
  workspaceId String [not null]
  fromId String [not null]
  toId String [not null]
}

Table ConnectorPackage {
  id String [pk]
  packageId String [not null]
  packageType String [default: 'airbyte', not null]
