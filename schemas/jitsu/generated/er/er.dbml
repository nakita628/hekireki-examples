}

Table ProfileBuilderState {
  profileBuilderId String [not null]
  profileBuilderVersion Int [not null]
  instanceIndex Int [not null]
  totalInstances Int [not null]
  startedAt DateTime [not null]
  updatedAt DateTime [not null]
  lastTimestamp DateTime
  processedUsers Int [not null]
  totalUsers Int [not null]
  errorUsers Int [not null]
  speed Float [not null]

  indexes {
    (profileBuilderId, profileBuilderVersion, totalInstances, instanceIndex) [pk]
  }
}

Table ProfileBuilderState2 {
  profileBuilderId String [pk]
  updatedAt DateTime [not null]
  fullRebuildInfo Json
  queuesInfo Json
  metrics Json

  indexes {
    profileBuilderId [pk]
  }
}

Table StatusChange {
  id BigInt [pk, increment]
  workspaceId String [not null]
  actorId String [not null]
  type String [not null]
  tableName String [not null]
  timestamp DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  status String [not null]
  startedAt DateTime [not null]
  counts Int [default: 0, not null]
  description String
  queueSize Int [default: 0, not null]
}

Table NotificationState {
  workspaceId String [not null]
  actorId String [not null]
  type String [not null]
  tableName String [not null]
  channelId String [not null]
  flappingSince DateTime [note: '@zod.custom(z.coerce.date())']
  lastNotification DateTime [not null, note: '@zod.custom(z.coerce.date())']
  statusChangeId BigInt [not null]
  error String

  indexes {
    (channelId, actorId, type, tableName) [pk]
  }
}

Table Notification {
  id String [pk]
  workspaceId String [not null]
  actorId String [not null]
  type String [not null]
  tableName String [not null]
  channelId String [not null]
  statusChangeId BigInt [not null]
  timestamp DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  status String [not null]
  error String
}

Table OidcProvider {
  id String [pk]
  createdAt DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  updatedAt DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  name String [not null]
  issuer String [not null]
  clientId String [not null]
  clientSecret String [not null]
  authorizationEndpoint String
  tokenEndpoint String
  userinfoEndpoint String
  jwksUri String
  introspectionEndpoint String
  scopes String[] [not null]
  audience String
  prompt String
  usernameClaim String [default: 'email', not null]
  emailClaim String [default: 'email', not null]
  nameClaim String [default: 'name', not null]
  groupClaim String [default: 'groups', not null]
  enabled Boolean [default: true, not null]
  autoDiscovery Boolean [default: true, not null]

  indexes {
    (issuer, clientId) [unique]
  }
}

Table OidcLoginGroup {
  id String [pk]
  createdAt DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  updatedAt DateTime [default: `now()`, not null, note: '@zod.custom(z.coerce.date())']
  workspaceId String [not null]
  oidcProviderId String [not null]
  groupValue String
  allowAllUsers Boolean [default: false, not null]

  indexes {
    (workspaceId, oidcProviderId) [unique]
  }
}

Table reprocessing_jobs {
  id String [pk]
  config Json [not null]
  status String [not null]
  created_at DateTime [not null]
  started_at DateTime
  completed_at DateTime
  k8s_job_name String
  total_files Int [default: 0]
  total_workers Int [default: 0]
  error String
}

Table reprocessing_workers {
  job_id String [not null]
  worker_index Int [not null]
  status String [not null]
  started_at DateTime
  updated_at DateTime [default: `now()`, not null]
  completed_at DateTime
  current_file String
  current_line BigInt [default: 0]
  current_ts String
  assigned_files Int [default: 0]
  processed_files Int [default: 0]
  total_lines BigInt [default: 0]
  success_count BigInt [default: 0]
  error_count BigInt [default: 0]
  skipped_count BigInt [default: 0]
  total_bytes BigInt [default: 0]
  processed_bytes BigInt [default: 0]
  error String

  indexes {
    (job_id, worker_index) [pk]
  }
}

Table FunctionsServer {
  workspaceId String [not null]
  class String [not null]
  deploymentId String [not null]
  connections String[] [not null]
  emptyConnections String[] [not null]
  profileBuilders String[] [not null]
  createdAt DateTime [default: `now()`, not null]
  updatedAt DateTime

  indexes {
    (workspaceId, class) [pk]
  }
}

Table RateLimitCounter {
  bucketKey String [not null]
  windowStart DateTime [not null]
  count Int [default: 0, not null]
  expiresAt DateTime [not null]

  indexes {
    (bucketKey, windowStart) [pk]
  }
}

Ref UserPreferences_userId_fk: UserPreferences.userId > UserProfile.id

Ref UserPreferences_workspaceId_fk: UserPreferences.workspaceId > Workspace.id

Ref UserPassword_userId_fk: UserPassword.userId - UserProfile.id

Ref WorkspaceOptions_workspaceId_fk: WorkspaceOptions.workspaceId > Workspace.id

Ref WorkspaceAccess_workspaceId_fk: WorkspaceAccess.workspaceId > Workspace.id

Ref WorkspaceAccess_userId_fk: WorkspaceAccess.userId > UserProfile.id

Ref WorkspaceUserProperties_workspaceId_fk: WorkspaceUserProperties.workspaceId > Workspace.id

Ref WorkspaceUserProperties_userId_fk: WorkspaceUserProperties.userId > UserProfile.id

Ref UserApiToken_userId_fk: UserApiToken.userId > UserProfile.id

Ref UserApiToken_oauthClientId_fk: UserApiToken.oauthClientId > OAuthClient.id

Ref OAuthAccessToken_refreshTokenId_fk: OAuthAccessToken.refreshTokenId > UserApiToken.id

Ref ConfigurationObject_workspaceId_fk: ConfigurationObject.workspaceId > Workspace.id

Ref ConfigurationObjectLink_workspaceId_fk: ConfigurationObjectLink.workspaceId > Workspace.id

Ref ConfigurationObjectLink_fromId_fk: ConfigurationObjectLink.fromId > ConfigurationObject.id

Ref ConfigurationObjectLink_toId_fk: ConfigurationObjectLink.toId > ConfigurationObject.id

Ref ProfileBuilder_workspaceId_fk: ProfileBuilder.workspaceId > Workspace.id

Ref ProfileBuilder_destinationId_fk: ProfileBuilder.destinationId > ConfigurationObject.id

Ref ProfileBuilderFunction_profileBuilderId_fk: ProfileBuilderFunction.profileBuilderId > ProfileBuilder.id

Ref ProfileBuilderFunction_functionId_fk: ProfileBuilderFunction.functionId > ConfigurationObject.id

Ref OidcLoginGroup_workspaceId_fk: OidcLoginGroup.workspaceId > Workspace.id

Ref OidcLoginGroup_oidcProviderId_fk: OidcLoginGroup.oidcProviderId > OidcProvider.id

Ref reprocessing_workers_job_id_fk: reprocessing_workers.job_id > reprocessing_jobs.id [delete: cascade, update: no action]